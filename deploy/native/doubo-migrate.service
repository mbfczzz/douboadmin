[Unit]
Description=Doubo database migration
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=doubo
Group=doubo
WorkingDirectory=/opt/doubo/current
EnvironmentFile=/etc/doubo/doubo.env
ExecStart=/opt/doubo/current/bin/doubo-api migrate
TimeoutStartSec=60
UMask=0027
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
StandardOutput=journal
StandardError=journal
