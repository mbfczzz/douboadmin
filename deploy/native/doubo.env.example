# systemd EnvironmentFile: no "export", no shell substitution, no live secrets.
APP_ENV=production
STORAGE_DRIVER=mysql
HTTP_ADDR=127.0.0.1:8080
RUN_WORKER=false
ALLOW_DEMO_LOGIN=false
ADMIN_USER=admin
# Bootstrap credentials only. First login creates the database-backed super administrator.
# Required: a new password of at least 16 characters.
ADMIN_PASSWORD=
MYSQL_DSN="doubo:REPLACE_PASSWORD@tcp(127.0.0.1:3306)/doubo_test?charset=utf8mb4&parseTime=true"
REDIS_ADDR=127.0.0.1:6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
WEB_ORIGIN=https://test.example.com
PUBLIC_BASE_URL=https://test.example.com
MEDIA_DIR=/opt/doubo/shared/media

# Required for production-mode API and worker startup.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
OSS_REGION=cn-hangzhou
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
RELAY_BASE_URL=https://relay.tcmzhan.com
RELAY_API_KEY=

# Optional integrations remain unavailable until their credentials are configured.
TIKHUB_BASE_URL=https://api.tikhub.io
TIKHUB_API_KEY=
WECHAT_COMPLETION_TEMPLATE_ID=
WECHAT_COMPLETION_FIELDS=
ALERT_WEBHOOK_URL=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_CERT_SERIAL=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PUBLIC_KEY_PATH=
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_REFUND_NOTIFY_URL=
WECHAT_PAY_IOS_ALLOWED=false
