# systemd EnvironmentFile: no "export", no shell substitution, no live secrets.
APP_ENV=production
STORAGE_DRIVER=mysql
HTTP_ADDR=127.0.0.1:5173
RUN_WORKER=false
ALLOW_DEMO_LOGIN=false
ADMIN_USER=admin
# Bootstrap credentials only. First login creates the database-backed super administrator.
# Required: a new 8-character alphanumeric password containing uppercase and lowercase letters.
ADMIN_PASSWORD=
MYSQL_DSN="doubo:REPLACE_PASSWORD@tcp(127.0.0.1:3306)/doubo_test?charset=utf8mb4&parseTime=true"
REDIS_ADDR=127.0.0.1:6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
WEB_ORIGIN=https://test.example.com
PUBLIC_BASE_URL=https://test.example.com
MEDIA_DIR=/opt/doubo/shared/media
# Optional override. Defaults to <MEDIA_DIR>/.secrets/integrations.key.
# Automatically created on first admin save; back up with MySQL and share across nodes.
# INTEGRATION_SETTINGS_KEY_FILE=/opt/doubo/shared/media/.secrets/integrations.key

# Business connections may instead be saved in admin System Settings.
# Database values override this entire group after its first save. Restart API + Worker.
# Missing business credentials disable their features, without blocking admin setup.
# Must match miniprogram/project.config.json. AppSecret belongs to this AppID.
WECHAT_APP_ID=wx0ab97e7996a7aca9
WECHAT_APP_SECRET=
OSS_REGION=cn-hangzhou
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
RELAY_BASE_URL=https://relay.tcmzhan.com
RELAY_API_KEY=

# Optional integrations remain unavailable until their credentials are configured.
TIKHUB_BASE_URL=https://api.tikhub.io
TIKHUB_API_KEY=
WECHAT_COMPLETION_TEMPLATE_ID=
WECHAT_COMPLETION_FIELDS=
ALERT_WEBHOOK_URL=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_CERT_SERIAL=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PUBLIC_KEY_PATH=
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_REFUND_NOTIFY_URL=
WECHAT_PAY_IOS_ALLOWED=false

# Separate from merchant APIv3. Never enable sandbox in production.
PAYMENT_CHANNEL=wechat_virtual
WECHAT_VIRTUAL_ENABLED=false
WECHAT_VIRTUAL_ENV=0
WECHAT_VIRTUAL_OFFER_ID=1450713037
WECHAT_VIRTUAL_APP_KEY=
WECHAT_VIRTUAL_SANDBOX_APP_KEY=
WECHAT_VIRTUAL_TOKEN=
WECHAT_VIRTUAL_ENCODING_AES_KEY=
WECHAT_VIRTUAL_IOS_ALLOWED=false
WECHAT_VIRTUAL_PRODUCTS=[]
# Published base product used to convert custom amounts into whole-item quantities.
WECHAT_VIRTUAL_CUSTOM_PRODUCT_ID=

# Mini-program invite codes: trial for current testing; release after publishing.
WECHAT_CODE_VERSION=trial
