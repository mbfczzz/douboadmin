# Host reverse proxy for the Docker web service on 127.0.0.1:8088.
# Replace the domain and certificate paths with your own verified deployment values.
server {
  listen 80;
  server_name YOUR_DOMAIN;
  location /.well-known/acme-challenge/ { root /var/www/acme; }
  location / { return 301 https://$host$request_uri; }
}
server {
  listen 443 ssl;
  http2 on;
  server_name YOUR_DOMAIN;
  ssl_certificate /etc/nginx/certs/fullchain.pem;
  ssl_certificate_key /etc/nginx/certs/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  server_tokens off;
  client_max_body_size 51m;
  # 后台「上传作品」：最大 500 MB；边收边转给 API，等它把视频传完 OSS。
  location = /api/admin/works {
    proxy_pass http://127.0.0.1:8088;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    client_max_body_size 510m;
    client_body_timeout 300s;
    proxy_request_buffering off;
    proxy_send_timeout 900s;
    proxy_read_timeout 900s;
  }
  location / {
    proxy_pass http://127.0.0.1:8088;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_read_timeout 95s;
  }
}
