# Copy to .env. This file contains examples only, not live credentials.
APP_ENV=development
# WeChat login is the default. Enable demo accounts only for isolated local tests.
ALLOW_DEMO_LOGIN=false
ADMIN_USER=admin
# Bootstrap credentials only: the first successful login creates the database-backed super administrator.
ADMIN_PASSWORD=doubo-demo-2026
MYSQL_DATABASE=doubo
MYSQL_USER=doubo
MYSQL_PASSWORD=replace_with_random_database_password
MYSQL_ROOT_PASSWORD=replace_with_another_random_root_password
REDIS_ADDR=
REDIS_USERNAME=
REDIS_PASSWORD=replace_with_random_redis_password
REDIS_DB=0
WEB_ORIGIN=http://127.0.0.1:8088,http://localhost:8088
WECHAT_APP_ID=
WECHAT_APP_SECRET=
RELAY_BASE_URL=https://relay.tcmzhan.com
RELAY_API_KEY=
PUBLIC_BASE_URL=
# Legacy merchant APIv3 JSAPI credentials. Virtual payment uses the separate block below.
WECHAT_PAY_MCH_ID=
WECHAT_PAY_CERT_SERIAL=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PUBLIC_KEY_PATH=
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_REFUND_NOTIFY_URL=
WECHAT_PAY_IOS_ALLOWED=false
# Virtual goods: disabled until credentials and published products are supplied.
PAYMENT_CHANNEL=wechat_jsapi
WECHAT_VIRTUAL_ENABLED=false
WECHAT_VIRTUAL_ENV=1
WECHAT_VIRTUAL_OFFER_ID=
WECHAT_VIRTUAL_APP_KEY=
WECHAT_VIRTUAL_SANDBOX_APP_KEY=
WECHAT_VIRTUAL_TOKEN=
WECHAT_VIRTUAL_ENCODING_AES_KEY=
WECHAT_VIRTUAL_IOS_ALLOWED=false
WECHAT_VIRTUAL_PRODUCTS=[]
# Data credentials are optional; absent credentials disable their controls.
TIKHUB_BASE_URL=https://api.tikhub.io
TIKHUB_API_KEY=
# Set the real subscription template and its real field mapping after platform approval.
WECHAT_COMPLETION_TEMPLATE_ID=
WECHAT_COMPLETION_FIELDS=
ALERT_WEBHOOK_URL=
OSS_REGION=cn-hangzhou
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# For host-based Go development with MySQL, set these in the shell:
# STORAGE_DRIVER=mysql
# MYSQL_DSN=doubo:password@tcp(127.0.0.1:3306)/doubo?charset=utf8mb4&parseTime=true
# Go reads process environment, it does not implicitly load .env.
