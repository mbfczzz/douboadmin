.biz-card {
  background: #1c1f21;
  border: 1px solid #353b3e;
  border-radius: 12px;
  padding: 16px 14px;
  margin-bottom: 12px;
}
.biz-heading {
  overflow-wrap: anywhere;
  font-size: 16px;
  line-height: 22px;
  font-weight: 600;
  display: block;
  margin-bottom: 12px;
}
.biz-value {
  overflow-wrap: anywhere;
  font-variant-numeric: tabular-nums;
  display: block;
  font-size: 30px;
  line-height: 38px;
  font-weight: 700;
  color: #e9eceb;
  margin: 6px 0 10px;
}
.biz-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 12px 0;
  border-bottom: 1px solid #2d3134;
}
.biz-row:last-child {
  border-bottom: 0;
}
.biz-row + .biz-label {
  margin-top: 12px;
}
.biz-label {
  font-size: 13px;
  line-height: 18px;
  color: #a0a8ac;
  display: block;
  margin-bottom: 8px;
}
.biz-input {
  background: #272b2d;
  border: 1px solid #353b3e;
  border-radius: 8px;
  min-height: 44px;
  padding: 11px 12px;
  color: #e9eceb;
  width: 100%;
  font-size: 15px;
  box-sizing: border-box;
}
.biz-input.textarea {
  height: 110px;
  line-height: 1.7;
}
button.biz-action {
  width: 100%;
  background: #9bcbaa;
  color: #17281d;
  border-radius: 8px;
  font-size: 15px;
  font-weight: 600;
  line-height: 22px;
  padding: 11px 12px;
  text-align: center;
  margin: 12px 0 0;
}
button.biz-action::after {
  border: 0;
}
button.biz-action[disabled] {
  background: #282d2f;
  color: #818b90;
}
button.biz-secondary {
  background: #272b2d;
  color: #e9eceb;
  border: 1px solid #353b3e;
}
.biz-note {
  overflow-wrap: anywhere;
  display: block;
  color: #a0a8ac;
  font-size: 12px;
  line-height: 1.7;
  margin-top: 8px;
}
.biz-error {
  background: #382d27;
  color: #e5bfa6;
  border: 1px solid #614638;
  padding: 11px 12px;
  border-radius: 8px;
  line-height: 1.6;
  font-size: 13px;
  margin-bottom: 12px;
}
.biz-tabs {
  display: flex;
  gap: 8px;
  overflow-x: auto;
  margin-bottom: 12px;
}
.biz-tabs view {
  padding: 6px 12px;
  white-space: nowrap;
  border: 1px solid #353b3e;
  border-radius: 8px;
  background: #1c1f21;
  color: #a0a8ac;
  font-size: 13px;
  line-height: 18px;
}
.biz-tabs .selected {
  color: #9bcbaa;
  border-color: #577b62;
  background: #25372c;
}
.biz-list-title {
  font-size: 14px;
  line-height: 20px;
  font-weight: 500;
  display: block;
  margin-bottom: 4px;
}
.biz-small {
  font-size: 12px;
  line-height: 1.6;
  overflow-wrap: anywhere;
  color: #a0a8ac;
}
.row.biz-note {
  display: flex;
  flex-wrap: wrap;
}
.biz-title-row {
  align-items: center;
  margin-bottom: 12px;
}
.biz-title-row .biz-heading {
  min-width: 0;
  margin: 0;
}
.biz-title-row .biz-link {
  flex-shrink: 0;
  padding: 6px 0;
}
.biz-picker-row {
  align-items: flex-start;
}
.biz-picker-row > text:first-child {
  flex-shrink: 0;
}
.biz-picker-row > text:last-child {
  min-width: 0;
  text-align: right;
  overflow-wrap: anywhere;
}
.biz-link {
  color: #9bcbaa;
  font-size: 13px;
  padding: 6px 0;
}
.biz-empty {
  text-align: center;
  padding: 44px 12px;
  color: #a0a8ac;
  font-size: 14px;
  line-height: 1.8;
}
.biz-pair {
  display: flex;
  gap: 10px;
}
.biz-pair > view {
  flex: 1;
  min-width: 0;
}
.biz-preview {
  width: 100%;
  border-radius: 10px;
  background: #272b2d;
}
.biz-card-head {
  align-items: flex-start;
}
.biz-card-head > text:first-child {
  flex: 1;
  min-width: 0;
  margin-bottom: 0;
  overflow-wrap: anywhere;
}
.biz-card-head > text:last-child {
  flex-shrink: 0;
  text-align: right;
}
.biz-record-meta {
  display: block;
  margin-top: 6px;
  line-height: 1.6;
  overflow-wrap: anywhere;
}
.biz-row > switch {
  flex-shrink: 0;
}
.biz-image {
  width: 100%;
  height: 160px;
  border-radius: 8px;
}
