.biz-card {
  border: 1px solid var(--ui-border);
  background: var(--ui-surface);
  border-radius: var(--ui-radius-card);
  padding: 20px 16px;
  margin-bottom: 12px;
}
.biz-heading {
  overflow-wrap: anywhere;
  font-size: 16px;
  line-height: 22px;
  font-weight: 600;
  display: block;
  margin-bottom: 12px;
}
.biz-value {
  overflow-wrap: anywhere;
  font-variant-numeric: tabular-nums;
  display: block;
  font-size: 30px;
  line-height: 38px;
  font-weight: 600;
  color: var(--ui-text);
  margin: 6px 0 10px;
}
.biz-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 12px 0;
  border-bottom: 1px solid var(--ui-border);
}
.biz-row:last-child {
  border-bottom: 0;
}
.biz-row + .biz-label {
  margin-top: 20px;
}
.biz-label {
  font-size: 13px;
  line-height: 18px;
  color: var(--ui-muted);
  display: block;
  margin-bottom: 8px;
}
.biz-input {
  background: var(--ui-field);
  border: 1px solid var(--ui-border);
  border-radius: var(--ui-radius-control);
  min-height: 52px;
  padding: 11px 12px;
  color: var(--ui-text);
  width: 100%;
  font-size: 15px;
  box-sizing: border-box;
}
.biz-input.textarea {
  height: 110px;
  line-height: 1.7;
}
button.biz-action {
  width: 100%;
  background: var(--ui-primary);
  color: var(--ui-on-brand);
  border-radius: var(--ui-radius-control);
  font-size: 15px;
  font-weight: 600;
  line-height: 22px;
  padding: 13px 12px;
  text-align: center;
  margin: 12px 0 0;
}
button.biz-action::after {
  border: 0;
}
button.biz-action[disabled] {
  background: var(--ui-disabled);
  color: var(--ui-disabled-text);
}
button.biz-secondary {
  border: 1px solid var(--ui-border);
  background: var(--ui-surface);
  color: var(--ui-text);
}
.biz-note {
  overflow-wrap: anywhere;
  display: block;
  color: var(--ui-muted);
  font-size: 12px;
  line-height: 1.7;
  margin-top: 8px;
}
.biz-error {
  background: var(--ui-danger-bg);
  color: var(--ui-danger);
  border: 1px solid var(--ui-danger-border);
  padding: 11px 12px;
  border-radius: 12px;
  line-height: 1.6;
  font-size: 13px;
  margin-bottom: 12px;
}
.biz-tabs {
  display: flex;
  gap: 8px;
  overflow-x: auto;
  margin-bottom: 12px;
}
.biz-tabs view {
  padding: 10px 14px;
  white-space: nowrap;
  border-radius: 10px;
  background: var(--ui-field);
  color: var(--ui-muted);
  font-size: 13px;
  line-height: 18px;
}
.biz-tabs .selected {
  color: var(--ui-link);
  background: var(--ui-selected);
  font-weight: 600;
}
.biz-list-title {
  font-size: 14px;
  line-height: 20px;
  font-weight: 500;
  display: block;
  margin-bottom: 4px;
}
.biz-small {
  font-size: 12px;
  line-height: 1.6;
  overflow-wrap: anywhere;
  color: var(--ui-muted);
}
.row.biz-note {
  display: flex;
  flex-wrap: wrap;
}
.biz-title-row {
  align-items: center;
  margin-bottom: 12px;
}
.biz-title-row .biz-heading {
  min-width: 0;
  margin: 0;
}
.biz-title-row .biz-link {
  flex-shrink: 0;
  padding: 6px 0;
}
.biz-picker-row {
  align-items: center;
}
.biz-picker-row > text:first-child {
  flex-shrink: 0;
}
/* A long value (e.g. a music file name) ends in "…" next to its arrow. */
.biz-picker-row > text:last-child {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.biz-link {
  color: var(--ui-link);
  font-size: 13px;
  padding: 6px 0;
}
.biz-empty {
  text-align: center;
  padding: 44px 12px;
  color: var(--ui-muted);
  font-size: 14px;
  line-height: 1.8;
}
.biz-pair {
  display: flex;
  gap: 10px;
  margin-bottom: 12px;
}
.biz-pair > view {
  flex: 1;
  min-width: 0;
}
.biz-preview {
  width: 100%;
  border-radius: 10px;
  background: var(--ui-field);
}
.biz-card-head {
  align-items: flex-start;
}
.biz-card-head > text:first-child {
  flex: 1;
  min-width: 0;
  margin-bottom: 0;
  overflow-wrap: anywhere;
}
.biz-card-head > text:last-child {
  flex-shrink: 0;
  text-align: right;
}
.biz-record-meta {
  display: block;
  margin-top: 6px;
  line-height: 1.6;
  overflow-wrap: anywhere;
}
.biz-row > switch {
  flex-shrink: 0;
}
.biz-image {
  width: 100%;
  height: 160px;
  border-radius: 8px;
}
/* A button pair closing a card uses the card's own bottom padding. */
.biz-card > .biz-pair:last-child {
  margin-bottom: 0;
}
.biz-tabs + .biz-label {
  margin-top: 20px;
}
/* Narrow phones: four chips still fit the row. */
@media (max-width: 350px) {
  .biz-tabs view {
    padding: 10px 10px;
  }
}
