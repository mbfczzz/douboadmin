/* A photograph behind the top of a page that fades into the page colour.
   The container opens its own stacking layer (.has-backdrop, common.wxss)
   so the photo sits under every in-flow child. */
.page-backdrop {
  position: absolute;
  z-index: -1;
  top: 0;
  left: 0;
  width: 100%;
  height: 400px;
  opacity: 0.32;
  -webkit-mask-image: linear-gradient(#000 0%, #000 30%, transparent 88%);
  mask-image: linear-gradient(#000 0%, #000 30%, transparent 88%);
  pointer-events: none;
}
