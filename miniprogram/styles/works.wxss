.completed-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px 8px;
}
.completed-cover {
  position: relative;
  height: 120px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
  background: var(--ui-field);
}
.completed-cover image:not(.gl) {
  width: 100%;
  height: 100%;
  border-radius: 8px;
}
.completed-duration {
  position: absolute;
  right: 6px;
  bottom: 6px;
  padding: 3px 5px;
  border-radius: 4px;
  background: #0f0f11bb;
  color: #ffffff;
  font-size: 12px;
}
.completed-title {
  display: block;
  font-size: 13px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-top: 8px;
}
