/* Content appears as soon as its data arrives: a fade from transparent read
   as a flash on the dark background every time a page loaded. */
.content-reveal {
  animation: none;
}
.skeleton {
  background: var(--ui-field);
  border-radius: 10px;
  animation: skeleton-pulse 1.2s ease-in-out infinite alternate;
}
.skeleton-line {
  height: 14px;
  width: 68%;
  margin: 12px 0 24px;
  border-radius: 4px;
}
.skeleton-line.short {
  width: 42%;
}
.skeleton-title {
  height: 18px;
  width: 70%;
  margin-top: 10px;
  border-radius: 4px;
}
@keyframes skeleton-pulse {
  from {
    opacity: 0.45;
  }
  to {
    opacity: 0.85;
  }
}
.ratio,
.resolution-option,
.mode-tab {
  transition:
    color 160ms ease,
    background-color 160ms ease,
    border-color 160ms ease;
}
.template,
.queue-item,
.completed-item,
.work,
.queue-link,
.menu {
  transition:
    opacity 120ms ease,
    transform 120ms ease;
}
.card-pressed {
  opacity: 0.78;
  transform: scale(0.985);
}
@media (prefers-reduced-motion: reduce) {
  .content-reveal,
  .skeleton {
    animation: none;
  }
  .ratio,
  .resolution-option,
  .mode-tab,
  .template,
  .queue-item,
  .completed-item,
  .work,
  .queue-link,
  .menu {
    transition: none;
  }
  .card-pressed {
    transform: none;
  }
}

/* List skeletons shaped like the rows they stand in for. */
.skel-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.skel-card {
  height: 132px;
  border-radius: 16px;
}
.skel-hero {
  height: 150px;
  border-radius: 16px;
}
.skel-row {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 6px 0;
}
.skel-dot {
  width: 40px;
  height: 40px;
  flex-shrink: 0;
  border-radius: 50%;
}
.skel-lines {
  flex: 1;
}
.skel-a {
  width: 60%;
  height: 14px;
  border-radius: 4px;
}
.skel-b {
  width: 85%;
  height: 12px;
  margin-top: 8px;
  border-radius: 4px;
}
/* Page skeletons: the real layout in grey, shown until data arrives. */
.skel-page {
  display: flex;
  flex-direction: column;
  gap: 14px;
}
.skel-profile {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 8px 0;
}
.skel-avatar {
  width: 64px;
  height: 64px;
  flex-shrink: 0;
  border-radius: 50%;
}
.skel-row {
  display: flex;
  gap: 8px;
}
.skel-row > .skeleton {
  flex: 1;
  height: 72px;
  border-radius: 14px;
}
.skel-strip {
  height: 64px;
  border-radius: 16px;
}
.skel-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
}
.skel-grid.three {
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 6px;
}
.skel-grid > .skeleton {
  height: calc((100vw - 50px) * 2 / 3);
  border-radius: 14px;
}
.skel-grid.three > .skeleton {
  height: calc((100vw - 52px) * 4 / 9);
  border-radius: 10px;
}
