.content-reveal {
  animation: content-reveal 180ms ease-out;
}
@keyframes content-reveal {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
.skeleton {
  background: var(--ui-field);
  border-radius: 9px;
  animation: skeleton-pulse 1.2s ease-in-out infinite alternate;
}
.skeleton-line {
  height: 14px;
  width: 68%;
  margin: 12px 0 24px;
  border-radius: 4px;
}
.skeleton-line.short {
  width: 42%;
}
.skeleton-title {
  height: 18px;
  width: 70%;
  margin-top: 10px;
  border-radius: 4px;
}
@keyframes skeleton-pulse {
  from {
    opacity: 0.45;
  }
  to {
    opacity: 0.85;
  }
}
.ratio,
.resolution-option,
.mode-tab {
  transition:
    color 160ms ease,
    background-color 160ms ease,
    border-color 160ms ease;
}
.template,
.queue-item,
.completed-item,
.work,
.queue-link,
.menu {
  transition:
    opacity 120ms ease,
    transform 120ms ease;
}
.card-pressed {
  opacity: 0.78;
  transform: scale(0.985);
}
@media (prefers-reduced-motion: reduce) {
  .content-reveal,
  .skeleton {
    animation: none;
  }
  .ratio,
  .resolution-option,
  .mode-tab,
  .template,
  .queue-item,
  .completed-item,
  .work,
  .queue-link,
  .menu {
    transition: none;
  }
  .card-pressed {
    transform: none;
  }
}
