page {
  --ui-bg: #131516;
  --ui-surface: #1c1f21;
  --ui-field: #272b2d;
  --ui-border: #353b3e;
  --ui-text: #e9eceb;
  --ui-muted: #a0a8ac;
  --ui-brand: #9bcbaa;
  --ui-on-brand: #17281d;
  --ui-selected: #25372c;
  --ui-danger: #dfb4a0;
  --ui-danger-bg: #352925;
  --ui-danger-border: #69483b;
  --ui-radius-control: 8px;
  --ui-radius-card: 12px;
  --ui-font-body: 14px;
  --ui-font-note: 12px;
  --ui-font-caption: 11px;
  --ui-touch-size: 44px;
  background: var(--ui-bg);
  color: var(--ui-text);
  font-family:
    -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei",
    sans-serif;
  font-size: var(--ui-font-body);
  --td-brand-color: var(--ui-brand);
  --td-brand-color-active: #86b796;
  --td-brand-color-disabled: #39463d;
  --td-text-color-primary: var(--ui-text);
  --td-text-color-secondary: var(--ui-muted);
  --td-bg-color-container: var(--ui-surface);
  --td-bg-color-page: var(--ui-bg);
  --td-border-level-1-color: var(--ui-border);
  --td-button-primary-bg-color: var(--ui-brand);
  --td-button-primary-color: var(--ui-on-brand);
  --td-button-primary-border-color: var(--ui-brand);
  --td-button-border-radius: 16rpx;
  --td-button-default-bg-color: var(--ui-field);
  --td-button-default-color: var(--ui-text);
  --td-button-default-border-color: var(--ui-border);
  --td-button-default-disabled-bg: #282d2f;
  --td-button-primary-disabled-bg: #282d2f;
  --td-button-primary-disabled-color: #818b90;
  --td-popup-bg-color: var(--ui-surface);
  --td-popup-border-radius: 32rpx;
}
