page {
  --ui-bg: #0f0f11;
  --ui-surface: #24252b;
  --ui-field: #2f3238;
  --ui-border: #34373e;
  --ui-text: #ffffff;
  --ui-muted: #a6a8ad;
  --ui-placeholder: #868a93;
  --ui-brand: #00c8dc;
  --ui-accent: var(--ui-brand);
  --ui-nav: #ffffff;
  --ui-on-brand: #15161a;
  --ui-primary: #ebf8ff;
  /* Sampled from the Jimeng app; see docs/ui-alignment.md. */
  --ui-link: #dbe3e9;
  --ui-selected: #474b54;
  --ui-points: #ffffff;
  --ui-points-muted: #b3bdc9;
  --ui-points-bg: #24252b;
  --ui-points-border: var(--ui-border);
  --ui-info: #8cbcff;
  --ui-info-bg: #202f46;
  --ui-danger: #ff91a1;
  --ui-danger-bg: #3a2028;
  --ui-danger-border: #75404c;
  --ui-success: #6fdaa0;
  --ui-success-bg: #193629;
  --ui-warning: #edc477;
  --ui-warning-bg: #382f1f;
  --ui-disabled: #34373e;
  --ui-disabled-text: #858b96;
  --ui-radius-control: 10px;
  --ui-radius-pill: 999px;
  --ui-sheet: #27292f;
  --ui-tabbar: #191a1f;
  --ui-tabbar-height: 70px;
  --ui-tab-pill: #2c2c2e;
  --ui-selected-line: rgba(255, 255, 255, 0.72);
  --ui-radius-card: 20px;
  --ui-font-body: 15px;
  --ui-font-note: 13px;
  --ui-font-caption: 12px;
  --ui-touch-size: 44px;
  background: var(--ui-bg);
  color: var(--ui-text);
  font-family:
    -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei",
    sans-serif;
  font-size: var(--ui-font-body);
  --td-brand-color: var(--ui-brand);
  --td-error-color: var(--ui-danger);
  --td-success-color: var(--ui-success);
  --td-warning-color: var(--ui-warning);
  --td-brand-color-active: #d4e2e9;
  --td-button-primary-active-bg-color: #d4e2e9;
  --td-button-primary-active-border-color: #d4e2e9;
  --td-brand-color-disabled: var(--ui-disabled);
  --td-text-color-primary: var(--ui-text);
  --td-text-color-secondary: var(--ui-muted);
  --td-text-color-disabled: var(--ui-disabled-text);
  --td-bg-color-container: var(--ui-surface);
  --td-bg-color-container-active: var(--ui-selected);
  --td-bg-color-component-active: var(--ui-selected);
  --td-bg-color-component-disabled: var(--ui-disabled);
  --td-component-border: var(--ui-border);
  --td-bg-color-page: var(--ui-bg);
  --td-border-level-1-color: var(--ui-border);
  --td-button-primary-bg-color: var(--ui-primary);
  --td-button-primary-color: var(--ui-on-brand);
  --td-button-primary-border-color: var(--ui-primary);
  --td-button-border-radius: 999px;
  --td-button-default-bg-color: var(--ui-field);
  --td-button-default-color: var(--ui-text);
  --td-button-default-border-color: var(--ui-field);
  --td-button-default-disabled-bg: var(--ui-disabled);
  --td-button-default-disabled-color: var(--ui-disabled-text);
  --td-button-primary-disabled-bg: var(--ui-disabled);
  --td-button-primary-disabled-color: var(--ui-disabled-text);
  --td-button-primary-outline-disabled-color: var(--ui-muted);
  --td-button-primary-text-disabled-color: var(--ui-muted);
  --td-popup-bg-color: var(--ui-sheet);
  --td-popup-border-radius: 20px;
  min-height: 100vh;
  --td-button-primary-outline-color: var(--ui-link);
  --td-button-primary-outline-border-color: var(--ui-field);
  --td-button-primary-text-color: var(--ui-link);
  --td-loading-color: var(--ui-muted);
  --td-loading-text-color: var(--ui-muted);
  --td-overlay-bg-color: #000000b3;
}
