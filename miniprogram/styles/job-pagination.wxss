.job-pagination {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 12px 0;
  color: #969ba4;
  font-size: 13px;
}
.job-pagination button {
  flex: 0 0 auto;
  margin: 0;
  min-height: 44px;
  padding: 12px;
  border-radius: 8px;
  line-height: 20px;
  font-size: inherit;
  color: #fafafa;
  background: #202125;
}
.job-pagination button[disabled] { color: #969ba4; }
