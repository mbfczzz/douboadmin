view,
image,
scroll-view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}
button::after {
  border: 0;
}
button {
  font-size: 15px;
  margin: 0;
}
image {
  display: block;
}
.page {
  padding: 10px 20px calc(80px + env(safe-area-inset-bottom));
}
.subpage {
  padding: 24px 20px calc(25px + env(safe-area-inset-bottom));
}
.muted {
  color: var(--ui-muted);
}
.small {
  font-size: var(--ui-font-note);
}
.tiny {
  font-size: var(--ui-font-caption);
}
.accent {
  color: var(--ui-link);
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}
.section-title {
  display: block;
  font-size: 16px;
  font-weight: 500;
  margin: 20px 0 11px;
}
.surface {
  background: var(--ui-surface);
  border-radius: var(--ui-radius-card);
}
.row.section-title {
  display: flex;
}
button.text-button {
  background: transparent;
  color: var(--ui-link);
  padding: 8px 0;
  line-height: 1.5;
  font-size: 13px;
}
button.phone-alternative {
  display: block;
  width: 100%;
  min-height: 44px;
  text-align: center;
}
.note {
  font-size: var(--ui-font-note);
  color: var(--ui-muted);
  text-align: center;
  margin: 12px 0;
  line-height: 1.7;
}
.empty {
  padding: 50px 10px;
  text-align: center;
  color: var(--ui-muted);
}
.empty .title {
  display: block;
  color: var(--ui-text);
  font-weight: 500;
  font-size: 16px;
  margin: 12px 0 7px;
}
/* TDesign buttons have no host element (virtualHost); style them through
   their t-class external class rather than a "t-button" tag selector. */
/* Empty-state lines stack; the action sits below them. */
.empty > text {
  display: block;
}
.empty-action {
  margin-top: 20px;
}
.empty .desc {
  font-size: 13px;
  line-height: 1.8;
  display: block;
}
.error-box {
  padding: 12px;
  background: var(--ui-danger-bg);
  border: 1px solid var(--ui-danger-border);
  border-radius: 12px;
  color: var(--ui-danger);
  font-size: 13px;
  line-height: 1.8;
  margin: 10px 0;
}
.loading {
  display: flex;
  justify-content: center;
  padding: 40px;
}
.queue-link {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 12px;
  background: var(--ui-surface);
  border-radius: var(--ui-radius-card);
  margin-top: 20px;
}
.queue-link .copy {
  flex: 1;
}
.queue-link .copy .muted {
  display: block;
  font-size: 13px;
  margin-top: 4px;
}
.form-input {
  border: 1px solid transparent;
  background: var(--ui-field);
  border-radius: 12px;
  padding: 11px;
  width: 100%;
  color: var(--ui-text);
  font-size: 15px;
}
.pill {
  font-size: 12px;
  border-radius: 6px;
  padding: 4px 6px;
  background: var(--ui-field);
  color: var(--ui-muted);
}
.pill.succeeded {
  background: var(--ui-success-bg);
  color: var(--ui-success);
}
.pill.failed {
  background: var(--ui-danger-bg);
  color: var(--ui-danger);
}
.pill.running {
  background: var(--ui-info-bg);
  color: var(--ui-info);
}
.pill.queued,
.pill.warning {
  background: var(--ui-warning-bg);
  color: var(--ui-warning);
}
.filter-scroll {
  white-space: nowrap;
  margin: 4px 0 15px;
}
.filter {
  display: inline-block;
  padding: 9px 0;
  margin-right: 21px;
  font-size: 13px;
  color: var(--ui-muted);
}
.filter.active {
  color: var(--ui-link);
  font-weight: 500;
}
.controls-busy {
  opacity: 0.6;
}
.recovery-actions {
  display: flex;
  gap: 24px;
  margin-top: 10px;
  color: var(--ui-link);
}
.button-content {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
}
.icon-tile {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 32px;
  height: 32px;
  border-radius: 10px;
  background: var(--ui-field);
  color: var(--ui-muted);
}
/* Jimeng marks credits with a four-point star. */
.points-mark {
  margin-right: 4px;
  font-size: 1em;
}
.brand-tile {
  border-radius: 16px;
}
.mode-tab.active,
.resolution-option.selected,
.filter.active,
.biz-tabs .selected {
  box-shadow: inset 0 0 0 1px var(--ui-selected-line);
}
.biz-tabs.sort-tabs .selected {
  box-shadow: none;
}
/* Empty, logged-out and error states: pages with content to point at show
   real template covers (components/showcase); the rest a quiet theme icon.
   The follow-up is a text link, not another button. */
/* Empty and signed-out states show a small photograph (assets/photos,
   bundled so it also appears offline) instead of a grey icon disc. */
.empty-photo {
  display: block;
  width: 88px;
  height: 88px;
  margin: 0 auto 14px;
  border-radius: 22px;
  background: var(--ui-surface);
  box-shadow: 0 0 0 1px #ffffff12;
}
.empty-link {
  display: inline-block;
  margin-top: 14px;
  padding: 10px 6px;
  font-size: 14px;
  font-weight: 500;
  color: var(--ui-brand);
}

.brand-tile.brand-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ui-muted);
  font-size: 24px;
  font-weight: 600;
}
