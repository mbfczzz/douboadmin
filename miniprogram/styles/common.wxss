view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}
button::after {
  border: 0;
}
button {
  font-size: 28rpx;
  margin: 0;
}
image {
  display: block;
}
.page {
  padding: 20rpx 38rpx calc(160rpx + env(safe-area-inset-bottom));
}
.subpage {
  padding: 24px 20px calc(25px + env(safe-area-inset-bottom));
}
.muted {
  color: #a0a8ac;
}
.small {
  font-size: 24rpx;
}
.tiny {
  font-size: 21rpx;
}
.accent {
  color: #9bcbaa;
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  margin: 40rpx 0 22rpx;
}
.surface {
  background: #1c1f21;
  border: 1rpx solid #353b3e;
  border-radius: 20rpx;
}
.row.section-title {
  display: flex;
}
.text-button {
  background: transparent;
  color: #9bcbaa;
  padding: 16rpx 0;
  line-height: 1.5;
  font-size: 25rpx;
}
.note {
  font-size: 23rpx;
  color: #a0a8ac;
  text-align: center;
  margin: 24rpx 0;
  line-height: 1.7;
}
.empty {
  padding: 100rpx 20rpx;
  text-align: center;
  color: #a0a8ac;
}
.empty .title {
  display: block;
  color: #e9eceb;
  font-weight: 500;
  font-size: 30rpx;
  margin: 24rpx 0 14rpx;
}
/* TDesign buttons have no host element (virtualHost); style them through
   their t-class external class rather than a "t-button" tag selector. */
.empty-action {
  margin-top: 20px;
}
.empty .desc {
  font-size: 24rpx;
  line-height: 1.8;
}
.error-box {
  padding: 24rpx;
  background: #352925;
  border: 1rpx solid #69483b;
  border-radius: 14rpx;
  color: #dfb4a0;
  font-size: 25rpx;
  line-height: 1.8;
  margin: 20rpx 0;
}
.loading {
  display: flex;
  justify-content: center;
  padding: 80rpx;
}
.queue-link {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 25rpx 24rpx;
  background: #1c1f21;
  border: 1rpx solid #353b3e;
  border-radius: 16rpx;
  margin-top: 40rpx;
}
.queue-link .copy {
  flex: 1;
}
.queue-link .copy .muted {
  display: block;
  font-size: 23rpx;
  margin-top: 8rpx;
}
.form-input {
  background: #1c1f21;
  border: 1rpx solid #353b3e;
  border-radius: 16rpx;
  padding: 22rpx;
  width: 100%;
  color: #e9eceb;
  font-size: 28rpx;
}
.sheet {
  padding: 30rpx 38rpx calc(40rpx + env(safe-area-inset-bottom));
  color: #e9eceb;
}
.pill {
  font-size: 21rpx;
  border-radius: 8rpx;
  padding: 8rpx 13rpx;
  background: #272b2d;
  color: #a0a8ac;
}
.pill.succeeded {
  background: #25372c;
  color: #9bcbaa;
}
.pill.failed {
  background: #352925;
  color: #dfb4a0;
}
.pill.running {
  background: #26373b;
  color: #a1cad1;
}
.filter-scroll {
  white-space: nowrap;
  margin: 8rpx 0 30rpx;
}
.filter {
  display: inline-block;
  padding: 18rpx 0;
  margin-right: 42rpx;
  font-size: 27rpx;
  color: #a0a8ac;
  border-bottom: 3rpx solid transparent;
}
.filter.active {
  color: #e9eceb;
  border-color: #9bcbaa;
}
.controls-busy {
  opacity: 0.6;
}
.recovery-actions {
  display: flex;
  gap: 24px;
  margin-top: 10px;
  color: #c5e2ce;
}
