view,
image,
scroll-view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}
button::after {
  border: 0;
}
button {
  font-size: 28rpx;
  margin: 0;
}
image {
  display: block;
}
.page {
  padding: 20rpx 38rpx calc(160rpx + env(safe-area-inset-bottom));
}
.subpage {
  padding: 24px 20px calc(25px + env(safe-area-inset-bottom));
}
.muted {
  color: var(--ui-muted);
}
.small {
  font-size: var(--ui-font-note);
}
.tiny {
  font-size: var(--ui-font-caption);
}
.accent {
  color: var(--ui-accent);
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  margin: 40rpx 0 22rpx;
}
.surface {
  background: var(--ui-surface);
  border: 1rpx solid var(--ui-border);
  border-radius: 20rpx;
}
.row.section-title {
  display: flex;
}
.text-button {
  background: transparent;
  color: var(--ui-brand);
  padding: 16rpx 0;
  line-height: 1.5;
  font-size: 25rpx;
}
.note {
  font-size: var(--ui-font-note);
  color: var(--ui-muted);
  text-align: center;
  margin: 24rpx 0;
  line-height: 1.7;
}
.empty {
  padding: 100rpx 20rpx;
  text-align: center;
  color: var(--ui-muted);
}
.empty .title {
  display: block;
  color: #f5f6f7;
  font-weight: 500;
  font-size: 30rpx;
  margin: 24rpx 0 14rpx;
}
/* TDesign buttons have no host element (virtualHost); style them through
   their t-class external class rather than a "t-button" tag selector. */
.empty-action {
  margin-top: 20px;
}
.empty .desc {
  font-size: 24rpx;
  line-height: 1.8;
}
.error-box {
  padding: 24rpx;
  background: var(--ui-danger-bg);
  border: 1rpx solid var(--ui-danger-border);
  border-radius: 14rpx;
  color: var(--ui-danger);
  font-size: 25rpx;
  line-height: 1.8;
  margin: 20rpx 0;
}
.loading {
  display: flex;
  justify-content: center;
  padding: 80rpx;
}
.queue-link {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 25rpx 24rpx;
  background: var(--ui-surface);
  border: 1rpx solid var(--ui-border);
  border-radius: 16rpx;
  margin-top: 40rpx;
}
.queue-link .copy {
  flex: 1;
}
.queue-link .copy .muted {
  display: block;
  font-size: 23rpx;
  margin-top: 8rpx;
}
.form-input {
  background: var(--ui-surface);
  border: 1rpx solid var(--ui-border);
  border-radius: 16rpx;
  padding: 22rpx;
  width: 100%;
  color: #f5f6f7;
  font-size: 28rpx;
}
.pill {
  font-size: 21rpx;
  border-radius: 8rpx;
  padding: 8rpx 13rpx;
  background: var(--ui-field);
  color: var(--ui-muted);
}
.pill.succeeded {
  background: #183024;
  color: #32d47a;
}
.pill.failed {
  background: #331b1a;
  color: #f05252;
}
.pill.running {
  background: #12303a;
  color: #22d3ee;
}
.filter-scroll {
  white-space: nowrap;
  margin: 8rpx 0 30rpx;
}
.filter {
  display: inline-block;
  padding: 18rpx 0;
  margin-right: 42rpx;
  font-size: 27rpx;
  color: var(--ui-muted);
  border-bottom: 3rpx solid transparent;
}
.filter.active {
  color: #f5f6f7;
  border-color: var(--ui-brand);
}
.controls-busy {
  opacity: 0.6;
}
.recovery-actions {
  display: flex;
  gap: 24px;
  margin-top: 10px;
  color: #4ade80;
}
