view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}
button::after {
  border: 0;
}
button {
  font-size: 28rpx;
  margin: 0;
}
image {
  display: block;
}
.page {
  padding: 20rpx 38rpx calc(160rpx + env(safe-area-inset-bottom));
}
.subpage {
  padding: 20rpx 38rpx calc(50rpx + env(safe-area-inset-bottom));
}
.muted {
  color: #a0a8ac;
}
.small {
  font-size: 24rpx;
}
.tiny {
  font-size: 21rpx;
}
.accent {
  color: #9bcbaa;
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.flex {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  margin: 40rpx 0 22rpx;
}
.surface {
  background: #1c1f21;
  border: 1rpx solid #353b3e;
  border-radius: 20rpx;
}
.row.section-title {
  display: flex;
}
.divider {
  height: 1rpx;
  background: #353b3e;
  margin: 32rpx 0;
}
.text-button {
  background: transparent;
  color: #9bcbaa;
  padding: 16rpx 0;
  line-height: 1.5;
  font-size: 25rpx;
}
.note {
  font-size: 23rpx;
  color: #a0a8ac;
  text-align: center;
  margin: 24rpx 0;
  line-height: 1.7;
}
.demo-label {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: #25372c;
  color: #9bcbaa;
  border-radius: 8rpx;
  padding: 8rpx 14rpx;
  font-size: 20rpx;
}
.empty {
  padding: 100rpx 20rpx;
  text-align: center;
  color: #a0a8ac;
}
.empty .title {
  display: block;
  color: #e9eceb;
  font-size: 30rpx;
  margin: 24rpx 0 14rpx;
}
.empty .desc {
  font-size: 24rpx;
  line-height: 1.8;
}
.error-box {
  padding: 24rpx;
  background: #352925;
  border: 1rpx solid #69483b;
  border-radius: 14rpx;
  color: #dfb4a0;
  font-size: 25rpx;
  line-height: 1.8;
  margin: 20rpx 0;
}
.loading {
  display: flex;
  justify-content: center;
  padding: 80rpx;
}
.chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.chip {
  background: #1c1f21;
  border: 1rpx solid #353b3e;
  color: #a0a8ac;
  border-radius: 12rpx;
  font-size: 25rpx;
  line-height: 1.4;
  padding: 18rpx 24rpx;
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.chip.selected {
  background: #25372c;
  border-color: #577b62;
  color: #bcdcc5;
}
.queue-link {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 25rpx 24rpx;
  background: #1c1f21;
  border: 1rpx solid #353b3e;
  border-radius: 16rpx;
  margin-top: 40rpx;
}
.queue-link .copy {
  flex: 1;
}
.queue-link .copy .muted {
  display: block;
  font-size: 23rpx;
  margin-top: 8rpx;
}
.field-label {
  font-size: 28rpx;
  margin-bottom: 20rpx;
  display: block;
}
.form-input {
  background: #1c1f21;
  border: 1rpx solid #353b3e;
  border-radius: 16rpx;
  padding: 22rpx;
  width: 100%;
  color: #e9eceb;
  font-size: 28rpx;
}
.sheet {
  padding: 30rpx 38rpx calc(40rpx + env(safe-area-inset-bottom));
  color: #e9eceb;
}
.sheet-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 30rpx;
}
.sheet-row {
  padding: 28rpx 12rpx;
  border-bottom: 1rpx solid #353b3e;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.sheet-row.selected {
  color: #9bcbaa;
}
.pill {
  font-size: 21rpx;
  border-radius: 8rpx;
  padding: 8rpx 13rpx;
  background: #272b2d;
  color: #a0a8ac;
}
.pill.succeeded {
  background: #25372c;
  color: #9bcbaa;
}
.pill.failed {
  background: #352925;
  color: #dfb4a0;
}
.pill.running {
  background: #26373b;
  color: #a1cad1;
}
.attachment {
  width: 112rpx;
  position: relative;
  flex-shrink: 0;
}
.attachment image {
  width: 112rpx;
  height: 112rpx;
  border-radius: 14rpx;
  object-fit: cover;
}
.attachment .remove {
  position: absolute;
  top: -9rpx;
  right: -9rpx;
  background: #404a46;
  border-radius: 50%;
  width: 36rpx;
  height: 36rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}
.attachment .file-icon {
  height: 112rpx;
  background: #272b2d;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 14rpx;
}
.attachment .filename {
  font-size: 20rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  margin-top: 10rpx;
  color: #a0a8ac;
}
.attachments {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
}
.filter-scroll {
  white-space: nowrap;
  margin: 8rpx 0 30rpx;
}
.filter {
  display: inline-block;
  padding: 18rpx 0;
  margin-right: 42rpx;
  font-size: 27rpx;
  color: #a0a8ac;
  border-bottom: 3rpx solid transparent;
}
.filter.active {
  color: #e9eceb;
  border-color: #9bcbaa;
}
.controls-busy {
  opacity: 0.6;
}
.recovery-actions {
  display: flex;
  gap: 24px;
  margin-top: 10px;
  color: #c5e2ce;
}
