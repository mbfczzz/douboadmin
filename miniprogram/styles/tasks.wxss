.task-card {
  padding: 28rpx;
  background: var(--ui-surface);
  border-radius: 16px;
  margin-bottom: 20rpx;
}
.task-title {
  font-size: 29rpx;
  line-height: 1.6;
  display: block;
  margin: 20rpx 0 15rpx;
}
.foot-actions {
  display: flex;
  gap: 20rpx;
  margin: 28rpx 0;
}
.foot-actions > view {
  flex: 1;
  min-width: 0;
}
