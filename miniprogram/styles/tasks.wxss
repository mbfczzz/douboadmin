.task-card {
  padding: 14px;
  background: var(--ui-surface);
  border-radius: var(--ui-radius-card);
  margin-bottom: 10px;
}
.task-title {
  font-size: 15px;
  line-height: 1.6;
  display: block;
  margin: 10px 0 8px;
}
.foot-actions {
  display: flex;
  gap: 10px;
  margin: 14px 0;
}
.foot-actions > view {
  flex: 1;
  min-width: 0;
}
