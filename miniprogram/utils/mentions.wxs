// @图片N / @视频N in a prompt, resolved against the attached references
// (numbered per kind, in strip order). Assets carry isImage / isVideo and
// data.url / data.thumbnailUrl (video cover).
function pick(assets, kind, number) {
  var n = 0;
  for (var i = 0; i < assets.length; i++) {
    var a = assets[i];
    if (kind === "图片" ? a.isImage : a.isVideo) {
      n++;
      if (n === number) return a;
    }
  }
  return null;
}
function chip(a, label) {
  return { chip: true, id: a.id, label: label, url: a.isImage ? a.data.url : a.data.thumbnailUrl, video: !a.isImage };
}
// The prompt as text runs and reference chips, in order. Plain string scanning
// (no RegExp: WXS regex support differs on devices); "@" or "＠", then 图片/视频
// and digits.
function segments(prompt, assets) {
  prompt = prompt || "";
  var out = [], last = 0, i = 0;
  while (i < prompt.length) {
    var c = prompt.charAt(i), kind = prompt.substring(i + 1, i + 3), j = i + 3;
    if ((c === "@" || c === "＠") && (kind === "图片" || kind === "视频")) {
      while (j < prompt.length && "0123456789".indexOf(prompt.charAt(j)) >= 0) j++;
      var a = j > i + 3 ? pick(assets, kind, parseInt(prompt.substring(i + 3, j))) : null;
      if (a) {
        if (i > last) out.push({ text: prompt.substring(last, i) });
        out.push(chip(a, kind + prompt.substring(i + 3, j)));
        last = i = j;
        continue;
      }
    }
    i++;
  }
  if (last < prompt.length) out.push({ text: prompt.substring(last) });
  return out;
}
// Each referenced item once, in first-mention order (the row under the editor).
function list(prompt, assets) {
  var parts = segments(prompt, assets), out = [], seen = {};
  for (var i = 0; i < parts.length; i++) {
    if (parts[i].chip && !seen[parts[i].id]) {
      seen[parts[i].id] = true;
      out.push(parts[i]);
    }
  }
  return out;
}
// Whether anything can be referenced (audio alone cannot).
function any(assets) {
  for (var i = 0; i < assets.length; i++) if (assets[i].isImage || assets[i].isVideo) return true;
  return false;
}
module.exports = { segments: segments, list: list, any: any };
