<view class="tabbar">
  <view
    class="item {{selected===index?'active':''}} {{item.primary?'primary':''}}"
    wx:for="{{items}}"
    wx:key="path"
    data-index="{{index}}"
    bindtap="switchTab"
    aria-role="button"
    aria-label="{{item.text+(selected===index?'，已选中':'')}}"
    hover-class="item-pressed"
  >
    <view class="glyph"><t-icon name="{{item.icon}}" size="24" /></view>
    <text class="label">{{item.text}}</text>
  </view>
</view>
