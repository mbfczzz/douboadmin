<view class="tabbar">
  <view
    class="item {{selected===index?'active':''}} {{item.primary?'primary':''}}"
    wx:for="{{items}}"
    wx:key="path"
    data-index="{{index}}"
    bindtap="switchTab"
    aria-role="button"
    aria-label="{{item.text+(selected===index?'，已选中':'')}}"
    hover-class="item-pressed"
  >
    <view class="glyph"><image wx:if="{{item.art}}" class="tab-art" src="{{selected===index||item.primary?item.artOn:item.art}}" /><t-icon wx:else name="{{selected===index&&item.on?item.on:item.icon}}" size="24" /></view>
    <text class="label">{{item.text}}</text>
  </view>
</view>
