.tabbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: #191c1e;
  border-top: 1rpx solid #2b3032;
  display: flex;
  padding: 12rpx 12rpx calc(8rpx + env(safe-area-inset-bottom));
  color: #9aa3a6;
}
.item {
  transition:
    color 160ms ease,
    opacity 120ms ease,
    transform 120ms ease;
  flex: 1;
  min-width: 0;
  height: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}
.glyph {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.label {
  font-size: 22rpx;
  line-height: 30rpx;
  font-weight: 500;
}
.active {
  color: #b1d8bd;
}
.active .label {
  font-weight: 600;
}
.item-pressed {
  opacity: 0.65;
  transform: scale(0.94);
}
@media (prefers-reduced-motion: reduce) {
  .item {
    transition: none;
  }
  .item-pressed {
    transform: none;
  }
}
