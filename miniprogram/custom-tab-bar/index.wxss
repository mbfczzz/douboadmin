.tabbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: var(--ui-tabbar, #191a1f);
  border-top: 1px solid var(--ui-border, #34373e);
  display: flex;
  padding: 0 10px env(safe-area-inset-bottom);
  color: var(--ui-muted, #a6a8ad);
}
.item {
  position: relative;
  transition:
    color 160ms ease,
    opacity 120ms ease,
    transform 120ms ease;
  flex: 1;
  min-width: 0;
  height: var(--ui-tabbar-height, 70px);
  min-height: 44px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
}
.glyph {
  position: relative;
  width: 44px;
  height: 40px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.label {
  font-size: 12px;
  line-height: 18px;
}
.primary .glyph {
  width: 52px;
  height: 40px;
  border-radius: 999px;
  color: var(--ui-text, #ffffff);
  background: var(--ui-tab-pill, #2c2c2e);
}
.active {
  color: var(--ui-nav, #ffffff);
}
.active .label {
  font-weight: 500;
}
.item-pressed {
  opacity: 0.65;
  transform: scale(0.94);
}
@media (prefers-reduced-motion: reduce) {
  .item {
    transition: none;
  }
  .item-pressed {
    transform: none;
  }
}
