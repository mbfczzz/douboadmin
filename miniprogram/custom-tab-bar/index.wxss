.tabbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: var(--ui-surface, #1c1e22);
  border-top: 1px solid var(--ui-border, #3b3e46);
  display: flex;
  padding: 0 10px env(safe-area-inset-bottom);
  color: var(--ui-muted, #a6abb5);
}
.item {
  position: relative;
  transition:
    color 160ms ease,
    opacity 120ms ease,
    transform 120ms ease;
  flex: 1;
  min-width: 0;
  height: 70px;
  min-height: 44px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
}
.glyph {
  position: relative;
  width: 44px;
  height: 40px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.label {
  font-size: 12px;
  line-height: 18px;
  font-weight: 500;
}
.primary .glyph {
  width: 52px;
  height: 40px;
  border-radius: 14px;
  color: var(--ui-on-brand, #082b30);
  background: var(--ui-primary, #00c8dc);
}
.active {
  color: var(--ui-nav, #f4f5f7);
}
.active:not(.primary) .glyph {
  background: var(--ui-selected, #17363b);
}
.primary .label {
  color: var(--ui-link, #66e3ee);
}
.active .label {
  font-weight: 600;
}
.item-pressed {
  opacity: 0.65;
  transform: scale(0.94);
}
@media (prefers-reduced-motion: reduce) {
  .item {
    transition: none;
  }
  .item-pressed {
    transform: none;
  }
}
