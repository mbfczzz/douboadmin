.tabbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: #1a1b1f;
  border-top: 1rpx solid #ffffff1a;
  display: flex;
  padding: 12rpx 12rpx calc(8rpx + env(safe-area-inset-bottom));
  color: #969ba4;
}
.item {
  position: relative;
  transition:
    color 160ms ease,
    opacity 120ms ease,
    transform 120ms ease;
  flex: 1;
  min-width: 0;
  height: 96rpx;
  min-height: 44px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}
.glyph {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.label {
  font-size: var(--ui-font-note, 12px);
  line-height: 16px;
  font-weight: 500;
}
.active {
  color: var(--ui-on-brand, #101113);
  background: var(--ui-nav, #e8faff);
  border-radius: 8px;
}
.active .label {
  font-weight: 600;
}
.item-pressed {
  opacity: 0.65;
  transform: scale(0.94);
}
@media (prefers-reduced-motion: reduce) {
  .item {
    transition: none;
  }
  .item-pressed {
    transform: none;
  }
}
