.tabbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: #03172b;
  border-top: 1rpx solid #ffffff12;
  display: flex;
  padding: 12rpx 12rpx calc(8rpx + env(safe-area-inset-bottom));
  color: #8b9aab;
}
.item {
  position: relative;
  transition:
    color 160ms ease,
    opacity 120ms ease,
    transform 120ms ease;
  flex: 1;
  min-width: 0;
  height: 96rpx;
  min-height: 44px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2px;
}
.glyph {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.label {
  font-size: 10px;
  line-height: 14px;
  font-weight: 500;
}
.primary .glyph {
  width: 52px;
  height: 36px;
  border-radius: 12px;
  color: #02070d;
  background: #ffffff;
}
.active {
  color: #ffffff;
}
.active .label {
  font-weight: 600;
}
.item-pressed {
  opacity: 0.65;
  transform: scale(0.94);
}
@media (prefers-reduced-motion: reduce) {
  .item {
    transition: none;
  }
  .item-pressed {
    transform: none;
  }
}
