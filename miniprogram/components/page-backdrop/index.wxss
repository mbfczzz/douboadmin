/* Fades in at the top (no hard line under the navigation bar) and out
   towards the content; appears softly once the picture has loaded. */
.backdrop {
  position: absolute;
  z-index: -1;
  top: 0;
  left: 0;
  width: 100%;
  height: 340px;
  opacity: 0;
  transition: opacity 420ms ease;
  -webkit-mask-image: linear-gradient(transparent 0%, #000 16%, #000 30%, transparent 94%);
  mask-image: linear-gradient(transparent 0%, #000 16%, #000 30%, transparent 94%);
  pointer-events: none;
}
.backdrop.ready {
  opacity: 0.34;
}
@media (prefers-reduced-motion: reduce) {
  .backdrop {
    transition: none;
  }
}
