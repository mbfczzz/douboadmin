.consent-row,
.consent-group,
.consent-label,
.consent-docs {
  display: flex;
  align-items: center;
}
.consent-row {
  justify-content: flex-start;
  flex-wrap: wrap;
  gap: 2px 3px;
  margin: 0 0 10px;
  color: var(--ui-muted);
  font-size: 13px;
  line-height: 1.7;
  text-align: left;
}
.consent-label {
  min-height: 40px;
}
.consent-check {
  margin-right: 4px;
  transform: scale(0.78);
}
.consent-link {
  min-height: 40px;
  display: flex;
  align-items: center;
  color: var(--ui-link);
}
.consent-docs {
  flex-shrink: 0;
  gap: 3px;
}
