/* One sentence that wraps like text; the small check keeps a 40px hit area. */
.consent {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  margin: 0 0 10px;
  color: var(--ui-muted);
  font-size: 13px;
  line-height: 20px;
  text-align: left;
}
.consent-hit {
  flex-shrink: 0;
  margin: -10px -6px -10px -10px;
  padding: 11px 6px 11px 10px;
}
.consent-box {
  position: relative;
  box-sizing: border-box;
  width: 18px;
  height: 18px;
  border: 1.5px solid var(--ui-placeholder);
  border-radius: 50%;
}
.on .consent-box {
  border-color: var(--ui-brand);
  background: var(--ui-brand);
}
.on .consent-box::after {
  content: "";
  position: absolute;
  top: 3px;
  left: 5.5px;
  width: 4px;
  height: 8px;
  border: solid var(--ui-on-brand);
  border-width: 0 2px 2px 0;
  transform: rotate(45deg);
}
.consent-text {
  flex: 1;
  min-width: 0;
}
.consent-link {
  display: inline-block;
  color: var(--ui-link);
  white-space: nowrap;
}
