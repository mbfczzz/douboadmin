/* Three covers fanned out, two tilted behind the front one. */
.stack {
  position: relative;
  width: 210px;
  height: 150px;
  margin: 0 auto 6px;
}
.card {
  position: absolute;
  top: 6px;
  left: 64px;
  width: 82px;
  height: 112px;
  border-radius: 12px;
  overflow: hidden;
  background: var(--ui-field, #2f3238);
  border: 2px solid var(--ui-bg, #0f0f11);
  box-shadow: 0 8px 18px #00000080;
  transition: transform 160ms ease;
}
.card image {
  width: 100%;
  height: 100%;
}
/* covers[0] (the first template) is in front. */
.card-1 {
  transform: translateX(-46px) translateY(8px) rotate(-10deg);
}
.card-2 {
  transform: translateX(46px) translateY(8px) rotate(10deg);
}
.card-0 {
  z-index: 1;
  width: 90px;
  height: 124px;
  left: 60px;
  top: 0;
}
.card-pressed {
  opacity: 0.85;
}
/* Strip: a sideways row of covers with titles. */
.strip-scroll {
  white-space: nowrap;
}
.strip-items {
  display: flex;
  gap: 10px;
  padding-bottom: 2px;
}
.strip-card {
  flex: 0 0 104px;
  width: 104px;
}
.strip-cover {
  position: relative;
  height: 140px;
  border-radius: 12px;
  overflow: hidden;
  background: var(--ui-field, #2f3238);
}
.strip-cover image {
  width: 100%;
  height: 100%;
}
.strip-title {
  display: block;
  margin-top: 6px;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 12px;
  line-height: 18px;
  color: var(--ui-text, #ffffff);
}
.strip-cover::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 40%;
  background: linear-gradient(180deg, transparent, #0f0f1199);
}
.strip-length {
  position: absolute;
  left: 6px;
  bottom: 6px;
  z-index: 1;
  padding: 0 6px;
  border-radius: 6px;
  background: #0f0f11a6;
  color: #ffffff;
  font-size: 11px;
  line-height: 18px;
}
