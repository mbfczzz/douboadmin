.gallery-heading { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 6px; padding: 12px 2px; font-size: 13px; color: var(--ui-text); }
.gallery-heading text { font-size: 11px; color: var(--ui-muted); }
.multiple .gallery-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
.gallery-item { min-width: 0; overflow: hidden; border-radius: 12px; background: var(--ui-field); }
.gallery-image { display: block; width: 100%; }
.multiple .gallery-image { height: 160px; }
.gallery-caption { display: flex; justify-content: space-between; align-items: center; gap: 4px; padding: 6px 8px; font-size: 12px; color: var(--ui-muted); }
.gallery-caption button { margin: 0; padding: 4px 8px; min-height: 32px; line-height: 24px; font-size: 12px; color: var(--ui-primary); background: transparent; }
.gallery-caption button::after { border: 0; }
.gallery-caption button[disabled] { opacity: .5; }
@media (max-width: 360px) { .multiple .gallery-image { height: 130px; } }
