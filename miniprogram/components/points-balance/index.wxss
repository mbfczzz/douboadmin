.balance {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin: 0;
  padding: 24rpx;
  border-radius: 20rpx;
  background: var(--td-bg-color-container, var(--ui-surface, #1a1b1f));
}
.balance-copy {
  min-width: 0;
  flex: 1;
}
.label,
.note {
  display: block;
  color: var(--td-text-color-secondary, var(--ui-muted, #969ba4));
  font-size: var(--ui-font-note, 12px);
}
.amount {
  display: block;
  margin: 6rpx 0;
  color: var(--td-text-color-primary, #f5f6f7);
  font-size: 38rpx;
  font-weight: 600;
  overflow-wrap: anywhere;
}
button.action {
  min-height: 44px;
  width: auto;
  flex-shrink: 0;
  margin: 0;
  padding: 11px 12px;
  line-height: 22px;
  border-radius: 14rpx;
  color: #fff;
  background: var(--ui-magenta, #e10b72);
  font-size: var(--ui-font-body, 14px);
}
.action::after {
  border: 0;
}
.error {
  display: block;
  color: #f05252;
  font-size: 24rpx;
  padding: 12rpx 0;
}
