.balance {
  border: 1px solid transparent;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: space-between;
  gap: 12px;
  box-sizing: border-box;
  margin: 0;
  padding: 16px;
  border-radius: var(--ui-radius-card);
  min-height: 152px;
  background: var(--ui-points-bg);
}
.balance-copy {
  min-width: 0;
  flex: 1;
}
.label,
.note {
  display: block;
  color: var(--ui-points-muted);
  font-size: var(--ui-font-note, 13px);
}
.amount {
  display: block;
  margin: 8px 0 0;
  color: var(--ui-points);
  font-size: 32px;
  font-weight: 600;
  overflow-wrap: anywhere;
}
button.action {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 44px;
  width: auto;
  flex-shrink: 0;
  margin: 0;
  padding: 12px;
  line-height: 22px;
  border-radius: 999px;
  color: var(--ui-on-brand, #15161a);
  background: var(--ui-primary, #ebf8ff);
  font-size: var(--ui-font-body, 15px);
  font-weight: 600;
}
button.action::after {
  border: 0;
}
.error {
  display: block;
  color: var(--ui-danger, #ff91a1);
  font-size: 13px;
  padding: 6px 0;
}
.balance-bottom,
.note {
  display: flex;
  align-items: center;
  gap: 8px;
}
.balance-bottom {
  justify-content: space-between;
}
.note {
  min-width: 0;
}
button.action {
  flex-shrink: 0;
}
.inline-balance {
  display: flex;
  align-items: center;
  gap: 6px;
  min-height: 44px;
  font-size: 13px;
  line-height: 18px;
  color: var(--ui-points);
}
.inline-balance text {
  min-width: 0;
  white-space: nowrap;
}

.points-mark {
  margin-right: 4px;
}
.balance-row {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px 16px;
  border-radius: 16px;
  background: var(--ui-surface);
  color: var(--ui-muted);
}
.row-pressed {
  opacity: 0.75;
}
.row-mark {
  width: 36px;
  height: 36px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12px;
  overflow: hidden;
  background: var(--ui-field);
}
.row-mark-art {
  width: 100%;
  height: 100%;
}
.row-copy {
  flex: 1;
  min-width: 0;
}
.row-amount {
  display: block;
  font-size: 20px;
  font-weight: 700;
  line-height: 26px;
  color: var(--ui-text);
  font-variant-numeric: tabular-nums;
}
.row-label {
  display: block;
  font-size: 12px;
  line-height: 18px;
}
.row-go {
  font-size: 13px;
  color: var(--ui-text);
}
