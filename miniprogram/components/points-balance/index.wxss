.balance {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin: 0;
  padding: 24rpx;
  border-radius: 20rpx;
  background: var(--td-bg-color-container, var(--ui-surface, #1c1f21));
}
.balance-copy {
  min-width: 0;
  flex: 1;
}
.label,
.note {
  display: block;
  color: var(--td-text-color-secondary, var(--ui-muted, #a0a8ac));
  font-size: var(--ui-font-note, 12px);
}
.amount {
  display: block;
  margin: 6rpx 0;
  color: var(--td-text-color-primary, #e9eceb);
  font-size: 38rpx;
  font-weight: 600;
  overflow-wrap: anywhere;
}
button.action {
  min-height: 44px;
  width: auto;
  flex-shrink: 0;
  margin: 0;
  padding: 11px 12px;
  line-height: 22px;
  border-radius: 14rpx;
  color: var(--td-button-primary-color, var(--ui-on-brand, #17281d));
  background: var(--td-brand-color, var(--ui-brand, #9bcbaa));
  font-size: var(--ui-font-body, 14px);
}
.action::after {
  border: 0;
}
.error {
  display: block;
  color: #e5bfa6;
  font-size: 24rpx;
  padding: 12rpx 0;
}
