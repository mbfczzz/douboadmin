.balance {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin: 0;
  padding: 16px;
  border-radius: 16px;
  background: var(--td-bg-color-container, var(--ui-surface, #1a1a1a));
}
.balance-copy {
  min-width: 0;
  flex: 1;
}
.label,
.note {
  display: block;
  color: var(--td-text-color-secondary, var(--ui-muted, #a6a6a6));
  font-size: var(--ui-font-note, 12px);
}
.amount {
  display: block;
  margin: 6rpx 0;
  color: var(--td-text-color-primary, #ffffff);
  font-size: 38rpx;
  font-weight: 600;
  overflow-wrap: anywhere;
}
button.action {
  min-height: 44px;
  width: auto;
  flex-shrink: 0;
  margin: 0;
  padding: 11px 18px;
  line-height: 22px;
  border-radius: 22px;
  color: var(--ui-on-brand, #121212);
  background: var(--ui-primary, #ffffff);
  font-size: var(--ui-font-body, 14px);
  font-weight: 600;
}
.action::after {
  border: 0;
}
.error {
  display: block;
  color: #ff3355;
  font-size: 24rpx;
  padding: 12rpx 0;
}
