.balance {
  border: 1px solid var(--ui-gold-border, #e7d1a4);
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: space-between;
  gap: 12px;
  box-sizing: border-box;
  margin: 0;
  padding: 16px;
  border-radius: 16px;
  min-height: 152px;
  background: var(--ui-gold-bg, #fff8e8);
}
.balance-copy {
  min-width: 0;
  flex: 1;
}
.label,
.note {
  display: block;
  color: var(--ui-gold-muted, #7e6b49);
  font-size: var(--ui-font-note, 12px);
}
.amount {
  display: block;
  margin: 8px 0 0;
  color: var(--ui-gold, #825718);
  font-size: 32px;
  font-weight: 600;
  overflow-wrap: anywhere;
}
button.action {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 44px;
  width: auto;
  flex-shrink: 0;
  margin: 0;
  padding: 12px;
  line-height: 22px;
  border-radius: 12px;
  color: var(--ui-on-brand, #ffffff);
  background: var(--ui-primary, #4255c7);
  font-size: var(--ui-font-body, 14px);
  font-weight: 600;
}
.action::after {
  border: 0;
}
.error {
  display: block;
  color: var(--ui-danger, #b42338);
  font-size: 24rpx;
  padding: 12rpx 0;
}
.balance-bottom,
.note {
  display: flex;
  align-items: center;
  gap: 8px;
}
.balance-bottom {
  justify-content: space-between;
}
.note {
  min-width: 0;
}
.action {
  flex-shrink: 0;
}
.inline-balance {
  display: flex;
  align-items: center;
  gap: 6px;
  min-height: 44px;
  font-size: 12px;
  line-height: 18px;
  color: var(--ui-gold, #825718);
}
.inline-balance text {
  min-width: 0;
  overflow-wrap: anywhere;
}
