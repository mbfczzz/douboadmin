.nav {
  background: var(--ui-bg, #0f0f11);
  color: var(--ui-text);
  position: sticky;
  top: 0;
  z-index: 50;
}
.nav-inner {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 500;
}
.back {
  position: absolute;
  left: 10px;
  top: 0;
  height: 100%;
  width: 40px;
  min-width: 44px;
  display: flex;
  align-items: center;
}
.nav-actions {
  position: absolute;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
}
