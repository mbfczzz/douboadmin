.nav {
  background: var(--ui-bg, #121212);
  color: #ffffff;
  position: sticky;
  top: 0;
  z-index: 50;
}
.nav-inner {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
}
.back {
  position: absolute;
  left: 20rpx;
  top: 0;
  height: 100%;
  width: 80rpx;
  min-width: 44px;
  display: flex;
  align-items: center;
}
.nav-actions {
  position: absolute;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
}
