@import "../../styles/works.wxss";
.queue-page {
  padding: 24px 20px calc(30px + env(safe-area-inset-bottom));
}
.queue-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20px;
  font-size: 15px;
  font-weight: 500;
}
.failure-count {
  font-size: 12px;
  color: var(--ui-muted);
  font-weight: 400;
}
.queue-item {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 16px 0;
  border-bottom: 1px solid #ffffff0f;
}
.queue-thumb {
  width: 64px;
  height: 80px;
  flex-shrink: 0;
  border-radius: 8px;
  background: #13283d;
  color: var(--ui-muted);
  display: flex;
  align-items: center;
  justify-content: center;
}
.queue-copy {
  flex: 1;
  min-width: 0;
}
.queue-title-row {
  display: flex;
  align-items: center;
  gap: 8px;
}
.queue-title {
  flex: 1;
  font-size: 15px;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.queue-state {
  font-size: 12px;
  white-space: nowrap;
  color: var(--ui-muted);
}
.queue-state.running {
  color: var(--ui-brand);
}
.queue-state.failed {
  color: #ff3355;
}
.queue-spec {
  overflow-wrap: anywhere;
  display: block;
  font-size: 12px;
  line-height: 1.5;
  color: var(--ui-muted);
  margin-top: 7px;
}
.queue-time {
  flex-wrap: wrap;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  font-size: 12px;
  color: var(--ui-muted);
  margin-top: 16px;
}
.completed-heading {
  font-size: 15px;
  font-weight: 500;
  margin: 20px 0 16px;
}
.completed-more {
  margin: -12px 0;
  padding: 12px 0;
  font-size: 12px;
  font-weight: 400;
  color: #a9b6c4;
}

@import "../../styles/job-pagination.wxss";
