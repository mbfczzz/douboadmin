@import "../../styles/works.wxss";
@import "../../styles/job-pagination.wxss";
@import "./cards.wxss";
.queue-page {
  padding: 24px 20px calc(30px + env(safe-area-inset-bottom));
}
.completed-heading {
  font-size: 15px;
  font-weight: 500;
  margin: 20px 0 16px;
}
.completed-more {
  margin: -12px 0;
  padding: 12px 0;
  font-size: 13px;
  font-weight: 400;
  color: var(--ui-muted);
}


/* Three counters on top; a live bar under each running task. */
.queue-stats {
  display: flex;
  gap: 8px;
  margin-bottom: 8px;
}
.stat {
  flex: 1;
  padding: 12px 14px;
  border-radius: 14px;
  background: var(--ui-surface);
}
.stat-num {
  display: block;
  font-size: 22px;
  font-weight: 700;
  line-height: 28px;
  font-variant-numeric: tabular-nums;
}
.stat-label {
  font-size: 12px;
  color: var(--ui-muted);
}
.stat.running .stat-num {
  color: var(--ui-brand);
}
.stat.failed .stat-num {
  color: var(--ui-danger);
}
.queue-progress {
  display: flex;
  align-items: center;
  gap: 8px;
  margin: 6px 0 2px;
  font-size: 11px;
  color: var(--ui-brand);
}
.queue-bar {
  flex: 1;
  height: 3px;
  overflow: hidden;
  border-radius: 2px;
  background: #ffffff1a;
}
.queue-bar view {
  height: 100%;
  border-radius: 2px;
  background: var(--ui-brand);
}
