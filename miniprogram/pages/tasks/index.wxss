@import "../../styles/works.wxss";
.queue-page {
  padding: 24px 20px calc(30px + env(safe-area-inset-bottom));
}
.queue-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20px;
  font-size: 15px;
  font-weight: 500;
}
.failure-count {
  font-size: 12px;
  color: #d5a48f;
  font-weight: 400;
}
.queue-item {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 16px 0;
  border-bottom: 1px solid #353b3e;
}
.queue-thumb {
  width: 64px;
  height: 80px;
  flex-shrink: 0;
  border-radius: 6px;
  background: #202326;
  color: #a0a8ac;
  display: flex;
  align-items: center;
  justify-content: center;
}
.queue-copy {
  flex: 1;
  min-width: 0;
}
.queue-title-row {
  display: flex;
  align-items: center;
  gap: 8px;
}
.queue-title {
  flex: 1;
  font-size: 15px;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.queue-state {
  font-size: 12px;
  white-space: nowrap;
  color: #a0a8ac;
}
.queue-state.running {
  color: #9bcbaa;
}
.queue-state.failed {
  color: #e6ab94;
}
.queue-spec {
  overflow-wrap: anywhere;
  display: block;
  font-size: 12px;
  line-height: 1.5;
  color: #a0a8ac;
  margin-top: 7px;
}
.queue-time {
  flex-wrap: wrap;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  font-size: 12px;
  color: #a0a8ac;
  margin-top: 16px;
}
.completed-heading {
  font-size: 15px;
  font-weight: 500;
  margin: 20px 0 12px;
}
.empty t-button {
  display: block;
  margin-top: 20px;
}
