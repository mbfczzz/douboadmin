.templates-page {
  padding: 20px 20px calc(94px + env(safe-area-inset-bottom));
}
.templates-page .filter-scroll {
  margin: 16px 0 20px;
}
.templates-page .filter.active {
  font-weight: 600;
  color: var(--ui-link);
  background: var(--ui-selected);
}
.templates-page .filter {
  font-size: 13px;
  line-height: 22px;
  padding: 11px 18px;
  min-width: 70px;
  text-align: center;
  margin-right: 6px;
  border-radius: 10px;
  background: var(--ui-surface);
  border-bottom-width: 0;
}
.templates-page .filter:last-child {
  margin-right: 0;
}
.search-field {
  display: flex;
  background: var(--ui-field);
  border: 1px solid var(--ui-border);
  padding: 0 16px;
  gap: 12px;
  border-radius: 12px;
  margin: 0;
  height: 52px;
  color: var(--ui-muted);
  align-items: center;
}
.search-field input {
  flex: 1;
  min-width: 0;
  font-size: 14px;
}
.search-field text {
  margin: 0 -12px 0 0;
  padding: 12px;
  font-size: 14px;
  color: var(--ui-link);
}
.waterfall {
  display: flex;
  align-items: flex-start;
  gap: 12px;
}
.column {
  width: calc(50% - 6px);
}
.template {
  margin-bottom: 28px;
}
.cover {
  height: 144px;
  position: relative;
  border-radius: 12px;
  overflow: hidden;
  background: var(--ui-field);
}
.cover image {
  width: 100%;
  height: 100%;
}
.play {
  position: absolute;
  right: 8px;
  background: #0f0f11bb;
  color: #fff;
  border-radius: 50%;
  width: 22px;
  height: 22px;
  display: flex;
  align-items: center;
  justify-content: center;
  bottom: 8px;
}
/* At most two lines, so long titles keep the two columns aligned. */
.title {
  word-break: break-all;
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  font-size: 14px;
  font-weight: 400;
  line-height: 22px;
  height: 44px;
  margin: 10px 0 0;
  color: var(--ui-text);
}
.end {
  text-align: center;
  color: var(--ui-muted);
  font-size: 13px;
  border: 1px solid var(--ui-border);
  border-radius: 12px;
  background: var(--ui-surface);
  padding: 14px;
  min-height: 48px;
}
