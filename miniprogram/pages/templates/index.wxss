.search-icon {
  padding: 12rpx;
}
.templates-page {
  padding: 8px 12px calc(90px + env(safe-area-inset-bottom));
}
.templates-page .filter-scroll {
  margin: 0 4px 12px;
}
.templates-page .filter.active {
  font-weight: 600;
  font-size: 16px;
}
.templates-page .filter {
  font-size: 15px;
  line-height: 22px;
  padding: 11px 0;
  margin-right: 24px;
  border-bottom-width: 0;
}
.templates-page .filter:last-child {
  margin-right: 0;
}
.search-field {
  display: flex;
  background: var(--ui-surface);
  padding: 0 16px;
  gap: 12px;
  border-radius: 12px;
  margin: 4px 0 8px;
  height: 44px;
  align-items: center;
}
.search-field input {
  flex: 1;
  font-size: 14px;
}
.search-field text {
  margin: 0 -12px 0 0;
  padding: 12px;
  font-size: 14px;
  color: var(--ui-text);
}
.waterfall {
  display: flex;
  align-items: flex-start;
  gap: 8px;
}
.column {
  width: calc(50% - 4px);
}
.template {
  margin-bottom: 16px;
}
.cover {
  height: 213px;
  position: relative;
  border-radius: 12px;
  overflow: hidden;
  background: var(--ui-field);
}
.cover.alternate {
  height: 174px;
}
.template:nth-child(2n) .cover {
  height: 189px;
}
.template:nth-child(2n) .cover.alternate {
  height: 228px;
}
.cover image {
  width: 100%;
  height: 100%;
}
.play {
  position: absolute;
  right: 8px;
  background: #0f0f11bb;
  color: #fff;
  border-radius: 50%;
  width: 22px;
  height: 22px;
  display: flex;
  align-items: center;
  justify-content: center;
  top: 8px;
}
/* At most two lines, so long titles keep the two columns aligned. */
.title {
  word-break: break-all;
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  font-size: 13px;
  font-weight: 400;
  line-height: 18px;
  margin: 8px 4px 0;
  color: #e3ebf0;
}
.end {
  text-align: center;
  color: var(--ui-muted);
  font-size: 13px;
  padding: 0 0 28px;
}
