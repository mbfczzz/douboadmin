.templates-page {
  padding: 20px 20px calc(94px + env(safe-area-inset-bottom));
}
.templates-page .filter-scroll {
  margin: 16px 0 20px;
}
.templates-page .filter.active {
  font-weight: 500;
  color: var(--ui-text);
  background: var(--ui-selected);
}
.templates-page .filter {
  line-height: 22px;
  padding: 11px 18px;
  min-width: 70px;
  text-align: center;
  margin-right: 6px;
  border-radius: var(--ui-radius-pill);
  background: var(--ui-surface);
}
.templates-page .filter:last-child {
  margin-right: 0;
}
.search-field {
  display: flex;
  background: var(--ui-field);
  padding: 0 16px;
  gap: 4px;
  border-radius: var(--ui-radius-pill);
  margin: 0;
  height: 52px;
  color: var(--ui-muted);
  align-items: center;
}
.search-field input {
  flex: 1;
  min-width: 0;
  font-size: 15px;
}
.search-field text {
  margin: 0 -12px 0 0;
  padding: 12px;
  font-size: 15px;
  color: var(--ui-link);
}
.clear-search {
  flex: 0 0 44px;
  width: 44px;
  height: 44px;
  padding: 0;
  background: transparent;
  color: var(--ui-muted);
  display: flex;
  align-items: center;
  justify-content: center;
}
.waterfall {
  display: flex;
  align-items: flex-start;
  gap: 10px;
}
.column {
  width: calc(50% - 5px);
}
.template {
  margin-bottom: 18px;
}
.cover {
  height: 212px;
  position: relative;
  border-radius: 12px;
  overflow: hidden;
  background: var(--ui-field);
}
.cover image {
  width: 100%;
  height: 100%;
}
.play {
  position: absolute;
  right: 8px;
  background: #0f0f11bb;
  color: #fff;
  border-radius: 50%;
  width: 22px;
  height: 22px;
  display: flex;
  align-items: center;
  justify-content: center;
  bottom: 8px;
}
.title {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 15px;
  font-weight: 400;
  line-height: 22px;
  margin: 8px 0 0;
  color: var(--ui-text);
}
.end {
  text-align: center;
  color: var(--ui-muted);
  font-size: 13px;
  border: 1px solid transparent;
  border-radius: 12px;
  background: var(--ui-surface);
  padding: 14px;
  min-height: 48px;
}
