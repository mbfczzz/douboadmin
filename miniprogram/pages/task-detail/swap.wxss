/* 一键复刻: which of the user's pictures replaces which subject. */
.swap-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-top: 14px;
  padding: 14px;
  border-radius: var(--ui-radius-card);
  background: var(--ui-surface);
}
.swap-title {
  font-size: 13px;
  color: var(--ui-muted);
}
.swap-row {
  display: flex;
  align-items: center;
  gap: 10px;
}
.swap-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.swap-name {
  font-size: 14px;
  font-weight: 600;
}
.swap-look {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 12px;
  color: var(--ui-muted);
}
.swap-picks {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 6px;
}
.swap-pick {
  width: 40px;
  height: 40px;
  overflow: hidden;
  border-radius: 10px;
  opacity: 0.5;
  box-shadow: inset 0 0 0 1px #ffffff1f;
}
.swap-pick image {
  width: 100%;
  height: 100%;
}
.swap-pick.on {
  opacity: 1;
  box-shadow: 0 0 0 2px var(--ui-brand);
}
.swap-keep {
  height: 40px;
  padding: 0 10px;
  border-radius: 10px;
  font-size: 12px;
  line-height: 40px;
  color: var(--ui-muted);
  background: var(--ui-field);
}
.swap-keep.on {
  color: var(--ui-text);
  box-shadow: inset 0 0 0 1.5px var(--ui-brand);
}
