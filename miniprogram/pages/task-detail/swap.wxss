/* 一键复刻: each subject of the original with its own replacement slot. */
.swap-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-top: 14px;
  padding: 14px;
  border-radius: var(--ui-radius-card);
  background: var(--ui-surface);
}
.swap-head {
  display: flex;
  flex-direction: column;
  gap: 2px;
  margin-bottom: 2px;
}
.swap-title {
  font-size: 15px;
  font-weight: 600;
}
.swap-hint {
  font-size: 12px;
  line-height: 1.5;
  color: var(--ui-muted);
}
.swap-add {
  height: 76px;
  border-radius: 12px;
  background: var(--ui-field);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3px;
  font-size: 10px;
  color: var(--ui-muted);
  box-shadow: inset 0 0 0 1px #ffffff1f;
}
.swap-remove {
  position: absolute;
  top: 3px;
  right: 3px;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  text-align: center;
  line-height: 19px;
  color: #fff;
  background: #000a;
}
.swap-subjects {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding-top: 4px;
}
.swap-row {
  display: flex;
  align-items: center;
  gap: 10px;
}
.swap-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.swap-name {
  font-size: 14px;
  font-weight: 600;
}
.swap-look {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 12px;
  color: var(--ui-muted);
}
/* Empty: an upload tile; filled: the picture with × to keep the original. */
.swap-slot {
  position: relative;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2px;
  width: 56px;
  height: 56px;
  border-radius: 12px;
  font-size: 11px;
  color: var(--ui-muted);
  background: var(--ui-field);
  box-shadow: inset 0 0 0 1px #ffffff1f;
}
.swap-slot.filled {
  box-shadow: 0 0 0 2px var(--ui-brand);
}
.swap-slot.is-busy {
  opacity: 0.6;
}
.swap-slot image {
  width: 100%;
  height: 100%;
  border-radius: 12px;
}
.swap-clear {
  position: absolute;
  top: -6px;
  right: -6px;
  width: 20px;
  height: 20px;
  border-radius: 10px;
  line-height: 18px;
  text-align: center;
  font-size: 14px;
  color: #fff;
  background: #000000b3;
}
