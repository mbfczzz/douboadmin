.task-detail-page {
  padding: 24px 20px calc(30px + env(safe-area-inset-bottom));
}
.task-heading {
  word-break: break-all;
  display: block;
  font-size: 20px;
  font-weight: 600;
  line-height: 1.4;
  margin: 0 0 12px;
  color: var(--ui-text);
}
.task-state {
  flex-wrap: wrap;
  font-size: 13px;
  color: var(--ui-muted);
  gap: 8px;
}
.state-label {
  min-width: 0;
  flex-wrap: wrap;
  display: flex;
  align-items: center;
  gap: 10px;
}
.task-state .small {
  font-size: 12px;
}
.task-state.failed .state-label {
  color: var(--ui-danger);
}
.task-state.running .state-label {
  color: var(--ui-info);
  --td-loading-color: var(--ui-info);
}
.task-state.succeeded .state-label {
  color: var(--ui-success);
}
.task-state.queued .state-label {
  color: var(--ui-warning);
}
.failure-reason {
  overflow-wrap: anywhere;
  margin-top: 12px;
  padding: 12px 14px;
  border-radius: 14px;
  font-size: 13px;
  line-height: 1.6;
  color: #ff8a94;
  background: #ff5c6c14;
}
.waiting-note {
  margin-top: 16px;
  color: var(--ui-muted);
  font-size: 13px;
  line-height: 1.7;
}
.stage-note + .waiting-note {
  margin-top: 8px;
}
.continue-create {
  display: block;
  margin-top: 8px;
  padding: 6px 0;
  color: var(--ui-text);
}
.result {
  position: relative;
  margin-top: 20px;
  border-radius: 20px;
  overflow: hidden;
  background: var(--ui-field);
}
.result image,
.result video {
  width: 100%;
}
.result video {
  height: 60vh;
  max-height: 520px;
}
/* Result actions: four round icons under the work, no stacked buttons. */
.result-actions {
  display: flex;
  justify-content: space-around;
  margin: 18px 0 8px;
}
.act {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  min-width: 64px;
  font-size: 12px;
  color: var(--ui-muted);
}
.act-pressed {
  opacity: 0.6;
}
.act-icon {
  width: 52px;
  height: 52px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: var(--ui-text);
  background: var(--ui-surface);
}
.act-icon.primary {
  color: var(--ui-on-brand);
  background: var(--ui-primary);
}
.act-icon.danger {
  color: #ff8a94;
}
.failed-actions {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-top: 16px;
}
button.retry-pill {
  width: auto;
  height: 44px;
  margin: 0;
  padding: 0 22px;
  display: flex;
  align-items: center;
  gap: 6px;
  border-radius: 999px;
  font-size: 15px;
  font-weight: 600;
  color: var(--ui-on-brand);
  background: var(--ui-primary);
}
button.retry-pill::after {
  border: 0;
}
.edit-link {
  font-size: 14px;
  color: var(--ui-text);
}
.stage-note {
  margin-top: 8px;
  color: var(--ui-muted);
  font-size: 13px;
  line-height: 1.7;
}
.billing-summary {
  display: block;
  margin-top: 8px;
}
.task-balance {
  margin-top: 8px;
}
.task-detail-page .section-title {
  font-size: 13px;
  font-weight: 400;
  color: var(--ui-muted);
  margin: 24px 0 10px;
}
.task-detail-page .section-title .small {
  font-size: 12px;
}
.full-prompt {
  word-break: break-all;
  display: block;
  font-size: 15px;
  line-height: 1.65;
  color: var(--ui-muted);
  white-space: pre-wrap;
}
.asset-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
}
.asset-row {
  min-width: 0;
}
.asset-row image,
.asset-file {
  width: 100%;
  height: 96px;
  border-radius: 6px;
}
.asset-file {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--ui-field);
}
.asset-row > text {
  display: block;
  font-size: 13px;
  color: var(--ui-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-top: 8px;
}
.asset-row > text.tiny {
  font-size: 12px;
  color: var(--ui-muted);
  margin-top: 3px;
}
.specs {
  overflow-wrap: anywhere;
  font-size: 13px;
  line-height: 1.8;
  color: var(--ui-muted);
  border-top: 1px solid var(--ui-border);
  padding-top: 16px;
  margin-top: 24px;
}
.task-detail-page .note {
  font-size: 13px;
}

/* Queued / running: a tall cyan-washed stage with a sheen and a progress bar,
   holding the place the finished work will take. */
.live-stage {
  position: relative;
  height: 44vh;
  max-height: 380px;
  margin-top: 20px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;
  border-radius: 20px;
  background: linear-gradient(160deg, #00c8dc29, #6c63ff1f 55%, var(--ui-surface));
}
.live-stage::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(110deg, transparent 30%, #ffffff12 50%, transparent 70%);
  transform: translateX(-100%);
  animation: live-sheen 2.4s ease-in-out infinite;
}
@keyframes live-sheen {
  to { transform: translateX(100%); }
}
@media (prefers-reduced-motion: reduce) {
  .live-stage::after { animation: none; }
}
.live-ring {
  color: var(--ui-brand);
}
.live-title {
  font-size: 16px;
  font-weight: 600;
}
.live-bar {
  width: 56%;
  height: 4px;
  overflow: hidden;
  border-radius: 2px;
  background: #ffffff1f;
}
.live-bar view {
  height: 100%;
  border-radius: 2px;
  background: var(--ui-brand);
  transition: width 400ms ease;
}
.live-stage .stage-note {
  margin: 0;
}
