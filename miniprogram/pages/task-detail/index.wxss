.task-detail-page {
  padding: 24px 20px calc(30px + env(safe-area-inset-bottom));
}
.task-heading {
  word-break: break-all;
  display: block;
  font-size: 20px;
  font-weight: 600;
  line-height: 1.4;
  margin: 0 0 12px;
  color: var(--ui-text);
}
.task-state {
  flex-wrap: wrap;
  font-size: 13px;
  color: var(--ui-muted);
  gap: 8px;
}
.state-label {
  min-width: 0;
  flex-wrap: wrap;
  display: flex;
  align-items: center;
  gap: 10px;
}
.task-state .small {
  font-size: 12px;
}
.task-state.failed .state-label {
  color: var(--ui-danger);
}
.task-state.running .state-label {
  color: var(--ui-info);
  --td-loading-color: var(--ui-info);
}
.task-state.succeeded .state-label {
  color: var(--ui-success);
}
.task-state.queued .state-label {
  color: var(--ui-warning);
}
.failure-reason {
  overflow-wrap: anywhere;
  font-size: 13px;
  color: var(--ui-muted);
  line-height: 1.5;
  margin-top: 12px;
}
.waiting-note {
  margin-top: 16px;
  color: var(--ui-muted);
  font-size: 13px;
  line-height: 1.7;
}
.stage-note + .waiting-note {
  margin-top: 8px;
}
.continue-create {
  display: block;
  margin-top: 8px;
  padding: 6px 0;
  color: var(--ui-text);
}
.result {
  position: relative;
  margin-top: 24px;
  border-radius: 12px;
  overflow: hidden;
  background: var(--ui-field);
}
.result image,
.result video {
  width: 100%;
}
.result video {
  height: 320px;
}
.task-detail-page .foot-actions {
  gap: 10px;
  margin: 12px 0 0;
}
.danger-link {
  display: block;
  margin: 32px auto 0;
  color: var(--ui-danger);
}
.result-actions {
  margin-top: 10px;
}
.stage-note {
  margin-top: 8px;
  color: var(--ui-muted);
  font-size: 13px;
  line-height: 1.7;
}
.billing-summary {
  display: block;
  margin-top: 8px;
}
.task-balance {
  margin-top: 8px;
}
.task-detail-page .section-title {
  font-size: 13px;
  font-weight: 400;
  color: var(--ui-muted);
  margin: 24px 0 10px;
}
.task-detail-page .section-title .small {
  font-size: 12px;
}
.full-prompt {
  word-break: break-all;
  display: block;
  font-size: 15px;
  line-height: 1.65;
  color: var(--ui-muted);
  white-space: pre-wrap;
}
.asset-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
}
.asset-row {
  min-width: 0;
}
.asset-row image,
.asset-file {
  width: 100%;
  height: 96px;
  border-radius: 6px;
}
.asset-file {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--ui-field);
}
.asset-row > text {
  display: block;
  font-size: 13px;
  color: var(--ui-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-top: 8px;
}
.asset-row > text.tiny {
  font-size: 12px;
  color: var(--ui-muted);
  margin-top: 3px;
}
.specs {
  overflow-wrap: anywhere;
  font-size: 13px;
  line-height: 1.8;
  color: var(--ui-muted);
  border-top: 1px solid var(--ui-border);
  padding-top: 16px;
  margin-top: 24px;
}
.task-detail-page .note {
  font-size: 13px;
}
