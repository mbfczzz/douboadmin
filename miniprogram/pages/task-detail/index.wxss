.task-detail-page {
  padding: 24px 20px calc(30px + env(safe-area-inset-bottom));
  --td-button-border-radius: 22px;
}
.task-heading {
  word-break: break-all;
  display: block;
  font-size: 23px;
  font-weight: 500;
  line-height: 1.4;
  margin: 0 0 12px;
  color: #ffffff;
}
.task-state {
  flex-wrap: wrap;
  font-size: 13px;
  color: #8b9aab;
  gap: 8px;
}
.state-label {
  min-width: 0;
  flex-wrap: wrap;
  display: flex;
  align-items: center;
  gap: 10px;
}
.task-state .small {
  font-size: 12px;
}
.task-state t-icon {
  color: #ffffffb3;
}
.task-state.failed t-icon {
  color: #ff3355;
}
.failure-reason {
  overflow-wrap: anywhere;
  font-size: 14px;
  color: #a9b6c4;
  line-height: 1.5;
  margin-top: 12px;
}
.waiting-note {
  margin-top: 16px;
  color: var(--ui-muted);
  font-size: 13px;
  line-height: 1.7;
}
.stage-note + .waiting-note {
  margin-top: 8px;
}
.continue-create {
  display: block;
  margin-top: 8px;
  padding: 6px 0;
  color: #ffffff;
}
.result {
  position: relative;
  margin-top: 24px;
  border-radius: 12px;
  overflow: hidden;
  background: #02070d;
}
.result image,
.result video {
  width: 100%;
}
.result video {
  height: 320px;
}
.task-detail-page .foot-actions {
  gap: 10px;
  margin: 12px 0 0;
}
.result-actions .danger-link {
  color: #ff3355;
}
.result-actions {
  margin-top: 8px;
}
.stage-note {
  margin-top: 8px;
  color: var(--ui-muted);
  font-size: 12px;
  line-height: 1.7;
}
.billing-summary {
  display: block;
  margin-top: 8px;
}
.task-balance {
  margin-top: 24px;
}
.task-detail-page .section-title {
  font-size: 12px;
  font-weight: 400;
  color: #8b9aab;
  margin: 24px 0 10px;
}
.task-detail-page .section-title .small {
  font-size: 11px;
}
.full-prompt {
  word-break: break-all;
  display: block;
  font-size: 15px;
  line-height: 1.65;
  color: #a9b6c4;
  white-space: pre-wrap;
}
.asset-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
}
.asset-row {
  min-width: 0;
}
.asset-row image,
.asset-file {
  width: 100%;
  height: 96px;
  border-radius: 5px;
}
.asset-file {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #13283d;
}
.asset-row > text {
  display: block;
  font-size: 12px;
  color: #a9b6c4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-top: 8px;
}
.asset-row > text.tiny {
  font-size: 11px;
  color: #8b9aab;
  margin-top: 3px;
}
.specs {
  overflow-wrap: anywhere;
  font-size: 12px;
  line-height: 1.8;
  color: #8b9aab;
  border-top: 1px solid #ffffff0f;
  padding-top: 16px;
  margin-top: 24px;
}
.task-detail-page .note {
  font-size: 12px;
}
