/* Prompt card: over 100 characters it folds to five lines. */
.prompt-card {
  margin-top: 24px;
  padding: 14px 16px 12px;
  border-radius: 16px;
  background: var(--ui-surface);
}
.prompt-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8px;
  font-size: 13px;
  color: var(--ui-muted);
}
.prompt-size {
  font-size: 12px;
}
.prompt-copy {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 4px 0 4px 10px;
  font-size: 12px;
  color: var(--ui-muted);
}
.full-prompt {
  word-break: break-all;
  display: block;
  font-size: 15px;
  line-height: 1.65;
  color: var(--ui-text);
  white-space: pre-wrap;
}
.full-prompt.folded {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 5;
  overflow: hidden;
  -webkit-mask-image: linear-gradient(#000 60%, transparent);
  mask-image: linear-gradient(#000 60%, transparent);
}
.prompt-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
  margin-top: 6px;
  padding: 6px 0 2px;
  font-size: 13px;
  color: var(--ui-link);
}
.prompt-more .gl {
  transform: rotate(135deg);
}
.prompt-more .gl.up {
  transform: rotate(-45deg);
}
/* Template jobs: the template stands in for its private prompt. */
.template-go {
  font-size: 12px;
  color: var(--ui-link);
}
.template-name {
  display: block;
  font-size: 16px;
  font-weight: 600;
  line-height: 1.5;
  color: var(--ui-text);
}
.template-note {
  display: block;
  margin-top: 4px;
  font-size: 12px;
  color: var(--ui-muted);
}
