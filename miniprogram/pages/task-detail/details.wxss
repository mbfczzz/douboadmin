/* 参考素材 and 生成信息 as cards in the prompt card's style. */
.detail-card {
  margin-top: 12px;
  padding: 14px 16px;
  border-radius: 16px;
  background: var(--ui-surface);
}
.detail-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12px;
  font-size: 13px;
  color: var(--ui-muted);
}
.detail-empty {
  font-size: 13px;
  color: var(--ui-muted);
}
.asset-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10px;
}
.asset-row {
  position: relative;
  min-width: 0;
}
/* Only the tile's picture fills it; icons inside keep their glyph size. */
.asset-thumb,
.asset-video,
.asset-file {
  display: block;
  width: 100%;
  height: 76px;
  border-radius: 12px;
}
.asset-file {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--ui-field);
}
/* A video shows its first frame with a play mark. */
.asset-video {
  position: relative;
  overflow: hidden;
  background: var(--ui-field);
}
.asset-play {
  position: absolute;
  top: 50%;
  left: 50%;
  margin: -14px 0 0 -14px;
  padding: 4px;
  border-radius: 50%;
  background: #00000080;
}
/* The 图片N label sits on the tile, matching @图片N in prompts. */
.asset-row > text {
  position: absolute;
  left: 4px;
  bottom: 4px;
  padding: 0 6px;
  border-radius: 999px;
  font-size: 10px;
  line-height: 16px;
  color: #fff;
  background: #00000080;
}
/* 生成信息: label on the left, value on the right. */
.spec-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16px;
  padding: 7px 0;
  font-size: 13px;
  color: var(--ui-muted);
}
.spec-value {
  min-width: 0;
  text-align: right;
  overflow-wrap: anywhere;
  color: var(--ui-text);
}
.spec-state {
  margin-left: 8px;
  padding: 1px 8px;
  border-radius: 999px;
  font-size: 11px;
  color: var(--ui-muted);
  background: var(--ui-field);
}
.spec-state.released {
  color: var(--ui-success);
  background: var(--ui-success-bg);
}
