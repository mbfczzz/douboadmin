<nav-bar title="任务详情" back />
<view class="subpage task-detail-page page-motion {{pageMotion}}">
  <view class="loading" wx:if="{{loading}}"><t-loading /></view>
  <view wx:elif="{{needsLogin}}" class="empty">
    <text class="title">登录后查看这份作品</text>
    <t-button theme="primary" loading="{{signingIn}}" bind:tap="signIn"
      >去登录</t-button
    >
  </view>
  <view wx:elif="{{loadError&&!job}}" class="error-box">
    {{loadError}}
    <text bindtap="load">· 重试</text>
  </view>
  <view wx:elif="{{job}}" class="content-reveal">
    <view wx:if="{{loadError}}" class="error-box" bindtap="load"
      >刷新失败，已保留上次结果 · 点击重试</view
    >
    <text class="task-heading">{{job.shortTitle}}</text>
    <view class="row task-state {{job.status}}">
      <view class="state-label">
        <t-loading wx:if="{{job.status==='running'}}" size="15px" />
        <t-icon
          wx:else
          name="{{job.status==='queued'?'time':job.status==='failed'?'error-circle':'check-circle'}}"
          size="15"
        />
        <text>{{job.kindText}}{{job.stateText}}</text>
      </view>
      <text class="small muted">{{job.time}} 提交</text>
    </view>
    <view wx:if="{{job.stage&&(job.status==='running'||job.status==='queued')}}" class="stage-note">{{job.stage}} · {{job.progress}}%</view>
    <view
      wx:if="{{job.status==='queued'||job.status==='running'}}"
      class="waiting-note"
    >
      <text>可以先离开，完成后到「我的作品」查看。</text>
      <view class="continue-create" bindtap="continueCreate">继续创作 ›</view>
    </view>
    <view wx:if="{{job.status==='failed'}}" class="failure-reason"
      >{{job.error}}</view
    >
    <view wx:if="{{job.deleted}}" class="error-box"
      >作品已删除，历史任务与积分记录保留。</view
    >
    <view
      wx:if="{{job.status==='succeeded'&&!job.deleted}}"
      class="result content-reveal"
    >
      <image
        wx:if="{{job.input.kind==='image'}}"
        src="{{job.result}}"
        mode="widthFix"
        bindtap="preview"
      />
      <video
        wx:else
        src="{{job.result}}"
        controls
        autoplay="{{autoplay}}"
        show-center-play-btn
        object-fit="contain"
      />
    </view>
    <view
      class="foot-actions"
      wx:if="{{!job.deleted&&(job.status==='failed'||job.status==='succeeded')}}"
    >
      <view>
        <t-button block variant="outline" bind:tap="edit">重新编辑</t-button>
      </view>
      <view wx:if="{{job.retryable||job.status==='succeeded'}}">
        <t-button
          wx:if="{{job.status==='failed'&&job.retryable}}"
          block
          theme="primary"
          loading="{{busy}}"
          bind:tap="retry"
        >
          重试
        </t-button>
        <t-button
          wx:elif="{{job.status==='succeeded'}}"
          block
          theme="primary"
          loading="{{busy}}"
          bind:tap="save"
        >
          保存{{job.kindText==='图片'?'图片':'视频'}}
        </t-button>
      </view>
    </view>
    <view wx:if="{{job.status==='succeeded'&&!job.deleted}}" class="row result-actions"
      ><button class="text-button" bindtap="share">
        {{job.reviewStatus==='approved'?'分享作品':'待审核后分享'}}</button
      ><button class="text-button" bindtap="remove">删除作品</button></view
    >
    <text class="section-title">提示词</text>
    <text class="full-prompt" selectable>{{job.input.prompt}}</text>
    <view class="row section-title">
      <text>参考文件</text>
      <text class="muted small">{{job.input.assets.length}} 个附件</text>
    </view>
    <view wx:if="{{loadingAssets}}" class="muted small">正在加载参考素材…</view>
    <view wx:elif="{{assetError}}" class="error-box" bindtap="loadAssets"
      >{{assetError}}</view
    >
    <view wx:elif="{{!assets.length}}" class="muted small">未添加参考素材</view>
    <view class="asset-grid">
      <view class="asset-row" wx:for="{{assets}}" wx:key="id">
        <image
          wx:if="{{item.isImage}}"
          src="{{item.data.url}}"
          mode="aspectFill"
        />
        <view wx:else class="asset-file"><t-icon name="file" size="24" /></view>
        <text>{{item.data.name}}</text>
        <text class="muted tiny">{{item.isImage?'图片':'文件'}}</text>
      </view>
    </view>
    <view class="specs">
      {{job.modelName}} · {{job.input.resolution}} · {{job.input.ratio}}
      <text wx:if="{{job.input.duration}}">· {{job.input.duration}}秒</text>
      <text wx:if="{{job.costUnits}}" class="billing-summary">本次积分 {{job.costUnits/100}} · {{job.billingState==='reserved'?'已预留':job.billingState==='charged'?'已扣除':job.billingState==='released'?'已退回':''}}</text>
    </view>
    <view class="task-balance"><points-balance /></view>
  </view>
</view>
