<nav-bar title="任务详情" back />
<view class="subpage task-detail-page">
  <view class="loading" wx:if="{{loading}}"><t-loading /></view>
  <view wx:elif="{{needsLogin}}" class="empty">
    <image class="empty-photo" src="/assets/photos/empty-login.jpg" mode="aspectFill" aria-hidden="true" />
    <text class="title">登录后查看这份作品</text>
    <text class="empty-link" bindtap="signIn">{{signingIn?'正在登录…':'去登录 ›'}}</text>
  </view>
  <view wx:elif="{{loadError&&!job}}" class="error-box" bindtap="load">
    {{loadError}}
    <text>· 重试</text>
  </view>
  <view wx:elif="{{job}}" class="content-reveal">
    <view wx:if="{{loadError}}" class="error-box" bindtap="load"
      >刷新失败，已保留上次结果 · 点击重试</view
    >
    <text class="task-heading">{{job.shortTitle}}</text>
    <view class="row task-state {{job.status}}">
      <view class="state-label">
        <t-loading wx:if="{{job.status==='running'}}" size="16px" />
        <t-icon
          wx:else
          name="{{job.status==='queued'?'time':job.status==='failed'?'error-circle':'check-circle'}}"
          size="16"
        />
        <text>{{job.kindText}}{{job.stateText}}</text>
      </view>
      <text class="small muted">{{job.time}} 提交</text>
    </view>
    <view wx:if="{{job.status==='running'||job.status==='queued'}}" class="live-stage {{job.status}}">
      <view class="live-ring"><t-loading size="28px" /></view>
      <text class="live-title">{{job.status==='queued'?'排队中，马上开始':'正在生成'+job.kindText}}</text>
      <view wx:if="{{job.status==='running'&&job.progress}}" class="live-bar"><view style="width:{{job.progress}}%" /></view>
      <text wx:if="{{job.stage}}" class="stage-note">{{job.stage}} · {{job.progress}}%</text>
    </view>
    <view
      wx:if="{{job.status==='queued'||job.status==='running'}}"
      class="waiting-note"
    >
      <text>可以先离开，完成后到「我的作品」查看。</text>
      <view class="continue-create" bindtap="continueCreate">继续创作 ›</view>
    </view>
    <view wx:if="{{job.status==='failed'}}" class="failure-reason"
      >{{job.error}}</view
    >
    <view wx:if="{{job.deleted}}" class="error-box"
      >作品已删除，历史任务与积分记录保留。</view
    >
    <view
      wx:if="{{job.status==='succeeded'&&!job.deleted}}"
      class="result content-reveal"
    >
      <image
        wx:if="{{job.input.kind==='image'}}"
        src="{{job.result}}"
        mode="widthFix"
        bindtap="preview"
      />
      <video
        wx:else
        src="{{job.result}}"
        controls
        autoplay="{{autoplay}}"
        show-center-play-btn
        object-fit="contain"
      />
    </view>
    <view wx:if="{{job.status==='succeeded'&&!job.deleted}}" class="result-actions">
      <view class="act" bindtap="save" hover-class="act-pressed" aria-role="button"><view class="act-icon primary"><t-loading wx:if="{{busy}}" size="20px" /><image wx:else class="gl gl-22" src="/assets/glyphs/download-dark.png" /></view><text>保存</text></view>
      <view class="act" bindtap="share" hover-class="act-pressed" aria-role="button"><view class="act-icon"><image class="gl gl-22" src="/assets/glyphs/share.png" /></view><text>分享</text></view>
      <view class="act" bindtap="edit" hover-class="act-pressed" aria-role="button"><view class="act-icon"><image class="gl gl-22" src="/assets/glyphs/edit.png" /></view><text>再编辑</text></view>
      <view class="act" bindtap="remove" hover-class="act-pressed" aria-role="button"><view class="act-icon"><image class="gl gl-22" src="/assets/glyphs/delete-danger.png" /></view><text>删除</text></view>
    </view>
    <view wx:elif="{{job.status==='failed'&&!job.deleted}}" class="failed-actions">
      <button wx:if="{{job.retryable}}" class="retry-pill" loading="{{busy}}" disabled="{{busy}}" bindtap="retry"><image wx:if="{{!busy}}" class="gl gl-18" src="/assets/glyphs/refresh-dark.png" />重新生成</button>
      <text class="edit-link" bindtap="edit">修改后再试 ›</text>
    </view>
    <text class="section-title">提示词</text>
    <text class="full-prompt" selectable>{{job.input.prompt}}</text>
    <view class="row section-title">
      <text>参考文件</text>
      <text wx:if="{{job.input.assets.length}}" class="muted small">{{job.input.assets.length}} 个附件</text>
    </view>
    <view wx:if="{{loadingAssets}}" class="muted small">正在加载参考素材…</view>
    <view wx:elif="{{assetError}}" class="error-box" bindtap="loadAssets"
      >{{assetError}}</view
    >
    <view wx:elif="{{!assets.length}}" class="muted small">未添加参考素材</view>
    <view class="asset-grid">
      <view class="asset-row" wx:for="{{assets}}" wx:key="id">
        <image
          wx:if="{{item.isImage}}"
          src="{{item.data.url}}"
          mode="aspectFill"
        />
        <view wx:else class="asset-file"><image class="gl gl-24" src="/assets/glyphs/file-muted.png" /></view>
        <text>{{item.data.name}}</text>
        <text class="muted tiny">{{item.isImage?'图片':'文件'}}</text>
      </view>
    </view>
    <view class="specs">
      {{job.modelName}} · {{job.input.resolution}} · {{job.input.ratio}}
      <text wx:if="{{job.input.duration}}">· {{job.input.duration}}秒</text>
      <text wx:if="{{job.costUnits}}" class="billing-summary">本次积分 {{job.costUnits/100}} · {{job.billingState==='reserved'?'已预留':job.billingState==='charged'?'已扣除':job.billingState==='released'?'已退回':''}}</text>
    </view>
    <view class="task-balance"><points-balance compact /></view>
  </view>
</view>
<ui-dialog id="ui-dialog" />
