<wxs module="chips" src="../../utils/mentions.wxs" />
<nav-bar title="任务详情" back />
<view class="subpage task-detail-page">
  <page-loading wx:if="{{loading}}" show text="正在读取作品…" />
  <view wx:elif="{{needsLogin}}" class="empty">
    <image class="empty-photo" src="/assets/photos/empty-login.jpg" mode="aspectFill" aria-hidden="true" />
    <text class="title">登录后查看这份作品</text>
    <text class="empty-link" bindtap="signIn">{{signingIn?'正在登录…':'去登录 ›'}}</text>
  </view>
  <view wx:elif="{{loadError&&!job}}" class="error-box" bindtap="load">
    {{loadError}}
    <text>· 重试</text>
  </view>
  <view wx:elif="{{job}}" class="content-reveal">
    <view wx:if="{{loadError}}" class="error-box" bindtap="load"
      >刷新失败，已保留上次结果 · 点击重试</view
    >
    <text class="task-heading">{{job.shortTitle}}</text>
    <view class="row task-state {{job.status}}">
      <view class="state-label">
        <t-loading wx:if="{{job.status==='running'}}" size="16px" />
        <t-icon
          wx:else
          name="{{job.status==='queued'?'time':job.status==='failed'?'error-circle':'check-circle'}}"
          size="16"
        />
        <text>{{job.kindText}}{{job.stateText}}</text>
      </view>
      <text class="small muted">{{job.time}} 提交</text>
    </view>
    <view wx:if="{{job.status==='running'||job.status==='queued'}}" class="live-stage {{job.status}}">
      <view class="live-ring"><t-loading size="28px" /></view>
      <text class="live-title">{{job.status==='queued'?'排队中，马上开始':job.input.purpose==='remake'?'正在准备一键复刻':'正在生成'+job.kindText}}</text>
      <view wx:if="{{job.status==='running'&&job.progress}}" class="live-bar"><view style="width:{{job.progress}}%" /></view>
      <text wx:if="{{job.stage}}" class="stage-note">{{job.stage}} · {{job.progress}}%</text>
    </view>
    <view
      wx:if="{{job.status==='queued'||job.status==='running'}}"
      class="waiting-note"
    >
      <text>{{job.input.purpose==='remake'?'可以先离开，准备好后在任务队列里打开，点「生成同款」。':'可以先离开，完成后到「我的作品」查看。'}}</text>
      <view class="continue-create" bindtap="continueCreate">继续创作 ›</view>
    </view>
    <view wx:if="{{job.status==='failed'}}" class="failure-reason">
      <text>{{job.error}}</text>
      <view wx:if="{{job.errorAction}}" class="muted small">{{job.errorAction}}</view>
    </view>
    <view wx:if="{{job.deleted}}" class="error-box"
      >作品已删除，历史任务与积分记录保留。</view
    >
    <view
      wx:if="{{job.status==='succeeded'&&!job.deleted}}"
      class="result content-reveal"
    >
      <result-gallery
        wx:if="{{job.input.kind==='image'}}"
        images="{{job.results}}"
        allow-save
        busy="{{busy}}"
        bind:preview="preview"
        bind:save="save"
      />
      <video
        wx:else
        src="{{job.result}}"
        controls
        autoplay="{{autoplay}}"
        show-center-play-btn
        object-fit="contain"
      />
    </view>
    <view wx:if="{{job.status==='succeeded'&&!job.deleted&&job.input.purpose==='remake'&&swaps.length}}" class="swap-list">
      <text class="swap-title">用你的图片替换</text>
      <view wx:for="{{swaps}}" wx:for-item="row" wx:for-index="i" wx:key="name" class="swap-row">
        <view class="swap-copy"><text class="swap-name">{{row.name}}</text><text class="swap-look">{{row.look}}{{row.when?' · '+row.when:''}}</text></view>
        <view class="swap-picks">
          <block wx:for="{{assets}}" wx:for-item="pic" wx:key="id"><view wx:if="{{pic.isImage}}" class="swap-pick {{row.pick===pic.id?'on':''}}" data-index="{{i}}" data-id="{{pic.id}}" bindtap="pickSwap" aria-role="button" aria-label="{{'用'+pic.label+'替换'+row.name}}"><image src="{{pic.data.url}}" mode="aspectFill" /></view></block>
          <view class="swap-keep {{row.pick?'':'on'}}" data-index="{{i}}" data-id="" bindtap="pickSwap" aria-role="button" aria-label="{{row.name+'保持原样'}}">原样</view>
        </view>
      </view>
    </view>
    <view wx:if="{{job.status==='succeeded'&&!job.deleted&&job.input.purpose==='remake'}}" class="remake-ready">
      <view class="remake-copy">
        <text>原视频已拆解，确认积分后直接生成同款</text>
        <text class="remake-edit" bindtap="editRemake">调整后再生成 ›</text>
      </view>
      <button class="retry-pill remake-go" loading="{{busy}}" disabled="{{busy}}" bindtap="generateRemake">生成同款</button>
    </view>
    <view wx:elif="{{job.status==='succeeded'&&!job.deleted}}" class="result-actions">
      <view class="act" bindtap="save" hover-class="act-pressed" aria-role="button"><view class="act-icon primary"><t-loading wx:if="{{busy}}" size="20px" /><image wx:else class="gl gl-22" src="/assets/glyphs/download-dark.png" /></view><text>{{job.results.length>1?'保存全部':'保存'}}</text></view>
      <view class="act" bindtap="share" hover-class="act-pressed" aria-role="button"><view class="act-icon"><image class="gl gl-22" src="/assets/glyphs/share.png" /></view><text>分享</text></view>
      <view class="act" bindtap="edit" hover-class="act-pressed" aria-role="button"><view class="act-icon"><image class="gl gl-22" src="/assets/glyphs/edit.png" /></view><text>再编辑</text></view>
      <view class="act" bindtap="remove" hover-class="act-pressed" aria-role="button"><view class="act-icon"><image class="gl gl-22" src="/assets/glyphs/delete-danger.png" /></view><text>删除</text></view>
    </view>
    <view wx:elif="{{job.status==='failed'&&!job.deleted}}" class="failed-actions">
      <button wx:if="{{job.input.purpose==='remake'}}" class="retry-pill" bindtap="remakeAgain"><image class="gl gl-18" src="/assets/glyphs/refresh-dark.png" />重新复刻</button>
      <button wx:elif="{{job.retryable}}" class="retry-pill" loading="{{busy}}" disabled="{{busy}}" bindtap="retry"><image wx:if="{{!busy}}" class="gl gl-18" src="/assets/glyphs/refresh-dark.png" />重新生成</button>
      <text wx:if="{{job.editable&&job.input.kind!=='import'}}" class="edit-link" bindtap="edit">修改后再试 ›</text>
    </view>
    <view wx:if="{{!job.input.prompt&&job.input.templateId}}" class="prompt-card template-card" bindtap="openTemplate" hover-class="card-pressed" aria-role="button" aria-label="{{'查看模板 '+(job.templateTitle||'')}}">
      <view class="prompt-head"><text>创作模板</text><text class="template-go">查看模板 ›</text></view>
      <text class="template-name">{{job.templateTitle||'模板创作'}}</text>
      <text class="template-note">提示词由模板提供</text>
    </view>
    <view wx:else class="prompt-card">
      <view class="prompt-head">
        <text>{{job.input.purpose==='remake'?'原视频':'提示词'}}<text wx:if="{{job.input.prompt}}" class="prompt-size"> · {{job.input.prompt.length}} 字</text></text>
        <view wx:if="{{job.input.prompt}}" class="prompt-copy" bindtap="copyPrompt" hover-class="act-pressed" aria-role="button" aria-label="复制提示词"><image class="gl gl-14" src="/assets/glyphs/copy-muted.png" /><text>复制</text></view>
      </view>
      <view class="full-prompt {{job.input.prompt.length>100&&!promptOpen?'folded':''}}"
        ><block wx:for="{{chips.segments(job.input.prompt||'未填写提示词',assets)}}" wx:key="index"><text wx:if="{{!item.chip}}" selectable>{{item.text}}</text><view wx:else class="prompt-chip" data-id="{{item.id}}" bindtap="previewChip" aria-role="button" aria-label="{{'查看'+item.label}}"><image wx:if="{{item.url}}" src="{{item.url}}" mode="aspectFill" /><text>{{item.label}}</text></view></block></view>
      <view wx:if="{{job.input.prompt.length>100}}" class="prompt-more" bindtap="togglePrompt" aria-role="button">{{promptOpen?'收起':'展开全文'}}<image class="gl gl-14 {{promptOpen?'up':''}}" src="/assets/glyphs/open-muted.png" /></view>
    </view>
    <view class="detail-card">
      <view class="detail-head">
        <text>参考素材</text>
        <text wx:if="{{job.input.assets.length}}">{{job.input.assets.length}} 个</text>
      </view>
      <view wx:if="{{loadingAssets}}" class="detail-empty">正在加载参考素材…</view>
      <view wx:elif="{{assetError}}" class="error-box" bindtap="loadAssets">{{assetError}}</view>
      <view wx:elif="{{!assets.length}}" class="detail-empty">未添加参考素材</view>
      <view class="asset-grid">
        <view class="asset-row" wx:for="{{assets}}" wx:key="id" data-url="{{item.data.url}}" bindtap="previewAsset" aria-role="button" aria-label="{{item.label}}">
          <image wx:if="{{item.isImage}}" src="{{item.data.url}}" mode="aspectFill" lazy-load />
          <view wx:else class="asset-file"><image class="gl gl-24" src="/assets/glyphs/{{item.kind==='video'?'video-muted':'file-muted'}}.png" /></view>
          <text>{{item.label}}</text>
        </view>
      </view>
    </view>
    <view wx:if="{{job.input.kind!=='import'}}" class="detail-card specs">
      <view wx:if="{{job.modelName&&job.input.kind!=='import'}}" class="spec-row"><text>模型</text><text class="spec-value">{{job.modelName}}</text></view>
      <view wx:if="{{job.input.resolution||job.input.ratio||job.input.duration}}" class="spec-row"><text>规格</text><text class="spec-value">{{job.input.resolution||''}}{{job.input.resolution&&job.input.ratio?' · ':''}}{{job.input.ratio||''}}{{(job.input.resolution||job.input.ratio)&&job.input.duration?' · ':''}}{{job.input.duration?job.input.duration+' 秒':''}}</text></view>
      <view wx:if="{{job.costUnits}}" class="spec-row billing-summary"><text>积分</text><text class="spec-value">{{job.costUnits/100}}<text wx:if="{{job.billingState==='reserved'||job.billingState==='charged'||job.billingState==='released'}}" class="spec-state {{job.billingState}}">{{job.billingState==='released'?'已退回':'已扣除'}}</text></text></view>
    </view>
    <view class="task-balance"><points-balance compact /></view>
  </view>
</view>
<ui-dialog id="ui-dialog" />
