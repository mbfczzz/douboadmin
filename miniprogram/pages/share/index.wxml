<nav-bar title="分享作品" back /><view
  class="subpage"
  ><view wx:if="{{needsLogin}}" class="biz-empty"
    ><image class="empty-photo" src="/assets/photos/empty-login.jpg" mode="aspectFill" aria-hidden="true" /><text>登录后分享自己的作品</text><text class="empty-link" bindtap="signIn">去登录 ›</text></view
  ><view wx:if="{{loadError}}" class="biz-error">{{loadError}}</view
  ><page-loading show="{{!job&&!needsLogin&&!loadError}}" text="正在打开作品…"></page-loading
  ><block wx:if="{{job}}"
    ><view class="biz-card"
      ><result-gallery
        wx:if="{{job.input.kind==='image'}}"
        images="{{job.results}}"
        bind:preview="preview" /><video
        wx:else
        class="biz-preview share-preview"
        src="{{job.result}}"
        object-fit="contain"
        controls /></view
    ><view
      wx:if="{{job.deleted}}"
      class="biz-error"
      >作品已删除</view
    ><view wx:else class="biz-card"
      ><text class="biz-label">分享标题</text
      ><input
        class="biz-input"
        value="{{title}}"
        maxlength="60"
        bindinput="input"
      /><view class="biz-row"
        ><view class="share-option"><art-icon name="icScript" size="24" /><text>包含创作描述</text></view
        ><switch
          color="#00c8dc"
          checked="{{showPrompt}}"
          bindchange="prompt" /></view
      ><button
        wx:if="{{!share}}"
        class="biz-action"
        bindtap="prepare"
        loading="{{busy}}"
      >
        生成分享链接</button
      ><block wx:else
        ><button class="biz-action" open-type="share">发给微信好友</button
        ><view wx:if="{{share.publicDomainConfigured}}" class="copy-link" bindtap="copy"><image class="gl gl-16" src="/assets/glyphs/link.png" /><text>复制短链</text></view
        ><text class="biz-note"
          >{{share.publicDomainConfigured?'链接有效期 30 天，删除作品后失效。':'分享链接暂未开放，可以先保存作品后分享。'}}</text
        ></block
      ></view
    ></block
  ></view
>
