.photo-sources {
  padding: 20px 20px calc(32px + env(safe-area-inset-bottom));
}
.photo-source-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 18px;
  font-weight: 500;
  margin-bottom: 10px;
}
.photo-source-close {
  flex-shrink: 0;
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.photo-source {
  display: flex;
  align-items: center;
  gap: 14px;
  min-height: 52px;
  padding: 12px 4px;
  border-bottom: 1px solid #ffffff0f;
  font-size: 15px;
}
.photo-source text {
  flex: 1;
  min-width: 0;
  overflow-wrap: anywhere;
}
.photo-source t-icon {
  flex-shrink: 0;
  color: #b3b3b3;
}
.photo-source-note {
  display: block;
  font-size: 11px;
  color: #a6a6a6;
  margin-top: 20px;
}
