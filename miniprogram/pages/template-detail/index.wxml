<nav-bar title="模板详情" back />
<view class="subpage detail">
  <view wx:if="{{loading}}" aria-label="正在加载模板详情">
    <view class="hero skeleton" />
    <view class="skeleton skeleton-line" />
    <view class="skeleton skeleton-line short" />
    <view class="slot-row loading-row"><view class="slot skeleton" /><view class="slot skeleton" /></view>
  </view>
  <view wx:elif="{{loadError}}" class="empty">
    <view class="empty-icon"><t-icon name="{{loadError==='模板已下架'?'image-error':'wifi-off'}}" size="30" /></view>
    <text>{{loadError}}</text>
    <text wx:if="{{loadError!=='模板已下架'}}" class="empty-link" bindtap="load">重试</text>
  </view>
  <view wx:elif="{{template}}" class="content-reveal">
    <view class="hero">
      <video wx:if="{{template.data.preview}}" src="{{template.data.preview}}" poster="{{template.data.cover}}" controls="{{!autoplay}}" autoplay="{{autoplay}}" loop muted="{{autoplay}}" object-fit="cover" />
      <image wx:else src="{{template.data.cover}}" mode="aspectFill" bindtap="preview" />
      <view class="hero-shade" />
      <view class="hero-fav {{favorite?'on':''}}" catchtap="favorite" aria-role="button" aria-label="{{favorite?'取消收藏':'收藏'}}"><t-icon name="{{favorite?'heart-filled':'heart'}}" size="22" /></view>
      <view class="hero-meta">
        <view class="hero-chips">
          <text wx:if="{{template.data.category}}" class="chip">{{template.data.category}}</text>
          <text wx:if="{{template.data.duration}}" class="chip">{{template.data.duration}} 秒</text>
          <text wx:if="{{template.data.ratio}}" class="chip">{{template.data.ratio}}</text>
          <text wx:if="{{template.data.resolution}}" class="chip">{{template.data.resolution}}</text>
        </view>
        <text class="detail-title">{{template.data.title}}</text>
      </view>
    </view>
    <text wx:if="{{template.data.description}}" class="template-description">{{template.data.description}}</text>
    <view class="section-head">
      <text class="section-name">上传商品照片</text>
      <text class="section-count {{assets.length>=template.data.requiredImages?'done':''}}">{{template.data.requiredImages?(assets.length>=template.data.requiredImages?template.data.requiredImages:assets.length)+' / '+template.data.requiredImages:'选填'}}</text>
    </view>
    <text class="upload-description"><block wx:if="{{template.data.requiredImages}}">只需 {{template.data.requiredImages}} 张照片，即可制作同款视频</block><block wx:else>可以直接生成，也可以添加参考照片</block></text>
    <scroll-view scroll-x class="slots" enhanced show-scrollbar="{{false}}">
      <view class="slot-row">
        <view wx:for="{{assets}}" wx:key="id" class="slot uploaded">
          <image src="{{item.data.url}}" mode="aspectFill" />
          <text class="slot-tag">{{index>=template.data.requiredImages?'补充':'主体图'}}</text>
          <view class="slot-remove" data-id="{{item.id}}" catchtap="remove" aria-role="button" aria-label="删除这张照片"><t-icon name="close" size="14" /></view>
        </view>
        <view wx:if="{{assets.length<template.data.requiredImages}}" class="slot add required" bindtap="choose" hover-class="slot-pressed" aria-role="button" aria-label="上传商品主体图">
          <t-icon name="{{uploading?'time':'add'}}" size="26" /><text class="slot-name">商品主体图</text><text class="slot-hint">正面清晰</text>
        </view>
        <block wx:elif="{{!fixedCount}}">
          <view wx:for="{{optionalNames}}" wx:key="*this" class="slot add optional" bindtap="choose" hover-class="slot-pressed" aria-role="button" aria-label="{{'添加'+item}}">
            <t-icon name="add" size="20" /><text class="slot-name">{{item}}</text><text class="slot-hint">选填</text>
          </view>
        </block>
      </view>
    </scroll-view>
    <text class="format">JPG / PNG / WebP · 单张不超过 50 MB · 上传不扣费</text>
    <view class="more-head"><text class="section-name">更多同款灵感</text></view>
    <showcase mode="strip" />
    <view class="submit-bar {{assets.length>=template.data.requiredImages?'is-ready':''}}">
      <view class="submit-copy">
        <text class="submit-quote">{{quoteText||'正在估算积分'}}</text>
        <text class="submit-status">{{assets.length>=template.data.requiredImages?(template.data.requiredImages?'照片已就绪':'可以直接生成'):'还需 '+(template.data.requiredImages-assets.length)+' 张照片'}}</text>
      </view>
      <button class="submit-action {{assets.length>=template.data.requiredImages?'':'to-upload'}}" disabled="{{busy||uploading}}" loading="{{busy}}" bindtap="primary">{{assets.length>=template.data.requiredImages?'生成同款':'上传照片'}}</button>
    </view>
  </view>
</view>
<t-popup visible="{{sourceOpen}}" placement="bottom" bind:visible-change="closeSource">
  <view class="photo-sources">
    <view class="sheet-handle" />
    <view class="photo-source-heading">
      <text>上传商品照片</text>
      <view class="photo-source-close" bindtap="closeSource"><t-icon name="close" size="20" /></view>
    </view>
    <view class="source-grid">
      <view wx:for="{{sources}}" wx:key="label" class="source-tile" data-index="{{index}}" bindtap="chooseSource" hover-class="source-pressed">
        <view class="source-glyph glyph-{{item.tone}}"><t-icon name="{{item.icon}}" size="26" /></view>
        <text class="source-name">{{item.label}}</text>
        <text class="source-hint">{{item.hint}}</text>
      </view>
    </view>
    <text class="source-note">JPG / PNG / WebP · 单张不超过 50 MB</text>
  </view>
</t-popup>
<ui-dialog id="ui-dialog" />
