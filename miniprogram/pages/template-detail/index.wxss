@import "./photo-sources.wxss";
.detail {
  padding: 13px 20px calc(160px + env(safe-area-inset-bottom));
}
.hero {
  position: relative;
  height: 400px;
  border-radius: 12px;
  overflow: hidden;
}
.hero image {
  width: 100%;
  height: 100%;
}
.hero-preview {
  position: absolute;
  right: 12px;
  top: 12px;
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #0f0f11bb;
  color: #ffffff;
  border-radius: 10px;
}
.title-row {
  margin: 20px 0 0;
}
.detail-divider {
  height: 1px;
  margin: 15px 0 20px;
  background: var(--ui-field);
}
.detail-title {
  flex: 1;
  min-width: 0;
  overflow-wrap: anywhere;
  font-size: 20px;
  font-weight: 600;
  line-height: 1.4;
}
.favorite {
  position: relative;
  flex-shrink: 0;
  width: 28px;
  height: 28px;
}
.favorite::after {
  content: "";
  position: absolute;
  inset: -8px;
}
.upload-description {
  display: block;
  margin-top: 14px;
  color: var(--ui-muted);
  font-size: 15px;
  line-height: 1.4;
}
.upload-title {
  font-size: 16px;
  font-weight: 500;
}
.row .section-title {
  margin: 0;
}
.required-upload {
  margin-top: 16px;
  display: flex;
  position: relative;
  gap: 12px;
  padding: 16px;
  background: var(--ui-surface);
  border-radius: var(--ui-radius-card);
}
.upload-icon {
  width: 44px;
  height: 44px;
  background: var(--ui-field);
  color: var(--ui-muted);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
  flex-shrink: 0;
}
.required-upload > view:nth-child(2) {
  flex: 1;
  min-width: 0;
  overflow-wrap: anywhere;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.upload-text {
  max-width: 100%;
  width: 150px;
  height: 44px;
  line-height: 44px;
  text-align: center;
  color: var(--ui-on-brand);
  font-size: 15px;
  font-weight: 600;
  background: var(--ui-primary);
  border-radius: var(--ui-radius-pill);
  margin-top: 4px;
}
.upload-name {
  font-size: 15px;
  font-weight: 500;
}
.upload-hint {
  font-size: 13px;
  color: var(--ui-muted);
}
.format {
  display: block;
  font-size: 13px;
  color: var(--ui-muted);
  margin-top: 8px;
}
.optional-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
}
.optional-grid > view {
  display: flex;
  align-items: center;
  gap: 10px;
  min-height: 58px;
  padding: 12px 14px;
  background: var(--ui-surface);
  border-radius: 12px;
  font-size: 15px;
  color: var(--ui-muted);
}
.optional-grid text {
  flex: 1;
  min-width: 0;
  overflow-wrap: anywhere;
  line-height: 1.5;
}
@media (max-width: 360px) {
  .optional-grid {
    grid-template-columns: minmax(0, 1fr);
  }
}
.optional-grid t-icon {
  flex-shrink: 0;
}
.submit-area {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 80;
  /* Design: 14 / 20 / 24 / 20. */
  padding: 14px 20px calc(24px + env(safe-area-inset-bottom));
  border-top: 1px solid var(--ui-border);
  background: var(--ui-bg);
}
.submit-action {
  margin-top: 10px;
}
.submit-area .note {
  display: block;
  margin: 8px 0 0;
  font-size: 13px;
  line-height: 1.5;
}
.submit-caption {
  font-size: 13px;
  line-height: 18px;
  color: var(--ui-muted);
}
.submit-quote {
  flex-shrink: 0;
  color: var(--ui-text);
}
.is-ready .submit-status {
  color: var(--ui-text);
}
.uploaded {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px;
  background: var(--ui-surface);
  border-radius: 12px;
  margin-top: 12px;
}
.uploaded image {
  flex-shrink: 0;
  height: 55px;
  width: 55px;
  border-radius: 10px;
}
.uploaded-copy {
  flex: 1;
  min-width: 0;
}
.uploaded-copy > text {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin: 5px 0;
  font-size: 13px;
}
.delete {
  flex-shrink: 0;
  padding: 8px;
}
.hero video {
  width: 100%;
  height: 100%;
}
.template-description {
  display: block;
  color: var(--ui-muted);
  font-size: 13px;
  line-height: 1.7;
  margin: 8px 0 0;
}
