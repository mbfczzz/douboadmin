@import "./photo-sources.wxss";
@import "./slots.wxss";
.detail {
  padding: 4px 16px calc(112px + env(safe-area-inset-bottom));
}
/* Hero: the template itself, large, with its title and specs laid over
   a soft bottom shade. */
.hero {
  position: relative;
  height: 62vh;
  max-height: 520px;
  overflow: hidden;
  border-radius: 20px;
  background: var(--ui-surface);
}
.hero image,
.hero video {
  width: 100%;
  height: 100%;
}
/* The cover settles in with a slow push, like a film still. */
.hero image {
  animation: hero-settle 1.4s cubic-bezier(0.2, 0.7, 0.2, 1);
}
@keyframes hero-settle {
  from { transform: scale(1.06); }
}
@media (prefers-reduced-motion: reduce) {
  .hero image { animation: none; }
}
.hero-shade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 50%;
  pointer-events: none;
  background: linear-gradient(transparent, #000000b3);
}
.hero-fav {
  position: absolute;
  top: 12px;
  right: 12px;
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #fff;
  background: #00000059;
  -webkit-backdrop-filter: blur(10px);
  backdrop-filter: blur(10px);
  transition: transform 160ms ease;
}
.hero-fav.on {
  color: #ff5c7a;
  transform: scale(1.06);
}
.hero-meta {
  position: absolute;
  left: 16px;
  right: 16px;
  bottom: 16px;
  pointer-events: none;
}
.hero-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-bottom: 8px;
}
.chip {
  max-width: 100%;
  box-sizing: border-box;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 2px 8px;
  border-radius: 999px;
  font-size: 11px;
  line-height: 18px;
  color: #fff;
  background: #ffffff26;
}
.detail-title {
  display: block;
  font-size: 22px;
  font-weight: 700;
  line-height: 30px;
  color: #fff;
  overflow-wrap: anywhere;
  text-shadow: 0 1px 8px #00000066;
}
.template-description {
  display: block;
  margin-top: 14px;
  font-size: 14px;
  line-height: 1.6;
  color: var(--ui-muted);
}
.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 26px;
}
.section-name {
  font-size: 17px;
  font-weight: 600;
}
.section-count {
  font-size: 13px;
  color: var(--ui-muted);
  font-variant-numeric: tabular-nums;
}
.section-count.done {
  color: var(--ui-brand);
}
.upload-description {
  display: block;
  margin-top: 4px;
  font-size: 13px;
  color: var(--ui-muted);
}
.format {
  display: block;
  margin-top: 10px;
  font-size: 12px;
  color: var(--ui-muted);
}
.more-head {
  margin: 32px 0 12px;
}
/* Bottom bar: the price and readiness on the left, one pill on the right. */
.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
  background: #15161af2;
  -webkit-backdrop-filter: blur(16px);
  backdrop-filter: blur(16px);
  box-shadow: 0 -1px 0 var(--ui-border);
}
.submit-copy {
  flex: 1;
  min-width: 0;
}
.submit-quote {
  display: block;
  font-size: 16px;
  font-weight: 600;
  color: var(--ui-text);
}
.submit-status {
  display: block;
  margin-top: 2px;
  font-size: 12px;
  color: var(--ui-muted);
}
.is-ready .submit-status {
  color: var(--ui-brand);
}
button.submit-action {
  width: 148px;
  height: 48px;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  font-size: 16px;
  font-weight: 600;
  color: var(--ui-on-brand);
  background: var(--ui-primary);
}
.is-ready button.submit-action {
  box-shadow: 0 6px 20px #00c8dc40;
}
button.submit-action.to-upload {
  color: var(--ui-text);
  background: var(--ui-field);
  box-shadow: inset 0 0 0 1px #00c8dc80;
}
button.submit-action::after {
  border: 0;
}
button.submit-action[disabled] {
  color: var(--ui-muted) !important;
  background: var(--ui-field) !important;
}
