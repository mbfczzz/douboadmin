<view wx:if="{{template.data.imageSlots.length}}">
  <view class="section-head"><text class="section-name">上传参考图片</text><text class="section-count">{{recipeMissing?'还需 '+recipeMissing+' 个必填':'必填图片已齐'}}</text></view>
  <text wx:if="{{template.data.inputHint}}" class="upload-description">{{template.data.inputHint}}</text>
  <scroll-view scroll-x class="slots recipe-slots"><view class="slot-row">
    <view wx:for="{{recipeSlots}}" wx:key="position" class="slot {{item.id?'uploaded':item.optional?'optional':'required'}}" data-position="{{item.position}}" bindtap="chooseRecipeSlot">
      <block wx:if="{{item.id}}"><image src="{{item.url}}" mode="aspectFill" /><text class="slot-tag">{{item.label}}</text>
        <view class="slot-remove" data-position="{{item.position}}" catchtap="removeRecipeSlot"><t-icon name="close" size="14" /></view></block>
      <block wx:else><t-icon name="add" size="24" /><text class="slot-name">{{item.label}}</text><text class="slot-hint">{{item.optional?'选填':'必填'}}</text></block>
    </view>
  </view></scroll-view>
  <view class="recipe-choices {{busy||uploading?'controls-busy':''}}">
    <view class="choice-row" data-sheet="model" bindtap="openRecipeSheet" hover-class="choice-pressed" aria-role="button"><text>生成模型</text><text class="choice-value">{{recipeModels[recipeModelIndex].name||'读取中…'}}</text><t-icon name="chevron-right" size="16" /></view>
    <view wx:if="{{recipeResolutions.length}}" class="choice-row" data-sheet="resolution" bindtap="openRecipeSheet" hover-class="choice-pressed" aria-role="button"><text>清晰度</text><text class="choice-value">{{recipeResolution}}</text><t-icon name="chevron-right" size="16" /></view>
  </view>
  <text wx:if="{{recipeError}}" class="error-box">{{recipeError}}</text>
</view>
<t-popup visible="{{!!recipeSheet}}" placement="bottom" bind:visible-change="closeRecipeSheet">
  <view class="photo-sources">
    <view class="sheet-handle" />
    <view class="photo-source-heading"><text>{{recipeSheet==='model'?'生成模型':'清晰度'}}</text><view class="photo-source-close" bindtap="closeRecipeSheet"><t-icon name="close" size="20" /></view></view>
    <view wx:for="{{recipeOptions}}" wx:key="index" class="choice-option {{index===recipeChecked?'selected':''}}" data-index="{{index}}" bindtap="pickRecipeOption" hover-class="choice-pressed" aria-role="button"><text>{{item}}</text><t-icon wx:if="{{index===recipeChecked}}" name="check" size="18" /></view>
  </view>
</t-popup>
