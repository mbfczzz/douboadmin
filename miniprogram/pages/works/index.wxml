<nav-bar title="我的作品" back />
<view class="subpage has-backdrop works-page">
  <page-backdrop name="bgWorks" />
  <view wx:if="{{loading}}" class="skel-grid" aria-label="正在加载作品"><view class="skeleton" /><view class="skeleton" /><view class="skeleton" /><view class="skeleton" /></view>
  <view wx:elif="{{needsLogin}}" class="empty">
    <showcase />
    <text class="title">登录后查看你的作品</text>
    <text class="desc">完成的图片和视频都在这里。</text>
    <text class="empty-link" bindtap="signIn">{{signingIn?'正在登录…':'去登录 ›'}}</text>
  </view>
  <view wx:elif="{{loadError&&!works.length}}" class="error-box" bindtap="load">{{loadError}} · 点击重试</view>
  <block wx:else>
    <view wx:if="{{total}}" class="works-head"><text class="works-total">{{total}}</text><text class="works-label"> 个完成的作品</text></view>
    <view class="work-filters">
      <view wx:for="{{filters}}" wx:key="key" class="work-filter {{filter===item.key?'active':''}}" data-value="{{item.key}}" bindtap="choose">{{item.text}}</view>
    </view>
    <view wx:if="{{loadError}}" class="error-box" bindtap="load">刷新失败，已保留作品 · 点击重试</view>
    <view wx:if="{{!filtered.length}}" class="empty works-empty">
      <showcase />
      <text class="title">{{filter==='image'?'还没有图片作品':filter==='video'?'还没有视频作品':'还没有完成的作品'}}</text>
      <text class="desc">{{filter==='all'?'从一个想法开始第一次创作。':'可以换个分类看看。'}}</text>
      <text class="empty-link" bindtap="create">去创作 ›</text>
    </view>
    <view wx:else class="completed-grid content-reveal">
      <view class="completed-item" wx:for="{{filtered}}" wx:key="id" data-id="{{item.id}}" bindtap="detail" hover-class="card-pressed">
        <view class="completed-cover">
          <image wx:if="{{item.thumbnailUrl||(item.input.kind==='image'&&item.result)}}" src="{{item.thumbnailUrl||item.result}}" mode="aspectFill" lazy-load data-id="{{item.id}}" binderror="coverError" />
          <image wx:else class="gl gl-32" src="/assets/glyphs/play-muted-lg.png" />
          <text wx:if="{{item.input.duration}}" class="completed-duration">{{item.input.duration}} 秒</text>
        </view>
        <text class="completed-title">{{item.shortTitle}}</text>
        <view class="work-meta">
          <text>{{item.kindText}}</text>
          <text>{{item.time}}</text>
        </view>
      </view>
    </view>
    <text wx:if="{{filtered.length}}" class="works-note">最近完成的作品 · 下拉可刷新</text>
  </block>
<view wx:if="{{total>20}}" class="job-pagination">
  <button bindtap="previous" disabled="{{page<=1}}">上一页</button>
  <text>第 {{page}} 页 · 共 {{total}} 条</text>
  <button bindtap="next" disabled="{{page*20>=total}}">下一页</button>
</view>
</view>
