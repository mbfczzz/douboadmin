@import "../../styles/works.wxss";
.works-page {
  padding: 20px 20px calc(32px + env(safe-area-inset-bottom));
}
.works-head {
  margin: -4px 2px 8px;
}
.works-total {
  font-size: 26px;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}
.works-label {
  font-size: 13px;
  color: var(--ui-muted);
}
.work-filters {
  display: flex;
  gap: 26px;
  margin-bottom: 20px;
}
.work-filter {
  position: relative;
  padding: 8px 0;
  font-size: 15px;
  color: var(--ui-muted);
}
.work-filter.active {
  color: var(--ui-text);
  font-weight: 600;
}
.work-filter.active::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 14px;
  height: 3px;
  margin-left: -7px;
  border-radius: 2px;
  background: var(--ui-brand);
}
.works-page .completed-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px 10px;
}
.works-page .completed-cover {
  /* 2 columns in 20px margins, 10px gap, 3:4 */
  height: calc((100vw - 50px) * 2 / 3);
  overflow: hidden;
  border-radius: 14px;
}
.works-page .completed-cover image {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  border-radius: 0;
}
.works-page .completed-duration {
  left: 8px;
  right: auto;
  bottom: 8px;
  padding: 2px 8px;
  border-radius: 999px;
  font-size: 11px;
  background: #00000080;
}
.works-page .completed-title {
  font-size: 15px;
  margin-top: 10px;
}
.work-meta {
  display: flex;
  gap: 6px;
  margin-top: 3px;
  font-size: 12px;
  line-height: 1.5;
  color: var(--ui-muted);
}
.works-note {
  display: block;
  margin-top: 28px;
  text-align: center;
  font-size: 13px;
  color: var(--ui-muted);
}

@import "../../styles/job-pagination.wxss";
