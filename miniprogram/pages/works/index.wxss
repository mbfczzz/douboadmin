@import "../../styles/works.wxss";
.works-page {
  padding: 20px 20px calc(32px + env(safe-area-inset-bottom));
}
.work-filters {
  display: flex;
  gap: 26px;
  margin-bottom: 20px;
}
.work-filter {
  padding: 10px 0;
  font-size: 14px;
  color: var(--ui-muted);
}
.work-filter.active {
  color: var(--ui-link);
  font-weight: 600;
  font-size: 15px;
}
.works-page .completed-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24px 12px;
}
.works-page .completed-cover {
  height: 144px;
  border-radius: 8px;
}
.works-page .completed-cover image {
  border-radius: 8px;
}
.works-page .completed-title {
  font-size: 14px;
  margin-top: 10px;
}
.work-meta {
  display: flex;
  flex-direction: column;
  gap: 3px;
  margin-top: 5px;
  font-size: 12px;
  line-height: 1.5;
  color: var(--ui-muted);
}
.works-note {
  display: block;
  margin-top: 28px;
  text-align: center;
  font-size: 12px;
  color: var(--ui-muted);
}

@import "../../styles/job-pagination.wxss";
