<wxs module="refs" src="../../utils/mentions.wxs" />
<import src="../../utils/prompt-text.wxml" />
<nav-bar title="作品分享" /><view class="subpage"
  ><view wx:if="{{loadError}}" class="biz-error" bindtap="load"
    >{{loadError}}</view
  ><page-loading show="{{loading&&!work}}" text="正在打开作品…" /><view wx:if="{{work}}" class="biz-card"
    ><text class="biz-heading">{{work.title}}</text
    ><result-gallery
      wx:if="{{work.kind==='image'}}"
      images="{{work.results}}"
      bind:preview="preview"
    /><video wx:else class="biz-preview" src="{{work.result}}" controls /><view
      wx:if="{{work.prompt}}"
      class="biz-note"
      ><template is="prompt-text" data="{{parts:refs.segments(work.prompt,[])}}" /></view
    ><view class="shared-compliance"><text class="ai-label">AI生成内容</text><navigator class="report-link" url="/pages/library/index?mode=support" hover-class="none">举报或投诉</navigator></view></view
  ><button class="biz-action spark-action" bindtap="home"><art-icon name="icSpark" size="20" /><text>去豆播找灵感</text></button></view
>
