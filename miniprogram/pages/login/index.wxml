<nav-bar title="登录" back disabled="{{returning}}" />
<view class="subpage login-page has-backdrop">
  <image wx:if="{{backdrop}}" class="page-backdrop" src="{{backdrop}}" mode="aspectFill" aria-hidden="true" />
  <image wx:if="{{brandIcon}}" class="login-brand brand-tile" src="{{brandIcon}}" mode="aspectFit" aria-label="豆播 AI" binderror="brandError" />
  <view wx:else class="login-brand brand-tile brand-placeholder" bindtap="load" aria-role="button" aria-label="重新加载项目图标">豆播 AI</view>
  <text class="login-heading">{{heading}}</text>
  <text class="login-description">{{description}}</text>
  <view wx:if="{{loading}}" class="loading"><t-loading text="正在连接" /></view>
  <view wx:elif="{{loadError}}" class="error-box" bindtap="load">
    {{loadError}} · 点击重试
  </view>
  <block wx:else>
    <view wx:if="{{!wechatReady}}" class="login-notice">
      {{activationRequired?'微信登录暂不可用，请稍后重试。':'微信登录暂不可用，可以先逛逛，稍后再试。'}}
    </view>
    <view wx:if="{{smsOpen}}" class="sms-form">
      <input class="sms-field" type="number" maxlength="11" placeholder="请输入手机号" placeholder-class="sms-placeholder" value="{{smsPhone}}" bindinput="smsPhoneInput" />
      <view class="sms-row">
        <input class="sms-field" type="number" maxlength="6" placeholder="短信验证码" placeholder-class="sms-placeholder" value="{{smsCode}}" bindinput="smsCodeInput" />
        <button class="sms-send" disabled="{{smsWait>0||busy}}" bindtap="sendCode">{{smsWait>0?smsWait+' 秒后重发':'获取验证码'}}</button>
      </view>
      <button class="phone-login" loading="{{busy}}" disabled="{{busy||returning}}" bindtap="smsLogin">登录</button>
    </view>
    <block wx:else>
    <button wx:if="{{phoneReady}}" class="phone-login" open-type="getPhoneNumber" bindgetphonenumber="phoneLogin" loading="{{busy}}" disabled="{{!wechatReady||busy||returning}}">手机号授权登录</button>
    <button
      wx:else
      class="phone-login"
      loading="{{busy}}"
      disabled="{{!wechatReady||busy||returning}}"
      bindtap="wechat"
    >{{returning?'登录成功，正在返回':'微信登录并继续'}}</button>
    <text class="login-explain">手机号仅在你同意后获取，用于登录及资料登记。头像和昵称可稍后填写。</text>
    <button
      wx:if="{{demoAllowed}}"
      class="demo-entry"
      disabled="{{busy}}"
      bindtap="demo"
    >
      开发演示登录
    </button>
    </block>
  </block>
  <button wx:if="{{wechatReady&&!loading&&!loadError}}" class="text-button phone-alternative" disabled="{{busy||returning}}" bindtap="{{smsOpen?'closeSms':'otherPhone'}}">{{smsOpen?'返回微信登录':'使用其他手机号'}}</button>
  <button class="text-button browse" disabled="{{busy||returning}}" bindtap="back">
    {{activationRequired?'返回授权页':backLabel}}
  </button>
  <text class="privacy-link" bindtap="privacy">隐私保护指引</text>
</view>
