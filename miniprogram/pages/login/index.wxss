@import "../../styles/backdrop.wxss";
.login-page {
  padding: 40px 20px calc(24px + env(safe-area-inset-bottom));
  text-align: center;
}
button.phone-login {
  width: 100%;
  padding: 12px;
  min-height: 48px;
  line-height: 24px;
  border-radius: var(--ui-radius-pill);
  background: var(--ui-primary);
  color: var(--ui-on-brand);
  font-size: 16px;
  font-weight: 600;
}
button.phone-login[disabled] {
  background: var(--ui-disabled);
  color: var(--ui-disabled-text);
}
.login-brand {
  width: 160px;
  height: 78px;
  display: block;
  margin: 0 auto 24px;
}
.login-heading {
  display: block;
  font-size: 20px;
  font-weight: 600;
  line-height: 1.4;
}
.login-description {
  display: block;
  max-width: 300px;
  margin: 12px auto 28px;
  font-size: 15px;
  line-height: 1.7;
  color: var(--ui-muted);
}
.login-explain {
  display: block;
  margin: 16px 0;
  font-size: 13px;
  line-height: 1.7;
  color: var(--ui-muted);
}
.login-notice {
  margin-bottom: 16px;
  padding: 12px;
  border-radius: 8px;
  background: var(--ui-field);
  color: var(--ui-muted);
  font-size: 13px;
  line-height: 1.6;
}
.login-page button.demo-entry {
  width: auto;
  margin: 0 auto;
  background: transparent;
  color: var(--ui-muted);
  font-size: 13px;
  padding: 8px;
}
.login-page button.browse {
  margin: 4px auto 0;
  padding: 12px 18px;
  font-size: 15px;
}
.privacy-link {
  display: block;
  margin-top: 8px;
  padding: 12px;
  font-size: 13px;
  color: var(--ui-muted);
}
.login-page .loading {
  padding: 20px;
  min-height: 48px;
}
@media (max-height: 650px) {
  .login-page {
    padding-top: 20px;
  }
  .login-brand {
    margin-bottom: 16px;
  }
  .login-description {
    margin-bottom: 20px;
  }
}
