@import "../../styles/backdrop.wxss";
.login-page {
  padding: 40px 20px calc(24px + env(safe-area-inset-bottom));
  text-align: center;
}
button.phone-login {
  width: 100%;
  padding: 12px;
  min-height: 48px;
  line-height: 24px;
  border-radius: var(--ui-radius-pill);
  background: var(--ui-primary);
  color: var(--ui-on-brand);
  font-size: 16px;
  font-weight: 600;
}
button.phone-login[disabled] {
  background: var(--ui-disabled);
  color: var(--ui-disabled-text);
}
.login-brand {
  width: 160px;
  height: 78px;
  display: block;
  margin: 0 auto 24px;
}
.login-heading {
  display: block;
  font-size: 20px;
  font-weight: 600;
  line-height: 1.4;
}
.login-description {
  display: block;
  max-width: 300px;
  margin: 12px auto 28px;
  font-size: 15px;
  line-height: 1.7;
  color: var(--ui-muted);
}
.login-explain {
  display: block;
  margin: 16px 0;
  font-size: 13px;
  line-height: 1.7;
  color: var(--ui-muted);
}
.login-notice {
  margin-bottom: 16px;
  padding: 12px;
  border-radius: 8px;
  background: var(--ui-field);
  color: var(--ui-muted);
  font-size: 13px;
  line-height: 1.6;
}
.login-page button.demo-entry {
  width: auto;
  margin: 0 auto;
  background: transparent;
  color: var(--ui-muted);
  font-size: 13px;
  padding: 8px;
}
.login-page button.browse {
  margin: 4px auto 0;
  padding: 12px 18px;
  font-size: 15px;
}
.privacy-link {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  margin-top: 8px;
  padding: 12px;
  font-size: 13px;
  color: var(--ui-muted);
}
.login-page .loading {
  padding: 20px;
  min-height: 48px;
}
@media (max-height: 650px) {
  .login-page {
    padding-top: 20px;
  }
  .login-brand {
    margin-bottom: 16px;
  }
  .login-description {
    margin-bottom: 20px;
  }
}
/* 使用其他手机号: phone + SMS code, then the same primary button. */
.sms-form {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-top: 4px;
  text-align: left;
}
.sms-row {
  display: flex;
  gap: 10px;
}
.sms-box {
  flex: 1;
  min-width: 0;
  height: 52px;
  display: flex;
  align-items: center;
  padding: 0 16px;
  border-radius: 16px;
  background: var(--ui-field);
}
.sms-prefix {
  flex: none;
  margin-right: 12px;
  padding-right: 12px;
  border-right: 1px solid var(--ui-border);
  font-size: 16px;
  line-height: 20px;
  color: var(--ui-muted);
}
.sms-input {
  flex: 1;
  min-width: 0;
  height: 52px;
  font-size: 16px;
  color: var(--ui-text);
}
.sms-placeholder {
  color: var(--ui-placeholder);
}
button.sms-send {
  flex: none;
  width: 112px;
  height: 52px;
  margin: 0;
  padding: 0;
  border-radius: 16px;
  font-size: 14px;
  font-weight: 500;
  line-height: 52px;
  color: var(--ui-brand);
  background: var(--ui-surface);
}
button.sms-send.idle,
button.sms-send[disabled] {
  color: var(--ui-muted);
}
.sms-form button.phone-login {
  margin-top: 8px;
}
