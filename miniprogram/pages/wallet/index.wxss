@import "../../styles/business.wxss";
.purchase-tabs {
  display: flex;
  gap: 8px;
  margin: 12px 0 16px;
}
.purchase-tabs button {
  flex: 1;
  margin: 0;
  min-height: 44px;
  line-height: 44px;
  padding: 0;
  border-radius: 10px;
  background: var(--ui-field);
  color: var(--ui-muted);
  font-size: 13px;
}
.purchase-tabs button::after {
  border: 0;
}
.purchase-tabs .selected {
  background: #333333;
  color: #ffffff;
  font-weight: 600;
}
.checkout-error {
  display: block;
  color: #ff3355;
  font-size: 12px;
  margin: 8px 0;
}
.virtual-products {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
}
button.virtual-product {
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  width: 100%;
  padding: 12px 8px;
  background: var(--ui-field);
  color: #ffffff;
  border: 1px solid transparent;
  border-radius: 12px;
  line-height: 1.6;
  font-size: 13px;
  overflow-wrap: anywhere;
}
button.virtual-product::after {
  border: 0;
}
.virtual-product.selected {
  border-color: #ffffff;
  background: var(--ui-field);
}
.virtual-product text {
  display: block;
  width: 100%;
}
.virtual-product text:first-child {
  min-height: 3.2em;
  flex: 1;
}
.product-price {
  margin: 4px 0;
  font-size: 18px;
  font-weight: 600;
  color: #ffffff;
}
.virtual-product.selected .product-price {
  color: #ffffff;
}
.wallet-links {
  flex-wrap: wrap;
}
.wallet-refresh {
  padding: 12px 0;
}
.ledger-row {
  align-items: flex-start;
}
.ledger-copy {
  flex: 1;
  min-width: 0;
  overflow-wrap: anywhere;
}
.ledger-note,
.ledger-time {
  display: block;
  line-height: 1.6;
}
.ledger-time {
  margin-top: 4px;
}
.ledger-change {
  flex: 0 0 35%;
  text-align: right;
  line-height: 1.5;
  font-size: 15px;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  overflow-wrap: anywhere;
}
.ledger-change.plus {
  color: #32d47a;
}
