@import "../../styles/business.wxss";
@import "../../styles/job-pagination.wxss";
@import "./insights.wxss";
/* One segmented control instead of two boxed buttons. */
.purchase-tabs {
  display: flex;
  gap: 2px;
  margin: 12px 0 16px;
  padding: 3px;
  border-radius: 999px;
  background: var(--ui-field);
}
.purchase-tabs button {
  flex: 1;
  margin: 0;
  min-height: 38px;
  line-height: 38px;
  padding: 0;
  border-radius: 999px;
  background: transparent;
  color: var(--ui-muted);
  font-size: 14px;
}
.purchase-tabs button::after {
  border: 0;
}
.purchase-tabs .selected {
  background: var(--ui-selected);
  color: var(--ui-text);
  font-weight: 600;
}
.purchase-tabs button[disabled],
.virtual-product[disabled] {
  opacity: 0.55;
}
.checkout-error {
  display: block;
  color: var(--ui-danger);
  font-size: 13px;
  margin: 8px 0;
}
.virtual-products {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
}
button.virtual-product {
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  width: 100%;
  padding: 14px 12px;
  background: var(--ui-surface);
  color: var(--ui-text);
  border: 1px solid transparent;
  border-radius: 12px;
  line-height: 1.6;
  font-size: 13px;
  overflow-wrap: anywhere;
}
.virtual-product.selected {
  border-color: var(--ui-selected-line);
  background: var(--ui-selected);
}
.virtual-product > text {
  display: block;
  width: 100%;
}
.product-price {
  margin: 4px 0;
  font-size: 15px;
  font-weight: 600;
  color: var(--ui-text);
}
.virtual-product.selected .product-price {
  color: var(--ui-link);
}
.ledger-row {
  align-items: flex-start;
}
.ledger-copy {
  flex: 1;
  min-width: 0;
  overflow-wrap: anywhere;
}
.ledger-note,
.ledger-time {
  display: block;
}
.ledger-time {
  margin-top: 4px;
}
.ledger-change {
  flex: 0 0 auto;
  max-width: 34%;
  text-align: right;
  line-height: 1.5;
  font-size: 15px;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  overflow-wrap: anywhere;
}
.ledger-change.plus {
  color: var(--ui-success);
}
.wallet-purchase {
  margin: 28px 0;
}
.product-icons {
  width: 100%;
  height: 16px;
  justify-content: flex-end;
  color: var(--ui-link);
  margin-bottom: 8px;
}
.product-points {
  color: var(--ui-points);
  font-size: 24px;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}
.product-unit {
  display: block;
  font-size: 13px;
  font-weight: 400;
  white-space: nowrap;
}
.product-name {
  font-size: 13px;
  color: var(--ui-muted);
  flex: 1;
  margin: 4px 0 12px;
}
.virtual-products.pair {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}
.virtual-products.single {
  grid-template-columns: 1fr;
}
.single .virtual-product {
  display: grid;
  grid-template-columns: 1fr auto;
  text-align: left;
}
.single .product-icons {
  grid-column: 1 / -1;
}
.single .product-price {
  grid-column: 2;
  grid-row: 2 / 4;
  align-self: center;
  margin-left: 16px;
}
.single .product-name {
  margin-bottom: 0;
}
.summary-label,
.summary-held,
.wallet-shortcuts > view,
.purchase-summary,
button.wallet-refresh {
  display: flex;
  align-items: center;
  gap: 8px;
}
.wallet-summary .biz-value {
  color: var(--ui-points);
  min-width: 0;
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 34px;
  margin: 12px 0 16px;
}
.summary-label {
  color: var(--ui-points-muted);
}
.summary-held {
  border-top: 1px solid var(--ui-points-border);
  color: var(--ui-points-muted);
  padding-top: 16px;
  flex-wrap: wrap;
  font-size: 13px;
}
.summary-held .biz-small {
  margin-left: auto;
}
button.wallet-refresh {
  flex-shrink: 0;
  width: auto;
  min-height: 44px;
  background: var(--ui-surface);
  color: var(--ui-points);
  font-size: 13px;
  padding: 0 12px;
  border-radius: 10px;
}
.wallet-shortcuts {
  padding: 0 16px;
  border-radius: var(--ui-radius-card);
  background: var(--ui-surface);
}
.wallet-shortcuts > view {
  min-height: 48px;
  font-size: 15px;
}
.wallet-shortcuts > view + view {
  border-top: 1px solid var(--ui-border);
}
.wallet-shortcuts text {
  flex: 1;
  white-space: nowrap;
}
.purchase-summary {
  margin-top: 16px;
  font-size: 13px;
  line-height: 22px;
  color: var(--ui-points);
}
.wallet-summary {
  background: var(--ui-points-bg);
  border-color: var(--ui-points-border);
}
.wallet-summary .biz-small {
  color: var(--ui-points-muted);
  background: transparent;
}
.icon-tile.plus {
  background: var(--ui-success-bg);
  color: var(--ui-success);
}
@media (max-width: 350px) {
  .virtual-products {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

/* Balance: the same cyan-violet wash as the points strip on 我的. */
.wallet-summary {
  background: linear-gradient(135deg, #00c8dc29, #6c63ff24 55%, var(--ui-surface));
  box-shadow: inset 0 0 0 1px #ffffff12;
}
.wallet-summary .biz-value {
  font-size: 36px;
  letter-spacing: -0.5px;
}

/* Pending payment: a cyan-tinted card with a live glyph. */
.payment-status {
  background: linear-gradient(135deg, #00c8dc1f, var(--ui-surface) 70%);
  box-shadow: inset 0 0 0 1px #00c8dc33;
}
.payment-head {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 6px;
}
.payment-ring {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: var(--ui-brand);
  background: #00c8dc1f;
}
.payment-head .biz-heading {
  margin: 0;
}
