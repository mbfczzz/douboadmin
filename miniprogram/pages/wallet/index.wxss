@import "../../styles/business.wxss";
.purchase-tabs {
  display: flex;
  gap: 8px;
  margin: 12px 0 16px;
}
.purchase-tabs button {
  flex: 1;
  margin: 0;
  min-height: 44px;
  line-height: 44px;
  padding: 0;
  border: 1px solid #353b3e;
  border-radius: 8px;
  background: #1c1f21;
  color: #a0a8ac;
  font-size: 13px;
}
.purchase-tabs button::after {
  border: 0;
}
.purchase-tabs .selected {
  border-color: #577b62;
  background: #25372c;
  color: #9bcbaa;
  font-weight: 600;
}
.checkout-error {
  display: block;
  color: #efb29a;
  font-size: 12px;
  margin: 8px 0;
}
.virtual-products {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(96px, 1fr));
  gap: 8px;
}
button.virtual-product {
  width: 100%;
  padding: 12px 8px;
  background: #1c1f21;
  color: #e9eceb;
  border: 1px solid #353b3e;
  border-radius: 8px;
  line-height: 1.6;
  font-size: 13px;
  overflow-wrap: anywhere;
}
button.virtual-product::after {
  border: 0;
}
.virtual-product.selected {
  border-color: #577b62;
  background: #25372c;
}
.virtual-product text {
  display: block;
}
.product-price {
  margin: 4px 0;
  font-size: 18px;
  font-weight: 700;
  color: #e9eceb;
}
.virtual-product.selected .product-price {
  color: #9bcbaa;
}
.wallet-links {
  flex-wrap: wrap;
}
.wallet-refresh {
  padding: 12px 0;
}
.ledger-row {
  align-items: flex-start;
}
.ledger-copy {
  flex: 1;
  min-width: 0;
  overflow-wrap: anywhere;
}
.ledger-note,
.ledger-time {
  display: block;
  line-height: 1.6;
}
.ledger-time {
  margin-top: 4px;
}
.ledger-change {
  flex: 0 0 35%;
  text-align: right;
  line-height: 1.5;
  font-size: 15px;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  overflow-wrap: anywhere;
}
.ledger-change.plus {
  color: #9bcbaa;
}
