<nav-bar title="我的积分" back />
<view class="subpage page-motion {{pageMotion}}">
  <view wx:if="{{needsLogin}}" class="biz-empty"
    ><text>登录后查看积分与充值记录</text
    ><button class="biz-action" bindtap="signIn">去登录</button></view
  >
  <block wx:else>
    <view wx:if="{{error}}" class="biz-error" bindtap="load"
      >{{error}} · 点击重试</view
    >
    <view wx:if="{{loading&&!info}}" class="biz-note">正在读取积分余额…</view>
    <view wx:if="{{paymentNotice}}" class="biz-note" aria-role="status">{{paymentNotice}}</view>
    <view wx:if="{{pendingOrderId&&paymentWaiting}}" class="biz-pair">
      <view><button class="biz-action biz-secondary" bindtap="orders">查看订单</button></view>
      <view><button class="biz-action biz-secondary" disabled="{{busy}}" bindtap="additionalPurchase">另购积分</button></view>
    </view>
    <view class="biz-card"
      ><text class="biz-label">可用积分</text
      ><text class="biz-value">{{available}}</text
      ><view class="row wallet-links"
        ><text class="biz-small wallet-refresh" bindtap="load">预留积分 {{held}} · 刷新</text
        ><text class="biz-link" bindtap="orders">充值订单 ›</text></view
      ></view
    >
    <view class="biz-card" wx:if="{{info}}"
      ><text class="biz-heading">购买积分</text
      ><block wx:if="{{info.paymentChannel==='wechat_virtual'}}">
        <view wx:if="{{info.virtualCustom||purchaseMode==='custom'}}" class="purchase-tabs">
          <button class="{{purchaseMode==='package'?'selected':''}}" disabled="{{busy||pendingOrderId}}" data-mode="package" bindtap="choosePurchase">积分套餐</button>
          <button class="{{purchaseMode==='custom'?'selected':''}}" disabled="{{busy||pendingOrderId||!info.virtualCustom}}" data-mode="custom" bindtap="choosePurchase">自定义金额</button>
        </view>
        <block wx:if="{{purchaseMode==='custom'}}">
          <text class="biz-label">充值金额（元）</text>
          <input class="biz-input" type="digit" maxlength="10" value="{{amount}}" disabled="{{busy||pendingOrderId}}" bindinput="input" placeholder="输入充值金额" aria-label="自定义充值金额" />
          <text wx:if="{{customStep}}" class="biz-note">按 {{customStep}} 元递增，预计获得 {{estimated}} 积分</text>
          <text wx:if="{{checkoutError}}" class="checkout-error">{{checkoutError}}</text>
        </block>
        <view wx:else class="virtual-products">
          <button wx:for="{{products}}" wx:key="id" class="virtual-product {{productId===item.id?'selected':''}}" aria-label="{{item.name}}，{{item.amount}}元，{{item.points}}积分，{{productId===item.id?'已选择':'未选择'}}" data-id="{{item.id}}" bindtap="chooseProduct" disabled="{{busy||pendingOrderId}}">
            <text>{{item.name}}</text><text class="product-price">¥{{item.amount}}</text><text class="biz-small">{{item.points}} 积分</text>
          </button>
        </view>
        <text wx:if="{{purchaseMode==='package'&&!products.length}}" class="biz-note">暂无可用积分商品，请稍后再试。</text>
      </block><block wx:else><text class="biz-label">充值金额（元）</text
      ><input
        class="biz-input"
        type="digit"
        value="{{amount}}"
        bindinput="input"
        placeholder="输入充值金额"
      /><text class="biz-note"
        >1 元约 {{displayRate}} 积分，预计获得 {{estimated}}
        积分</text></block
      ><button
        class="biz-action"
        loading="{{busy}}"
        disabled="{{busy||!allowed||pendingOrderId||(info.paymentChannel==='wechat_virtual'&&purchaseMode==='package'&&!productId)}}"
        bindtap="pay"
      >
        {{pendingOrderId?'正在确认到账':allowed?(info.paymentChannel==='wechat_virtual'?'购买积分':'微信支付'):'充值暂未开放'}}</button
      ><text wx:if="{{!allowed}}" class="biz-note"
        >{{info.pricing.message||'支付服务或当前设备尚未开放充值。'}}</text
      ></view
    >
    <view class="biz-card"
      ><text class="biz-heading">最近积分流水</text
      ><view wx:if="{{!ledger.length}}" class="biz-empty">暂无积分变动</view
      ><view wx:for="{{ledger}}" wx:key="id" class="biz-row ledger-row"
        ><view class="ledger-copy"
          ><text class="biz-list-title">{{item.title}}</text
          ><text wx:if="{{item.note}}" class="biz-small ledger-note">{{item.note}}</text
          ><text class="biz-small ledger-time">{{item.time}}</text></view
        ><text class="ledger-change {{item.tone}}">{{item.change}}</text></view
      ></view
    >
  </block>
</view>
