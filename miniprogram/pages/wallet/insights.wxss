/* Price, "what the balance buys", package value and ledger grouping. */
.summary-price {
  display: flex;
  justify-content: space-between;
  margin-top: 10px;
  padding-top: 10px;
  border-top: 1px dashed #ffffff1f;
  font-size: 12px;
  color: var(--ui-muted);
}
.price-value {
  color: var(--ui-text);
  font-variant-numeric: tabular-nums;
}
.uses {
  margin: 12px 0;
  padding: 14px 14px 12px;
  border-radius: 16px;
  background: var(--ui-surface);
}
.uses-head {
  display: block;
  margin-bottom: 10px;
  font-size: 13px;
  color: var(--ui-muted);
}
.uses-row {
  display: flex;
  gap: 10px;
}
.use {
  flex: 1;
  min-width: 0;
  padding: 12px;
  border-radius: 12px;
  background: var(--ui-field);
}
/* Each tile opens on a real work of its kind, the kind icon pinned on it. */
.use-cover {
  position: relative;
  height: 72px;
  margin: -12px -12px 10px;
  overflow: hidden;
  border-radius: 12px 12px 0 0;
  background: var(--ui-surface);
}
.use-cover image {
  width: 100%;
  height: 100%;
}
.use-cover::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(transparent 40%, #00000080);
}
.use-cover .use-icon {
  position: absolute;
  left: 10px;
  bottom: 8px;
  z-index: 1;
}
.use-icon {
  width: 28px;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10px;
  color: #fff;
  background: linear-gradient(135deg, #2bd4c8, #1a8fb8);
}
.use-video .use-icon {
  background: linear-gradient(135deg, #7b6cff, #4a47c9);
}
.use-count {
  display: block;
  font-size: 24px;
  font-weight: 700;
  line-height: 30px;
  font-variant-numeric: tabular-nums;
}
.use-unit {
  font-size: 13px;
  font-weight: 400;
  color: var(--ui-muted);
}
.use-title {
  display: block;
  font-size: 13px;
  color: var(--ui-text);
}
.use-cost {
  display: block;
  margin-top: 2px;
  font-size: 11px;
  color: var(--ui-muted);
}
button.virtual-product {
  position: relative;
  overflow: hidden;
}
.virtual-product > text.product-badge {
  width: auto;
}
.product-badge {
  position: absolute;
  top: 0;
  left: 0;
  padding: 2px 8px;
  border-radius: 12px 0 10px 0;
  font-size: 11px;
  font-weight: 600;
  line-height: 18px;
  color: var(--ui-on-brand);
  background: linear-gradient(90deg, #00c8dc, #6c63ff);
}
.product-rate {
  display: block;
  font-size: 11px;
  line-height: 16px;
  color: var(--ui-brand);
}
.ledger-day {
  display: block;
  margin: 14px 0 2px;
  font-size: 12px;
  color: var(--ui-muted);
}
.ledger-day:first-of-type {
  margin-top: 6px;
}
.ledger-side {
  flex: 0 0 auto;
  max-width: 40%;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}
.ledger-side .ledger-change {
  max-width: none;
}
.ledger-after {
  font-size: 11px;
  color: var(--ui-muted);
  font-variant-numeric: tabular-nums;
}
.row-pressed {
  opacity: 0.7;
}

/* Balance card: a small fan of real works drifting off the right edge. */
.wallet-summary {
  position: relative;
  overflow: hidden;
}
.wallet-summary > view:not(.hero-art) {
  position: relative;
  z-index: 1;
}
.hero-art {
  position: absolute;
  top: 18px;
  right: -14px;
  width: 132px;
  height: 120px;
  opacity: 0.5;
  pointer-events: none;
}
.hero-art image {
  position: absolute;
  top: 0;
  width: 62px;
  height: 84px;
  border-radius: 10px;
  box-shadow: 0 6px 16px #00000080;
}
.hero-art .fan-0 { right: 58px; transform: rotate(-12deg); }
.hero-art .fan-1 { right: 30px; top: -6px; transform: rotate(-2deg); z-index: 1; }
.hero-art .fan-2 { right: 0; transform: rotate(10deg); }
/* Packages: bigger packs fan out more works above their figure. */
.product-art {
  position: relative;
  height: 64px;
  margin: 2px auto 10px;
}
.product-art image {
  position: absolute;
  top: 0;
  width: 44px;
  height: 60px;
  border-radius: 8px;
  box-shadow: 0 4px 12px #00000066, 0 0 0 1.5px #ffffff26;
}
.art-1 { width: 44px; }
.art-1 image { left: 0; }
.art-2 { width: 72px; }
.art-2 image:nth-child(1) { left: 0; transform: rotate(-8deg); }
.art-2 image:nth-child(2) { left: 28px; transform: rotate(7deg); }
.art-3 { width: 92px; }
.art-3 image:nth-child(1) { left: 0; transform: rotate(-12deg); }
.art-3 image:nth-child(2) { left: 24px; top: -4px; z-index: 1; }
.art-3 image:nth-child(3) { left: 48px; transform: rotate(12deg); }
