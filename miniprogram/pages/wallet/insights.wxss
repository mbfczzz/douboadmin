/* Price, "what the balance buys", package value and ledger grouping. */
.summary-price {
  display: flex;
  justify-content: space-between;
  margin-top: 10px;
  padding-top: 10px;
  border-top: 1px dashed #ffffff1f;
  font-size: 12px;
  color: var(--ui-muted);
}
.price-value {
  color: var(--ui-text);
  font-variant-numeric: tabular-nums;
}
.uses {
  margin: 12px 0;
  padding: 14px 14px 12px;
  border-radius: 16px;
  background: var(--ui-surface);
}
.uses-head {
  display: block;
  margin-bottom: 10px;
  font-size: 13px;
  color: var(--ui-muted);
}
.uses-row {
  display: flex;
  gap: 10px;
}
.use {
  flex: 1;
  min-width: 0;
  padding: 12px;
  border-radius: 12px;
  background: var(--ui-field);
}
/* Each tile opens on a real work of its kind, the kind icon pinned on it. */
.use-cover {
  position: relative;
  height: 72px;
  margin: -12px -12px 10px;
  overflow: hidden;
  border-radius: 12px 12px 0 0;
  background: var(--ui-surface);
}
.use-cover image {
  width: 100%;
  height: 100%;
}
.use-cover::after {
  content: "";
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(transparent 40%, #00000080);
}
.use-cover .use-icon {
  position: absolute;
  left: 10px;
  bottom: 8px;
  z-index: 1;
}
.use-icon {
  width: 28px;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10px;
  color: #fff;
  background: #00000080;
}
.use-video .use-icon {
  background: #00000080;
}
.use-count {
  display: block;
  font-size: 24px;
  font-weight: 700;
  line-height: 30px;
  font-variant-numeric: tabular-nums;
}
.use-unit {
  font-size: 13px;
  font-weight: 400;
  color: var(--ui-muted);
}
.use-title {
  display: block;
  font-size: 13px;
  color: var(--ui-text);
}
.use-cost {
  display: block;
  margin-top: 2px;
  font-size: 11px;
  color: var(--ui-muted);
}
button.virtual-product {
  position: relative;
  overflow: hidden;
}
button.virtual-product > text.product-badge {
  width: auto;
}
.product-badge {
  position: absolute;
  top: 0;
  left: 0;
  padding: 2px 8px;
  border-radius: 12px 0 10px 0;
  font-size: 11px;
  font-weight: 600;
  line-height: 18px;
  color: var(--ui-on-brand);
  background: var(--ui-text);
}
.product-rate {
  display: block;
  font-size: 11px;
  line-height: 16px;
  color: var(--ui-brand);
}
.ledger-day {
  display: block;
  margin: 14px 0 2px;
  font-size: 12px;
  color: var(--ui-muted);
}
.ledger-day:first-of-type {
  margin-top: 6px;
}
.ledger-side {
  flex: 0 0 auto;
  max-width: 40%;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}
.ledger-side .ledger-change {
  max-width: none;
}
.ledger-after {
  font-size: 11px;
  color: var(--ui-muted);
  font-variant-numeric: tabular-nums;
}
.row-pressed {
  opacity: 0.7;
}

/* Balance card: glass stars fading in from the right edge. */
.wallet-summary {
  position: relative;
  overflow: hidden;
}
.wallet-summary > view {
  position: relative;
  z-index: 1;
}
.summary-photo {
  position: absolute;
  top: 0;
  right: 0;
  width: 72%;
  height: 100%;
  opacity: 0.55;
  -webkit-mask-image: linear-gradient(to right, transparent, #000 60%);
  mask-image: linear-gradient(to right, transparent, #000 60%);
  pointer-events: none;
}
/* Packages: one product photo, more stars for bigger packs. */
.product-photo {
  display: block;
  width: 76px;
  height: 76px;
  margin: 2px auto 10px;
  border-radius: 18px;
  box-shadow: 0 6px 16px #00000066;
}
/* Custom amount: what the typed sum buys, as large as a package figure. */
.custom-estimate {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: 12px;
  padding: 12px;
  border-radius: 16px;
  background: var(--ui-surface);
}
.custom-photo {
  width: 56px;
  height: 56px;
  flex-shrink: 0;
  border-radius: 14px;
}
.custom-points {
  display: block;
  font-size: 24px;
  font-weight: 700;
  line-height: 30px;
  color: var(--ui-text);
}
