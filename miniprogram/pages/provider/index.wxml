<nav-bar title="{{promo?'我的推广码':'服务商中心'}}" back />
<view class="subpage has-backdrop">
  <page-backdrop name="bgProvider" />
  <view wx:if="{{loadError}}" class="biz-error" bindtap="load">{{loadError}} · 点击重试</view>
  <view wx:if="{{center}}" class="provider-head">
    <view class="provider-glyph {{promo?'is-glyph':''}}"><image wx:if="{{promo}}" class="gl gl-22" src="/assets/glyphs/qrcode.png" /><image wx:else class="provider-photo" src="/assets/photos/provider.jpg" mode="aspectFill" /></view>
    <view class="provider-title"><text class="provider-name">{{center.name}}</text><text class="provider-level {{center.role}}">{{roleName}}</text></view>
    <text class="biz-note">{{promo?'推广码':'服务商'}} · {{center.status==='active'?'正常':'已停用'}}</text>
    <text wx:if="{{center.status!=='active'}}" class="biz-error">服务商已停用，请联系总部</text>
  </view>
  <view wx:if="{{center}}" class="provider-stats">
    <view><text class="stat-num">{{center.members}}</text><text class="stat-label">会员</text></view>
    <view wx:if="{{center.role!=='s2'&&!promo}}"><text class="stat-num">{{childrenTotal}}</text><text class="stat-label">下级服务商</text></view>
    <view wx:if="{{!promo}}"><text class="stat-num small {{center.account?'on':''}}">{{center.account?'已开通':'未开通'}}</text><text class="stat-label">后台登录</text></view>
  </view>
  <view wx:if="{{shown.qr}}" class="biz-card provider-share">
    <view wx:if="{{tabs.length>1}}" class="provider-tabs">
      <text wx:for="{{tabs}}" wx:key="key" class="{{tab===item.key?'on':''}}" data-tab="{{item.key}}" bindtap="switchTab" aria-label="{{item.label}}">{{item.short}}</text>
    </view>
    <!-- Dark card in the app theme. The code keeps a white disc behind it
         (black on white scans reliably); the saved card stays WeChat's
         plain white style (utils/invite-poster.ts). -->
    <view class="invite-paper">
      <text class="invite-owner">{{center.name||'豆播 AI'}}</text>
      <text class="invite-caption">{{posterTitle}}</text>
      <view class="qr-disc"><image class="provider-qr" src="{{shown.qr}}" mode="aspectFit" show-menu-by-longpress /></view>
      <text class="invite-app">豆播AI</text>
      <text class="invite-caption">微信扫一扫，使用小程序</text>
      <view class="invite-code" data-text="{{shown.raw}}" bindtap="copy" hover-class="pill-pressed" aria-role="button" aria-label="{{'复制邀请码 '+shown.code}}"><text class="invite-number">邀请码 {{shown.code}}</text><image class="gl gl-14" src="/assets/glyphs/copy-muted.png" /></view>
      <text class="invite-caption">识别后自动带入邀请码，完成登记后由超级管理员开通</text>
    </view>
    <text class="biz-note">{{note}}</text>
    <button class="biz-action" bindtap="save" loading="{{busy}}" disabled="{{busy}}">保存分享卡片</button>
  </view>
  <block wx:if="{{center&&center.role!=='s2'}}">
    <text class="provider-section">下级服务商 · {{childrenTotal}}</text>
    <view wx:if="{{childrenError}}" class="biz-error" bindtap="moreChildren">{{childrenError}} · 点击重试</view>
    <view wx:if="{{!children.length&&!childrenLoading&&!childrenError}}" class="biz-card biz-note">还没有下级服务商</view>
    <view wx:for="{{children}}" wx:key="id" class="biz-card provider-child">
      <view class="provider-title"><text class="biz-list-title">{{item.name}}</text><text class="provider-level {{item.role}}">{{item.roleName}}</text><text wx:if="{{item.status!=='active'}}" class="provider-off pill {{item.status==='pending'?'warning':''}}">{{item.status==='pending'?'待开通':'已停用'}}</text></view>
      <view class="child-meta"><text class="child-num">{{item.members}}</text><text> 位会员 · {{item.date}} 加入</text></view>
      <text class="biz-note">后台账号 {{item.account||'未开通'}}{{item.scanned?' · 扫码登记':''}}</text>
    </view>
    <view wx:if="{{children.length<childrenTotal||childrenLoading}}" class="provider-more" bindtap="moreChildren">{{childrenLoading?'正在加载…':'加载更多下级'}}</view>
  </block>
  <view wx:if="{{center}}" class="biz-card provider-login">
    <text class="biz-heading">管理后台登录</text>
    <view class="biz-row"><text class="biz-label">账号</text><text>{{center.account||'未开通'}}</text></view>
    <text class="biz-note">登录账号由超级管理员统一开通、启停和管理</text>
  </view>
</view>
<ui-dialog id="ui-dialog" />

<canvas type="2d" id="invite-poster" class="poster-canvas" />
