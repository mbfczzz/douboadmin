/* On-page share card in the app's dark theme: light text, the code on a
   white disc. The disc is wide enough for the mini-program badge WeChat
   draws near the code's edge; the image's blank square corners are clipped.
   The saved image keeps WeChat's plain white card. */
.invite-paper {
  padding: 26px 16px 20px;
  border-radius: 16px;
  text-align: center;
  background: var(--ui-surface);
  box-shadow: inset 0 0 0 1px #ffffff12;
}
.invite-owner {
  display: block;
  font-size: 16px;
  font-weight: 600;
  line-height: 22px;
  color: var(--ui-text);
  overflow-wrap: anywhere;
}
.invite-caption {
  display: block;
  margin-top: 4px;
  font-size: 12px;
  line-height: 18px;
  color: var(--ui-muted);
}
.qr-disc {
  width: 236px;
  height: 236px;
  margin: 20px auto 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 0 0 6px #ffffff0f, 0 12px 32px #00000066;
}
.qr-disc .provider-qr {
  width: 200px;
  height: 200px;
  margin: 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
}
.invite-app {
  display: block;
  font-size: 16px;
  font-weight: 600;
  color: var(--ui-text);
}
.invite-code {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  margin-top: 16px;
  padding: 6px 14px;
  border-radius: 999px;
  background: var(--ui-field);
}
.invite-number {
  font-size: 15px;
  color: var(--ui-text);
  font-variant-numeric: tabular-nums;
}
.pill-pressed {
  opacity: 0.6;
}
.poster-canvas {
  position: fixed;
  left: -1000px;
  top: 0;
  width: 720px;
  height: 1060px;
  pointer-events: none;
}
