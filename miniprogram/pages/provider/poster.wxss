/* On-page share card: WeChat's own plain white mini-program code card,
   the same as the saved image. */
.invite-paper {
  padding: 26px 16px 20px;
  border-radius: 12px;
  background: #fff;
  text-align: center;
}
.invite-owner {
  display: block;
  font-size: 16px;
  font-weight: 600;
  line-height: 22px;
  color: #111111;
  overflow-wrap: anywhere;
}
.invite-caption {
  display: block;
  margin-top: 4px;
  font-size: 12px;
  line-height: 18px;
  color: #6f6f6f;
}
.invite-paper .provider-qr {
  width: 220px;
  height: 220px;
  margin: 18px auto 14px;
  padding: 0;
  border-radius: 0;
  background: transparent;
}
.invite-app {
  display: block;
  font-size: 16px;
  font-weight: 600;
  color: #111111;
}
.invite-code {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  margin-top: 18px;
  padding: 4px 0;
  color: #6f6f6f;
}
.invite-number {
  font-size: 15px;
  color: #111111;
  font-variant-numeric: tabular-nums;
}
.pill-pressed {
  opacity: 0.6;
}
.poster-canvas {
  position: fixed;
  left: -1000px;
  top: 0;
  width: 720px;
  height: 1060px;
  pointer-events: none;
}
