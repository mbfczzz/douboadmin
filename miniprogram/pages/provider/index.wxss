@import "./poster.wxss";
@import "../../styles/business.wxss";
.provider-head {
  padding: 8px 2px 16px;
}
.provider-title {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
  margin-bottom: 4px;
}
.provider-title > text:first-child {
  flex: 1 1 180px;
  min-width: 0;
  overflow-wrap: anywhere;
}
.provider-level,
.provider-off {
  flex-shrink: 0;
  white-space: nowrap;
  border-radius: 6px;
}
.provider-name {
  font-size: 20px;
  font-weight: 600;
  line-height: 30px;
}
.provider-level {
  padding: 1px 8px;
  border-radius: 6px;
  background: var(--ui-info-bg);
  color: var(--ui-info);
  font-size: 12px;
  line-height: 18px;
}
.provider-head .biz-error {
  margin: 10px 0 0;
}
/* The share card is its own surface: no panel around it. */
.biz-card.provider-share {
  padding: 0;
  text-align: center;
  background: transparent;
}
.provider-tabs {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8px 16px;
  margin-bottom: 14px;
  color: var(--ui-muted);
  font-size: 15px;
}
.provider-tabs text {
  display: inline-flex;
  align-items: center;
  min-height: var(--ui-touch-size);
  padding: 4px 0;
}
.provider-tabs .on {
  color: var(--ui-text);
  font-weight: 500;
  box-shadow: inset 0 -2px 0 var(--ui-text);
}
.provider-qr {
  display: block;
  width: 200px;
  height: 200px;
  margin: 0 auto 12px;
  padding: 8px;
  box-sizing: border-box;
  border-radius: 8px;
  background: #fff;
}
.provider-code {
  display: flex;
  justify-content: center;
  align-items: baseline;
  gap: 12px;
  margin-bottom: 4px;
  font-family: monospace;
  font-size: 20px;
  font-weight: 600;
  letter-spacing: 2px;
}
.provider-code .biz-link,
.provider-secret .biz-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: var(--ui-touch-size);
  min-height: var(--ui-touch-size);
  font-family: inherit;
  font-size: 13px;
  letter-spacing: 0;
}
.provider-share button.biz-action,
.provider-login button.biz-action {
  margin-top: 12px;
}
.provider-section {
  display: block;
  margin: 24px 2px 12px;
  font-size: 16px;
  font-weight: 500;
}
.provider-off {
  padding: 1px 6px;
}
.provider-facts {
  display: flex;
  margin: 8px 0;
}
.provider-facts view {
  flex: 1;
}
.provider-facts .biz-label {
  margin-bottom: 2px;
}
.provider-facts text:last-child {
  font-size: 16px;
  font-weight: 600;
}
.provider-secret {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  min-width: 0;
  align-items: baseline;
  gap: 12px;
  font-family: monospace;
  font-size: 15px;
}
.biz-row .biz-label {
  margin: 0;
  flex-shrink: 0;
}
.provider-login .biz-row > text:last-child {
  min-width: 0;
  overflow-wrap: anywhere;
  text-align: right;
}

/* Header: a gradient glyph beside the provider name. */
.provider-head {
  position: relative;
  padding-left: 60px;
  min-height: 48px;
}
.provider-glyph {
  position: absolute;
  left: 2px;
  top: 8px;
  width: 48px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14px;
  color: var(--ui-on-brand);
  background: var(--ui-text);
}
.provider-more {
  padding: 16px 0;
  text-align: center;
  font-size: 13px;
  color: var(--ui-muted);
}
.provider-stats {
  display: flex;
  gap: 8px;
  margin-bottom: 12px;
}
.provider-stats > view {
  flex: 1;
  padding: 12px 14px;
  border-radius: 14px;
  background: var(--ui-surface);
}
.provider-stats .stat-num {
  display: block;
  font-size: 22px;
  font-weight: 700;
  line-height: 28px;
  font-variant-numeric: tabular-nums;
}
.provider-stats .stat-num.small {
  font-size: 16px;
  color: var(--ui-muted);
}
.provider-stats .stat-num.on {
  color: var(--ui-success);
}
.provider-stats .stat-label {
  font-size: 12px;
  color: var(--ui-muted);
}
.child-meta {
  margin: 6px 0 2px;
  font-size: 13px;
  color: var(--ui-muted);
}
.child-num {
  font-size: 16px;
  font-weight: 600;
  color: var(--ui-text);
  font-variant-numeric: tabular-nums;
}
