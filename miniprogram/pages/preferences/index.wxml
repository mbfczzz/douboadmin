<nav-bar title="设置" back /><view class="subpage has-backdrop"
  ><page-backdrop name="bgSettings" /><view wx:if="{{needsLogin}}" class="biz-empty"
    ><image class="empty-photo" src="/assets/photos/empty-login.jpg" mode="aspectFill" aria-hidden="true" /><text>登录后设置个人偏好</text><text class="empty-link" bindtap="signIn">去登录 ›</text></view
  ><view wx:if="{{loadError}}" class="biz-error" bindtap="load"
    >{{loadError}} · 重试</view
  ><page-loading wx:elif="{{!row&&!needsLogin}}" show shape="list" text="正在读取设置…"></page-loading
  ><block wx:if="{{row}}"
    ><view class="biz-card"
      ><view class="biz-row"
        ><view class="pref-label"><art-icon name="icNotice" size="28" fallback-size="20" glyph="/assets/glyphs/notifications-muted.png" /><text>作品完成站内通知</text></view
        ><switch
          checked="{{row.data.inAppNotifications}}"
          disabled="{{busy}}"
          color="#00c8dc"
          data-field="inAppNotifications"
          bindchange="change" /></view
      ><view class="biz-row"
        ><view class="pref-label"><art-icon name="icPlay" size="28" fallback-size="20" glyph="/assets/glyphs/play-muted.png" /><text>作品预览自动播放</text></view
        ><switch
          checked="{{row.data.autoplay}}"
          disabled="{{busy}}"
          color="#00c8dc"
          data-field="autoplay"
          bindchange="change" /></view
      ><view class="biz-row"
        ><view class="pref-label"><art-icon name="icStats" size="28" fallback-size="20" glyph="/assets/glyphs/stats-muted.png" /><text>详细使用统计</text></view
        ><switch
          checked="{{row.data.analytics}}"
          disabled="{{busy}}"
          color="#00c8dc"
          data-field="analytics"
          bindchange="change" /></view
      ><text class="biz-note"
        >开启后记录页面、操作类型、进入场景、设备平台和随机访客标识，不上传创作描述、素材内容或手机号。</text
      ></view
    ><view class="biz-card"
      ><text class="biz-heading">微信完成通知</text
      ><text class="biz-note"
        >{{completionTemplateId?'需要微信授权订阅，是否能送达以微信授权状态为准。':'通知模板尚未配置，当前可使用站内通知。'}}</text
      ><button
        wx:if="{{completionTemplateId}}"
        class="biz-action biz-secondary"
        bindtap="subscribe"
      >
        授权订阅通知
      </button></view
    ><view class="biz-card general"
      ><view class="general-row" bindtap="help" hover-class="row-pressed"><art-icon name="icHelp" size="28" fallback-size="20" glyph="/assets/glyphs/help-muted.png" /><text>帮助与反馈</text><t-icon name="chevron-right" size="18" /></view
      ><view class="general-row" bindtap="support" hover-class="row-pressed"><art-icon name="icHelp" size="28" fallback-size="20" glyph="/assets/glyphs/help-muted.png" /><text>客服与投诉</text><t-icon name="chevron-right" size="18" /></view
      ><view class="general-row" bindtap="terms" hover-class="row-pressed"><art-icon name="icInfo" size="28" fallback-size="20" glyph="/assets/glyphs/info-muted.png" /><text>用户协议</text><t-icon name="chevron-right" size="18" /></view
      ><view class="general-row" bindtap="policy" hover-class="row-pressed"><art-icon name="icPrivacy" size="28" fallback-size="20" glyph="/assets/glyphs/shield-muted.png" /><text>隐私政策</text><t-icon name="chevron-right" size="18" /></view
      ><view class="general-row" bindtap="privacy" hover-class="row-pressed"><art-icon name="icPrivacy" size="28" fallback-size="20" glyph="/assets/glyphs/shield-muted.png" /><text>微信隐私保护指引</text><t-icon name="chevron-right" size="18" /></view
      ><view wx:if="{{version}}" class="general-row static" bindtap="version"><art-icon name="icInfo" size="28" fallback-size="20" glyph="/assets/glyphs/info-muted.png" /><text>当前版本</text><text class="general-value">{{version}}</text></view
      ><view class="general-row filing-row" bindtap="filing" hover-class="row-pressed" aria-role="button" aria-label="复制小程序备案号"><art-icon name="icInfo" size="28" fallback-size="20" glyph="/assets/glyphs/info-muted.png" /><text>小程序备案号</text><text class="general-value">鲁ICP备2022009868号-9X</text></view
    ></view
    ><view class="sign-out" bindtap="signOut" hover-class="sign-out-pressed" aria-role="button">退出登录</view></block
  ></view
>
