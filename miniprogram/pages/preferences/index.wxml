<nav-bar title="设置" back /><view class="subpage"
  ><view wx:if="{{needsLogin}}" class="biz-empty"
    ><view class="empty-icon"><t-icon name="setting" size="30" /></view><text>登录后设置个人偏好</text><text class="empty-link" bindtap="signIn">去登录 ›</text></view
  ><view wx:if="{{loadError}}" class="biz-error" bindtap="load"
    >{{loadError}} · 重试</view
  ><block wx:if="{{row}}"
    ><view class="biz-card"
      ><view class="biz-row"
        ><view class="pref-label"><t-icon name="notification" size="20" /><text>作品完成站内通知</text></view
        ><switch
          checked="{{row.data.inAppNotifications}}"
          disabled="{{busy}}"
          color="#00c8dc"
          data-field="inAppNotifications"
          bindchange="change" /></view
      ><view class="biz-row"
        ><view class="pref-label"><t-icon name="play-circle" size="20" /><text>作品预览自动播放</text></view
        ><switch
          checked="{{row.data.autoplay}}"
          disabled="{{busy}}"
          color="#00c8dc"
          data-field="autoplay"
          bindchange="change" /></view
      ><view class="biz-row"
        ><view class="pref-label"><t-icon name="chart-bar" size="20" /><text>详细使用统计</text></view
        ><switch
          checked="{{row.data.analytics}}"
          disabled="{{busy}}"
          color="#00c8dc"
          data-field="analytics"
          bindchange="change" /></view
      ><text class="biz-note"
        >使用统计仅记录页面和操作类型，不上传创作描述、素材内容或手机号。</text
      ></view
    ><view class="biz-card"
      ><text class="biz-heading">微信完成通知</text
      ><text class="biz-note"
        >{{completionTemplateId?'需要微信授权订阅，是否能送达以微信授权状态为准。':'通知模板尚未配置，当前可使用站内通知。'}}</text
      ><button
        wx:if="{{completionTemplateId}}"
        class="biz-action biz-secondary"
        bindtap="subscribe"
      >
        授权订阅通知
      </button></view
    ><view class="biz-card general"
      ><view class="general-row" bindtap="help" hover-class="row-pressed"><t-icon name="help-circle" size="20" /><text>帮助与反馈</text><t-icon name="chevron-right" size="18" /></view
      ><view class="general-row" bindtap="privacy" hover-class="row-pressed"><t-icon name="secured" size="20" /><text>隐私保护指引</text><t-icon name="chevron-right" size="18" /></view
      ><view wx:if="{{version}}" class="general-row static" bindtap="version"><t-icon name="info-circle" size="20" /><text>当前版本</text><text class="general-value">{{version}}</text></view
    ></view
    ><view class="sign-out" bindtap="signOut" hover-class="sign-out-pressed" aria-role="button">退出登录</view></block
  ></view
>
