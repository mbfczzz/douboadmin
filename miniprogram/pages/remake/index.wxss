@import "../../styles/business.wxss";
.remake-title {
  display: block;
  margin-top: 12px;
}
.remake-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: 4px;
}
.remake-change {
  flex: none;
  font-size: 13px;
  color: var(--ui-link);
}
.remake-label {
  display: block;
  margin-bottom: 10px;
  font-size: 15px;
  font-weight: 600;
}
.remake-input {
  width: 100%;
  height: 96px;
  font-size: 14px;
  line-height: 20px;
}
.remake-placeholder {
  color: var(--ui-placeholder);
}
.remake-actions {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 12px;
}
.remake-paste {
  flex: none;
  padding: 0 8px;
  font-size: 14px;
  color: var(--ui-link);
}
button.remake-read {
  flex: 1;
  width: auto;
  margin: 0;
  border-radius: var(--ui-radius-pill);
}
button.remake-start {
  margin-top: 20px;
}
.remake-long {
  display: block;
  margin-top: 12px;
  color: var(--ui-warning);
}
.remake-pictures {
  margin-top: 12px;
}
.picture-row {
  display: flex;
  gap: 10px;
}
.picture {
  position: relative;
  width: 72px;
  height: 72px;
  border-radius: 10px;
  overflow: hidden;
  background: var(--ui-field);
}
.picture-photo {
  width: 100%;
  height: 100%;
}
.picture-remove {
  position: absolute;
  top: 4px;
  right: 4px;
  width: 20px;
  height: 20px;
  border-radius: 10px;
  line-height: 18px;
  text-align: center;
  font-size: 14px;
  color: #fff;
  background: #000000a0;
}
.picture-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
  font-size: 11px;
  color: var(--ui-muted);
}
.picture-add.is-busy {
  opacity: 0.6;
}
.remake-note {
  display: block;
  margin-top: 10px;
  text-align: center;
}
