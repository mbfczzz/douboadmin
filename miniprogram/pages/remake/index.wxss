@import "../../styles/business.wxss";
@import "./picks.wxss";
.remake-title {
  display: block;
  margin-top: 12px;
}
.remake-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: 4px;
}
.remake-change {
  flex: none;
  font-size: 13px;
  color: var(--ui-link);
}
.remake-label {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 10px;
  font-size: 15px;
  font-weight: 600;
}
.remake-input {
  width: 100%;
  height: 96px;
  font-size: 14px;
  line-height: 20px;
}
.remake-placeholder {
  color: var(--ui-placeholder);
}
.remake-actions {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 12px;
}
.remake-paste {
  flex: none;
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 0 8px;
  font-size: 14px;
  color: var(--ui-link);
}
button.remake-read {
  flex: 1;
  width: auto;
  margin: 0;
  border-radius: var(--ui-radius-pill);
}
button.remake-start {
  margin-top: 20px;
}
.remake-long {
  display: block;
  margin-top: 12px;
  color: var(--ui-warning);
}
.remake-note {
  display: block;
  margin-top: 10px;
  text-align: center;
}
.remake-paste.is-busy {
  opacity: 0.6;
}
.remake-tip {
  margin-top: 10px;
}
