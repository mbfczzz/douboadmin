<nav-bar title="一键复刻" back />
<view class="subpage remake-page">
  <view wx:if="{{loadError}}" class="biz-error" bindtap="load">{{loadError}} · 点击重试</view>
  <view wx:if="{{loading&&!video}}" class="skel-list" aria-label="正在加载视频"><view class="skeleton skel-hero" /></view>
  <view wx:elif="{{video}}" class="biz-card remake-source">
    <video wx:if="{{video.url}}" class="biz-preview" src="{{video.url}}" poster="{{video.cover}}" controls />
    <image wx:else class="biz-image" src="{{video.cover}}" mode="aspectFill" />
    <text class="biz-heading remake-title">{{video.title}}</text>
    <text class="biz-small">{{video.author}} · {{video.dateText}}</text>
  </view>
  <view wx:elif="{{!loadError}}" class="biz-empty">
    <image class="empty-photo" src="/assets/photos/empty-video.jpg" mode="aspectFill" aria-hidden="true" />
    <text>从创作页的热门视频点「做同款」</text>
    <text class="empty-link" bindtap="pick">去选视频 ›</text>
  </view>
  <button class="biz-action remake-start" disabled="{{!video}}" bindtap="start">开始复刻</button>
</view>
