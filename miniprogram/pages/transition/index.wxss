@import "./bean.wxss";

.transition-page {
  min-height: calc(100vh - 100px);
  padding: 0 24px calc(80px + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: center;
}
.transition-stage {
  width: 100%;
  text-align: center;
}
.transition-title {
  display: block;
  font-size: 19px;
  line-height: 1.5;
  font-weight: 600;
}
.transition-hint {
  display: block;
  margin-top: 18px;
  font-size: 13px;
  line-height: 1.7;
  color: #a0a8ac;
}
.transition-page .retry-button {
  width: 148px;
  height: 44px;
  line-height: 44px;
  padding: 0;
  margin: 24px auto 0;
  border-radius: 8px;
  background: #25372c;
  color: #c5e2ce;
  font-size: 14px;
  transition:
    opacity 120ms ease,
    transform 120ms ease;
}
.retry-pressed {
  opacity: 0.8;
  transform: scale(0.98);
}
@media (prefers-reduced-motion: reduce) {
  .transition-page .retry-button {
    transition: none;
  }
  .retry-pressed {
    transform: none;
  }
}
