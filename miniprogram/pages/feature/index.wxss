@import "../../styles/business.wxss";
/* Room for the action pinned to the bottom. */
.feature-page {
  padding-bottom: calc(96px + env(safe-area-inset-bottom));
}
.feature-card {
  margin-bottom: 12px;
}
.feature-label {
  display: block;
  margin-bottom: 12px;
  font-size: 15px;
  font-weight: 600;
}
.upload-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
  height: 140px;
  border: 1px dashed var(--ui-border);
  border-radius: 12px;
  font-size: 13px;
  color: var(--ui-muted);
}
.feature-text {
  width: 100%;
  height: 140px;
  font-size: 14px;
  line-height: 22px;
}
.feature-placeholder {
  color: var(--ui-placeholder);
}
.feature-count {
  display: block;
  text-align: right;
  font-size: 12px;
  color: var(--ui-muted);
}
.feature-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.chip {
  padding: 6px 14px;
  border-radius: 999px;
  font-size: 13px;
  color: var(--ui-link);
  background: var(--ui-field);
}
.chip.on,
.feature-tabs .on {
  color: var(--ui-on-brand);
  background: var(--ui-primary);
  font-weight: 600;
}
.feature-tabs {
  display: flex;
  margin-bottom: 12px;
  padding: 4px;
  border-radius: 999px;
  background: var(--ui-surface);
}
.feature-tabs text {
  flex: 1;
  padding: 8px 0;
  border-radius: 999px;
  text-align: center;
  font-size: 14px;
  color: var(--ui-muted);
}
.feature-row {
  display: flex;
  justify-content: space-between;
  padding: 12px 0;
  font-size: 14px;
  border-bottom: 1px solid var(--ui-border);
}
.feature-row:last-child {
  border-bottom: 0;
}
.row-value {
  color: var(--ui-muted);
}
.feature-notes {
  display: flex;
  flex-direction: column;
  gap: 6px;
  font-size: 13px;
  line-height: 20px;
  color: var(--ui-link);
}
.feature-foot {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  padding: 12px 20px calc(16px + env(safe-area-inset-bottom));
  background: var(--ui-bg);
}
