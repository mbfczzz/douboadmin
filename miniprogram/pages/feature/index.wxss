@import "../../styles/business.wxss";
@import "./upload.wxss";
/* Room for the action pinned to the bottom. */
.feature-page {
  padding-bottom: calc(96px + env(safe-area-inset-bottom));
}
.feature-card {
  margin-bottom: 12px;
}
.feature-label {
  display: block;
  margin-bottom: 12px;
  font-size: 15px;
  font-weight: 600;
}
.feature-text {
  width: 100%;
  height: 140px;
  font-size: 14px;
  line-height: 22px;
}
.feature-placeholder {
  color: var(--ui-placeholder);
}
.feature-count {
  display: block;
  text-align: right;
  font-size: 12px;
  color: var(--ui-muted);
}
.feature-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.chip {
  padding: 6px 14px;
  border-radius: 999px;
  font-size: 13px;
  color: var(--ui-link);
  background: var(--ui-field);
}
.chip.on,
.feature-tabs .on {
  color: var(--ui-on-brand);
  background: var(--ui-primary);
  font-weight: 600;
}
.feature-tabs {
  display: flex;
  margin-bottom: 12px;
  padding: 4px;
  border-radius: 999px;
  background: var(--ui-surface);
}
.feature-tabs text {
  flex: 1;
  padding: 8px 0;
  border-radius: 999px;
  text-align: center;
  font-size: 14px;
  color: var(--ui-muted);
}
.feature-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 0;
  font-size: 14px;
  border-bottom: 1px solid var(--ui-border);
}
.feature-row:last-child {
  border-bottom: 0;
}
.row-value {
  color: var(--ui-muted);
}
.feature-notes {
  display: flex;
  flex-direction: column;
  gap: 6px;
  font-size: 13px;
  line-height: 20px;
  color: var(--ui-link);
}
.feature-foot {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  padding: 12px 20px calc(16px + env(safe-area-inset-bottom));
  background: var(--ui-bg);
}
.text-foot {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12px;
}
.text-clear {
  margin-right: auto;
  padding: 4px 0;
  font-size: 13px;
  color: var(--ui-link);
}
.chip.example {
  color: var(--ui-text);
}
/* Picture-style cards (图文成片 / 漫画推文). */
.style-strip {
  margin: 0 -16px;
  white-space: nowrap;
}
.style-row {
  display: inline-flex;
  gap: 10px;
  padding: 0 16px;
}
.style-card {
  position: relative;
  flex: none;
  width: 92px;
  height: 122px;
  border-radius: 12px;
  overflow: hidden;
  background: var(--ui-field);
  box-shadow: inset 0 0 0 2px transparent;
}
.style-card image {
  width: 100%;
  height: 100%;
}
.style-card text {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18px 0 8px;
  text-align: center;
  font-size: 13px;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(transparent, #000000c0);
}
.style-card.on {
  box-shadow: 0 0 0 2px var(--ui-brand);
}
/* Option tiles two to a row. */
.feature-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}
.feature-grid .feature-row {
  width: calc(50% - 5px);
  box-sizing: border-box;
  padding: 12px;
  border: 0;
  border-radius: 12px;
  background: var(--ui-field);
  font-size: 13px;
}
.feature-grid .feature-row:last-child {
  border-bottom: 0;
}
.row-name {
  display: flex;
  align-items: center;
  gap: 6px;
}
.feature-grid .feature-row {
  gap: 6px;
}
.feature-grid .row-name {
  flex: none;
  white-space: nowrap;
}
.feature-grid .row-value {
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 12px;
}
/* Narrow phones: the words need the room more than the icons. */
@media (max-width: 350px) {
  .feature-grid .feature-row {
    padding: 12px 10px;
  }
  .feature-grid .row-name image {
    display: none;
  }
}
