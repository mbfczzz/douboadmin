<template name="outfit">
  <view class="outfit" data-id="{{item.id}}" bindtap="openPreview" hover-class="card-pressed" aria-role="button" aria-label="{{item.title}}">
    <view class="outfit-photo">
      <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" lazy-load />
      <view class="outfit-wear" data-id="{{item.id}}" catchtap="wear" aria-role="button" aria-label="试穿这件"><image wx:if="{{art.fit}}" class="art-icon art-14" src="{{art.fit}}" /><t-icon wx:else name="user-add" size="14" />试穿</view>
      <view class="outfit-heart" data-id="{{item.id}}" catchtap="favorite" aria-role="button" aria-label="{{favored[item.id]?'取消收藏':'收藏'}}">
        <image class="gl gl-16" src="/assets/glyphs/{{favored[item.id]?'heart-filled-pink':'favorites'}}.png" />
      </view>
    </view>
    <text class="outfit-title">{{item.title}}</text>
    <text wx:if="{{item.description}}" class="outfit-desc">{{item.description}}</text>
  </view>
</template>

<nav-bar title="AI试衣" back />
<view class="subpage has-backdrop tryon-page">
  <page-backdrop name="bgTryon" />
  <view class="tryon-tabs">
    <view wx:for="{{tabs}}" wx:key="key" class="tryon-tab {{tab===item.key?'on':''}}" data-key="{{item.key}}" bindtap="switchTab" aria-role="tab"><image wx:if="{{art[item.art]}}" class="art-icon art-20" src="{{art[item.art]}}" /><t-icon wx:else name="{{item.icon}}" size="16" />{{item.label}}<text wx:if="{{item.key==='fit'&&tab!=='fit'&&(person||garment)}}" class="tab-count">{{(person?1:0)+(garment?1:0)}}/2</text></view>
  </view>

  <block wx:if="{{tab==='gallery'}}">
    <scroll-view wx:if="{{categories.length&&!mine}}" scroll-x enhanced show-scrollbar="{{false}}" class="tryon-chips">
      <view class="chip-row">
        <view class="chip {{category===''?'on':''}}" data-name="" bindtap="chooseCategory"><image wx:if="{{art.all}}" class="chip-art" src="{{art.all}}" mode="aspectFill" /><view wx:else class="chip-art"><t-icon name="app" size="14" /></view>全部</view>
        <view wx:for="{{categories}}" wx:key="name" class="chip {{category===item.name?'on':''}}" data-name="{{item.name}}" bindtap="chooseCategory"><image wx:if="{{item.image}}" class="chip-art" src="{{item.image}}" mode="aspectFill" />{{item.name}}</view>
      </view>
    </scroll-view>
    <view class="tryon-bar">
      <text class="tryon-count">{{mine?'我的服装 '+myOutfits.length+' 件':(galleryError||galleryLoading&&!outfits.length?'':'共'+total+'项')}}</text>
      <block wx:if="{{!mine}}">
        <view class="tryon-tool" bindtap="chooseSort" aria-role="button" aria-label="{{sortLabel}}">{{sort==='newest'?'最新':'排序'}}<view class="tryon-caret"><t-icon name="chevron-down" size="12" /></view></view>
        <view class="tryon-tool {{randomBusy?'is-busy':''}}" bindtap="random" aria-role="button"><image wx:if="{{art.dice}}" class="art-icon art-18" src="{{art.dice}}" /><t-icon wx:else name="refresh" size="14" />随机</view>
      </block>
      <view class="tryon-tool mine-tool {{mine?'on':''}}" bindtap="toggleMine" aria-role="button"><image wx:if="{{art.fit}}" class="art-icon art-18" src="{{art.fit}}" /><t-icon wx:else name="user" size="14" />{{mine?'服装库':'我的'}}</view>
    </view>
    <block wx:if="{{mine}}">
      <view class="outfit-grid">
        <view class="mine-add {{myBusy==='upload'?'is-busy':''}}" bindtap="uploadMine" hover-class="card-pressed" aria-role="button">
          <view class="mine-add-inner">
            <view class="mine-add-art"><image wx:if="{{art.upload}}" class="art-icon art-44" src="{{art.upload}}" /><t-icon wx:else name="upload" size="32" /></view>
            <text class="mine-add-title">{{myBusy==='upload'?'上传中…':'自己上传'}}</text>
            <text class="mine-add-note">直接用你的服装照片</text>
          </view>
        </view>
        <view class="mine-add ai {{myBusy==='ai'?'is-busy':''}}" bindtap="aiMine" hover-class="card-pressed" aria-role="button">
          <view class="mine-add-inner">
            <view class="mine-add-art"><image wx:if="{{art.gallery}}" class="art-icon art-44" src="{{art.gallery}}" /><t-icon wx:else name="image" size="32" /></view>
            <text class="mine-add-title">{{myBusy==='ai'?'处理中…':'AI 生成'}}</text>
            <text class="mine-add-note">上传整套穿搭照，生成同款服装图</text>
          </view>
        </view>
        <view wx:for="{{myOutfits}}" wx:key="id" class="outfit" data-id="{{item.id}}" bindtap="wearMine" hover-class="card-pressed" aria-role="button" aria-label="{{item.title}}">
          <view class="outfit-photo">
            <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" lazy-load />
            <view wx:if="{{item.status!=='ready'}}" class="mine-state {{item.status}}"><t-loading wx:if="{{item.status==='drawing'}}" size="22px" /><text>{{item.status==='drawing'?'生成中':'生成失败'}}</text></view>
            <view wx:if="{{item.status==='ready'}}" class="outfit-wear"><image wx:if="{{art.fit}}" class="art-icon art-14" src="{{art.fit}}" /><t-icon wx:else name="user-add" size="14" />试穿</view>
            <view class="outfit-heart" data-id="{{item.id}}" catchtap="deleteMine" aria-role="button" aria-label="删除"><t-icon name="delete" size="16" /></view>
          </view>
          <text class="outfit-title">{{item.title}}</text>
          <text class="outfit-desc">{{item.status==='failed'?(item.error||'可删除后重试'):item.source==='ai'?'AI 生成':'自己上传'}}</text>
        </view>
        <block wx:if="{{myLoading&&!myOutfits.length}}"><view wx:for="{{[0,1]}}" wx:key="*this" class="outfit"><view class="outfit-photo skeleton" /></view></block>
      </view>
    </block>
    <block wx:else>
    <view wx:if="{{galleryError}}" class="biz-error" bindtap="retryGallery">{{galleryError}} · 点击重试</view>
    <view class="outfit-grid">
      <template wx:for="{{outfits}}" wx:key="id" is="outfit" data="{{item, favored, art}}" />
      <block wx:if="{{galleryLoading&&!outfits.length}}">
        <view wx:for="{{[0,1,2,3]}}" wx:key="*this" class="outfit"><view class="outfit-photo skeleton" /></view>
      </block>
    </view>
    <view wx:if="{{!galleryLoading&&!galleryError&&!outfits.length}}" class="tryon-empty">
      <image wx:if="{{art.emptyRack}}" class="empty-art" src="{{art.emptyRack}}" mode="aspectFit" />
      <view wx:else class="empty-icon"><t-icon name="image" size="28" /></view>
      <text class="biz-note">暂无服装，可以上传自己的服装图试穿</text>
      <text class="empty-action" data-key="fit" bindtap="switchTab">去试穿</text>
    </view>
    <text wx:elif="{{outfits.length&&galleryLoading}}" class="biz-note tryon-more">加载中…</text>
    <text wx:elif="{{outfits.length&&outfits.length>=total}}" class="biz-note tryon-more">已经到底了</text>
    </block>
  </block>

  <block wx:elif="{{tab==='fit'}}">
    <view class="biz-card fit-pair">
      <view class="fit-col">
        <view class="fit-label"><text class="step">1</text>人物照片</view>
        <view wx:if="{{person}}" class="fit-slot">
          <image class="fit-photo" src="{{person.url}}" mode="aspectFill" />
          <view wx:if="{{!starting}}" class="fit-remove" catchtap="removePerson" aria-role="button" aria-label="删除人物照片">×</view>
        </view>
        <view wx:else class="fit-slot fit-add {{art.person?'has-art':''}} {{personBusy?'is-busy':''}}" bindtap="choosePerson" aria-role="button">
          <image wx:if="{{art.person}}" class="slot-art" src="{{art.person}}" mode="aspectFill" />
          <view class="slot-icon"><t-icon name="{{personBusy?'time':'user-add'}}" size="28" /></view>
          <text class="slot-text">{{personBusy?'上传中…':'上传人物照'}}</text>
        </view>
        <view class="fit-actions">
          <text wx:if="{{person}}" class="fit-link {{personBusy?'is-busy':''}}" bindtap="choosePerson"><image wx:if="{{art.upload}}" class="art-icon art-16" src="{{art.upload}}" /><t-icon wx:else name="refresh" size="14" />{{personBusy?'上传中':'更换'}}</text>
          <text wx:else class="fit-tip">正面、光线清晰</text>
        </view>
      </view>
      <view class="fit-col">
        <view class="fit-label"><text class="step">2</text>服装</view>
        <view wx:if="{{garment}}" class="fit-slot" bindtap="chooseGarment" aria-role="button" aria-label="更换服装">
          <image class="fit-photo" src="{{garment.url}}" mode="aspectFill" />
          <view wx:if="{{!starting}}" class="fit-remove" catchtap="removeGarment" aria-role="button" aria-label="移除服装">×</view>
          <text wx:if="{{garment.title}}" class="fit-name">{{garment.title}}</text>
        </view>
        <view wx:else class="fit-slot fit-add {{art.outfit?'has-art':''}} {{garmentBusy?'is-busy':''}}" bindtap="chooseGarment" aria-role="button" aria-label="选择服装：从服装库中选或自己上传">
          <image wx:if="{{art.outfit}}" class="slot-art" src="{{art.outfit}}" mode="aspectFill" />
          <view class="slot-icon"><t-icon name="image" size="28" /></view>
          <text class="slot-text">{{garmentBusy?'上传中…':'选择服装'}}</text>
        </view>
        <view class="fit-actions">
          <text wx:if="{{garment}}" class="fit-link {{garmentBusy?'is-busy':''}}" bindtap="chooseGarment"><image wx:if="{{art.upload}}" class="art-icon art-16" src="{{art.upload}}" /><t-icon wx:else name="refresh" size="14" />{{garmentBusy?'上传中':'更换'}}</text>
          <text wx:else class="fit-tip">服装库或自己上传</text>
        </view>
      </view>
    </view>
    <view class="biz-card fit-option">
      <image wx:if="{{art.keepBg}}" class="option-icon" src="{{art.keepBg}}" mode="aspectFill" />
      <view wx:else class="option-icon"><t-icon name="image" size="20" /></view>
      <view class="option-text">
        <text>保留原背景与光线</text>
        <text class="option-note">{{keepBackground?'只换衣服，场景不变':'换成干净的影棚背景'}}</text>
      </view>
      <switch checked="{{keepBackground}}" color="#00c8dc" disabled="{{starting}}" bindchange="toggleBackground" />
    </view>
    <button class="biz-action" loading="{{starting}}" disabled="{{starting||personBusy||garmentBusy}}" bindtap="startFitting">开始试穿</button>
    <text class="biz-note fit-note {{person&&garment?'':'is-todo'}}">{{!person?'还差一张人物照片':!garment?'还差一件服装':'下一步选择模型和画幅后生成'}}</text>
  </block>

  <block wx:else>
    <view class="outfit-grid">
      <template wx:for="{{favorites}}" wx:key="id" is="outfit" data="{{item, favored, art}}" />
      <block wx:if="{{favoritesLoading&&!favorites.length}}">
        <view wx:for="{{[0,1]}}" wx:key="*this" class="outfit"><view class="outfit-photo skeleton" /></view>
      </block>
    </view>
    <view wx:if="{{!favoritesLoading&&!favorites.length}}" class="tryon-empty">
      <image wx:if="{{art.emptyFav}}" class="empty-art" src="{{art.emptyFav}}" mode="aspectFit" />
      <view wx:else class="empty-icon"><t-icon name="heart" size="28" /></view>
      <text class="biz-note">还没有收藏，点服装图上的 ♡ 收藏</text>
      <text class="empty-action" bindtap="browse">去逛逛</text>
    </view>
  </block>
</view>

<view wx:if="{{preview}}" class="outfit-mask" bindtap="closePreview">
  <view class="outfit-sheet" catchtap="noop">
    <view class="sheet-handle" bindtap="closePreview" aria-role="button" aria-label="关闭" />
    <image class="outfit-big" src="{{preview.image}}" mode="aspectFit" />
    <view class="sheet-head">
      <text class="sheet-title">{{preview.title}}</text>
      <text wx:if="{{preview.category}}" class="sheet-tag">{{preview.category}}</text>
    </view>
    <text wx:if="{{preview.description}}" class="sheet-desc">{{preview.description}}</text>
    <view class="sheet-actions">
      <button class="biz-action biz-secondary sheet-fav" data-id="{{preview.id}}" bindtap="favorite"><image wx:if="{{art.fav}}" class="art-icon art-20 {{favored[preview.id]?'':'is-off'}}" src="{{art.fav}}" /><view wx:else class="fav-icon {{favored[preview.id]?'on':''}}"><t-icon name="{{favored[preview.id]?'heart-filled':'heart'}}" size="18" /></view>{{favored[preview.id]?'已收藏':'收藏'}}</button>
      <button class="biz-action sheet-wear" data-id="{{preview.id}}" bindtap="wear">试穿这件</button>
    </view>
  </view>
</view>

<view wx:if="{{aiSheet}}" class="outfit-mask" bindtap="aiCancel">
  <view class="outfit-sheet ai-sheet" catchtap="noop">
    <view class="sheet-handle" bindtap="aiCancel" aria-role="button" aria-label="关闭" />
    <text class="ai-title">AI 生成服装图</text>
    <view class="ai-flow">
      <view class="ai-pic"><image src="{{aiSheet.url}}" mode="aspectFill" /><text>你的照片</text></view>
      <view class="ai-arrow"><t-icon name="chevron-right" size="20" /></view>
      <view class="ai-pic"><image wx:if="{{outfits[0].image}}" src="{{outfits[0].image}}" mode="aspectFill" /><text>生成效果示例</text></view>
    </view>
    <text class="ai-label">背景颜色</text>
    <view class="ai-chips">
      <text wx:for="{{backdrops}}" wx:key="*this" class="chip {{aiSheet.backdrop===index?'on':''}}" data-index="{{index}}" bindtap="aiBackdrop">{{item}}</text>
    </view>
    <text class="ai-label">提示词（可修改）</text>
    <prompt-editor class="ai-prompt" value="{{aiSheet.prompt}}" assets="{{aiSheet.refs}}" max="{{800}}" bind:input="aiPrompt" />
    <view class="sheet-actions">
      <button class="biz-action biz-secondary sheet-fav" bindtap="aiCancel">取消</button>
      <button class="biz-action sheet-wear" loading="{{myBusy==='ai'}}" disabled="{{myBusy==='ai'}}" bindtap="aiGenerate">生成</button>
    </view>
  </view>
</view>
