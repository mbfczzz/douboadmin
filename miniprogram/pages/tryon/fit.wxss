/* 试穿: two steps, the background switch, the start button; the preview sheet. */
.fit-pair {
  display: flex;
  gap: 12px;
}
.fit-col {
  flex: 1;
  min-width: 0;
}
.fit-label {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 10px;
  font-size: 15px;
  line-height: 21px;
  font-weight: 600;
}
.step {
  width: 18px;
  height: 18px;
  border-radius: 9px;
  text-align: center;
  font-size: 12px;
  line-height: 18px;
  color: var(--ui-on-brand);
  background: var(--ui-brand);
}
.fit-slot {
  position: relative;
  padding-top: 133%;
  border-radius: 12px;
  overflow: hidden;
  background: var(--ui-field);
}
.fit-photo {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}
.slot-icon,
.slot-text {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
}
.slot-icon {
  top: calc(50% - 26px);
  display: flex;
  color: var(--ui-muted);
}
.slot-text {
  top: calc(50% + 8px);
  white-space: nowrap;
  font-size: 13px;
  color: var(--ui-muted);
}
.fit-add.is-busy,
.fit-link.is-busy {
  opacity: 0.5;
}
.fit-remove {
  position: absolute;
  top: 6px;
  right: 6px;
  width: 22px;
  height: 22px;
  border-radius: 11px;
  line-height: 20px;
  text-align: center;
  font-size: 15px;
  color: #fff;
  background: #000000a0;
}
.fit-name {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16px 8px 6px;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 12px;
  line-height: 17px;
  color: #fff;
  background: linear-gradient(transparent, #000000b3);
}
.fit-actions {
  display: flex;
  gap: 12px;
  height: 20px;
  margin-top: 10px;
}
.fit-link {
  display: flex;
  align-items: center;
  gap: 2px;
  white-space: nowrap;
  font-size: 13px;
  line-height: 20px;
  color: var(--ui-link);
}
.fit-tip {
  font-size: 12px;
  line-height: 20px;
  color: var(--ui-muted);
}
.fit-option {
  display: flex;
  align-items: center;
  gap: 12px;
  padding-top: 14px;
  padding-bottom: 14px;
  font-size: 14px;
}
.option-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 36px;
  height: 36px;
  border-radius: 10px;
  color: var(--ui-brand);
  background: var(--ui-field);
}
.option-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.option-note {
  margin-top: 2px;
  font-size: 12px;
  color: var(--ui-muted);
}
.fit-note {
  text-align: center;
}
.fit-note.is-todo {
  color: var(--ui-warning);
}
.outfit-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100; /* above the nav bar (50) */
  display: flex;
  align-items: flex-end;
  background: #000000b3;
}
.outfit-sheet {
  width: 100%;
  box-sizing: border-box;
  padding: 0 20px calc(16px + env(safe-area-inset-bottom));
  border-radius: 20px 20px 0 0;
  background: var(--ui-sheet);
}
.outfit-big {
  display: block;
  margin-top: 8px;
  width: 100%;
  height: 56vh;
  max-height: 480px;
  border-radius: 12px;
  background: var(--ui-field);
}
.sheet-head {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 14px;
}
.sheet-title {
  flex: 1;
  font-size: 16px;
  line-height: 22px;
  font-weight: 600;
}
.sheet-tag {
  flex: none;
  padding: 2px 8px;
  border-radius: 6px;
  font-size: 12px;
  color: var(--ui-muted);
  background: var(--ui-field);
}
.sheet-desc {
  display: block;
  margin-top: 6px;
  font-size: 13px;
  line-height: 19px;
  color: var(--ui-muted);
}
.sheet-actions {
  display: flex;
  gap: 12px;
  margin-top: 4px;
}
button.sheet-fav {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
}
.fav-icon {
  display: flex;
}
.fav-icon.on {
  color: #ff5c7c;
}
button.sheet-wear {
  flex: 2;
}
