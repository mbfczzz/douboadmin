<view wx:if="{{mentionOpen}}" class="mention-measure" aria-hidden="true"><text>{{mentionPrefix}}</text><text class="mention-caret">@</text></view>
<cover-view wx:if="{{mentionOpen&&mentionReady}}" class="mention-popover" style="{{mentionStyle}}" catchtap="holdMentionTap">
  <cover-view class="mention-heading">
    <cover-view class="mention-title"><cover-view>引用素材</cover-view><cover-view class="mention-count">· 共 {{mentionItems.length}} 个</cover-view></cover-view>
    <cover-view class="mention-close" bindtap="closeMention" aria-role="button" aria-label="关闭引用素材">×</cover-view>
  </cover-view>
  <cover-view class="mention-options">
    <cover-view wx:for="{{mentionItems}}" wx:key="id" class="mention-option" data-index="{{index}}" bindtap="pickMention" aria-role="button" aria-label="{{'引用'+item.label}}">
      <cover-image class="mention-thumb" src="{{item.url||'/assets/glyphs/video-muted.png'}}" />
      <cover-view class="mention-copy">
        <cover-view class="mention-label">{{item.label}}</cover-view>
        <cover-view class="mention-hint">插入 @{{item.label}}</cover-view>
      </cover-view>
      <cover-view class="mention-use">引用</cover-view>
    </cover-view>
  </cover-view>
</cover-view>
