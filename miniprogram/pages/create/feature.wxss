/* Feature presets (剧情带货, 探店视频, AI证件照): a hint with "AI写剧本",
   or option chips that write the prompt. */
.feature-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 12px;
}
.feature-tip {
  flex: 1;
  min-width: 0;
  font-size: 12px;
  color: var(--ui-muted);
}
.script-button {
  flex: none;
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 7px 14px;
  border-radius: 999px;
  font-size: 13px;
  font-weight: 600;
  color: var(--ui-on-brand);
  background: var(--ui-brand);
}
.script-button.is-busy {
  opacity: 0.6;
  pointer-events: none;
}
.feature-option {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 12px;
}
.option-label {
  width: 40px;
  font-size: 13px;
  color: var(--ui-muted);
}
.option-chip {
  padding: 6px 14px;
  border-radius: 999px;
  font-size: 13px;
  color: var(--ui-link);
  background: var(--ui-surface);
}
.option-chip.active {
  color: var(--ui-on-brand);
  background: var(--ui-primary);
  font-weight: 600;
}
/* 热门案例: real hot videos to remake. */
.feature-cases {
  margin-bottom: 14px;
}
.feature-section {
  display: block;
  margin-bottom: 10px;
  font-size: 15px;
  font-weight: 600;
}
.cases-strip {
  margin: 0 -20px;
  white-space: nowrap;
}
.cases-row {
  display: inline-flex;
  gap: 10px;
  padding: 0 20px;
}
.case {
  flex: none;
  width: 84px;
  display: flex;
  flex-direction: column;
  gap: 6px;
  font-size: 12px;
  color: var(--ui-link);
}
.case image {
  width: 84px;
  height: 112px;
  border-radius: 10px;
  background: var(--ui-field);
}
.case text {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  text-align: center;
}
/* The picture entry, until the first one is added. */
.feature-upload {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 12px;
  padding: 12px;
  border: 1px dashed var(--ui-border);
  border-radius: 14px;
}
.upload-icon {
  flex: none;
  width: 76px;
  height: 76px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6px;
  border-radius: 12px;
  font-size: 12px;
  color: var(--ui-link);
  background: var(--ui-surface);
}
.upload-tip {
  flex: 1;
  font-size: 13px;
  line-height: 19px;
  color: var(--ui-muted);
}
.clear-prompt {
  flex: none;
  padding: 6px 4px;
  font-size: 13px;
  color: var(--ui-muted);
}
