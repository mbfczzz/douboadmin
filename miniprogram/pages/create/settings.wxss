.settings {
  margin-top: 16px;
}
.setting-title {
  display: block;
  font-size: 13px;
  font-weight: 400;
  line-height: 18px;
  margin: 24px 0 10px;
  color: var(--ui-muted);
}
.setting-title.first-setting {
  margin-top: 0;
}
.resolution-options {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
/* Equal widths, four to a row even at 320px (design: one row, gap 4). */
.resolution-option {
  flex: 1 1 0;
  min-width: 62px;
  min-height: var(--ui-touch-size);
  padding: 10px 6px;
  text-align: center;
  overflow-wrap: anywhere;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  color: #ffffff;
  background: var(--ui-surface);
  border: 0;
  border-radius: 10px;
}
.resolution-option.selected {
  color: #ffffff;
  background: #1d3650;
  font-weight: 600;
}
.duration-slider {
  margin: 0 10px;
  height: 24px;
}
.duration-limits {
  display: flex;
  justify-content: space-between;
  margin-top: 10px;
  font-size: 12px;
  color: var(--ui-muted);
}
.ratio-grid {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 8px;
}
.ratio {
  height: 58px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
  color: var(--ui-muted);
  background: var(--ui-surface);
  border: 0;
  border-radius: 12px;
}
.ratio.selected {
  color: #ffffff;
  background: #1d3650;
  box-shadow: inset 0 0 0 1.5px #ffffff;
}
.ratio-pressed {
  opacity: 0.75;
}
.ratio-label {
  font-size: 13px;
  line-height: 16px;
  font-weight: 500;
}
.selected .ratio-label {
  font-weight: 600;
}
.ratio-visual {
  width: 28px;
  height: 28px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8b9aab;
}
.ratio-shape {
  border: 1px solid #8b9aab;
  background: #13283d;
  border-radius: 2px;
}
.selected .ratio-visual {
  color: #ffffff;
}
.selected .ratio-shape {
  border-color: #ffffff;
  background: #ffffff14;
}
.shape-wide {
  width: 28px;
  height: 15.75px;
}
.shape-portrait {
  width: 15.75px;
  height: 28px;
}
.shape-square {
  width: 24px;
  height: 24px;
}
.shape-landscape {
  width: 28px;
  height: 21px;
}
.shape-photo {
  width: 21px;
  height: 28px;
}
.shape-cinema {
  width: 28px;
  height: 12px;
}
