/* A native cover layer stays visible above the focused textarea on iOS;
   texts get explicit widths, rows are 56 px (mention-position.ts). */
.mention-measure { position: absolute; top: 90px; left: 16px; width: calc(100% - 32px); font-size: 15px; line-height: 22px; white-space: pre-wrap; word-break: break-all; opacity: 0; pointer-events: none; }
.mention-caret { display: inline-block; }
.mention-popover { position: fixed; z-index: 1200; background: #2a2c32; border: 1px solid #3c3f47; border-radius: 14px; color: #f5f5f5; overflow: hidden; }
.mention-heading { display: flex; align-items: center; justify-content: space-between; height: 40px; padding: 0 8px 0 12px; border-bottom: 1px solid #34363d; }
.mention-title { display: flex; align-items: center; font-size: 13px; font-weight: 600; color: #ffffff; }
.mention-count { margin-left: 6px; font-size: 12px; font-weight: 400; color: #a6a8ad; }
.mention-close { width: 26px; height: 26px; border-radius: 13px; background: #3a3d45; text-align: center; line-height: 25px; font-size: 17px; color: #c9cbd0; }
.mention-options { max-height: 168px; overflow-y: scroll; }
.mention-option { display: flex; align-items: center; justify-content: space-between; height: 56px; padding: 0 10px 0 12px; }
.mention-thumb { width: 44px; height: 44px; border-radius: 10px; margin-right: 12px; flex-shrink: 0; }
.mention-copy { width: 116px; flex-shrink: 0; }
.mention-label { width: 116px; font-size: 14px; line-height: 20px; color: #ffffff; text-overflow: ellipsis; white-space: nowrap; overflow: hidden; }
.mention-hint { width: 116px; margin-top: 2px; font-size: 11px; line-height: 15px; color: #a6a8ad; text-overflow: ellipsis; white-space: nowrap; overflow: hidden; }
.mention-use { padding: 0 10px; height: 24px; line-height: 24px; border-radius: 12px; font-size: 12px; color: #00c8dc; background: rgba(0, 200, 220, 0.12); }
