/* A native cover layer stays visible above the focused textarea on iOS. */
.mention-measure { position: absolute; top: 90px; left: 16px; width: calc(100% - 32px); font-size: 15px; line-height: 22px; white-space: pre-wrap; word-break: break-all; opacity: 0; pointer-events: none; }
.mention-caret { display: inline-block; }
.mention-popover { position: fixed; z-index: 1200; background: #303239; border-radius: 12px; color: #f5f5f5; overflow: hidden; }
.mention-heading { display: flex; align-items: center; justify-content: space-between; height: 36px; padding: 0 10px; font-size: 12px; }
.mention-close { width: 32px; height: 32px; text-align: center; line-height: 32px; font-size: 22px; }
.mention-options { max-height: 120px; overflow-y: scroll; }
.mention-option { display: flex; align-items: center; min-height: 52px; padding: 6px 10px; font-size: 13px; }
.mention-thumb { width: 40px; height: 40px; border-radius: 6px; margin-right: 10px; }
