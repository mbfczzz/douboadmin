@import "./workspace.wxss";
@import "./settings.wxss";
@import "./menus.wxss";
.create-page {
  padding: 10px 20px calc(90px + env(safe-area-inset-bottom));
}
.mode-tabs {
  display: flex;
  height: 44px;
  gap: 6px;
  border-radius: 12px;
  background: transparent;
  margin-bottom: 16px;
}
.mode-tab {
  gap: 8px;
  position: relative;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 15px;
  line-height: 18px;
  font-weight: 500;
  border-radius: 10px;
  background: var(--ui-surface);
  color: var(--ui-muted);
}
.mode-tab.active {
  color: var(--ui-text);
  background: var(--ui-selected);
}
.mode-tab-pressed {
  opacity: 0.7;
}
.create-page .queue-link {
  height: 58px;
  padding: 0 16px;
  gap: 12px;
  margin-top: 16px;
  font-size: 15px;
}
.create-page .queue-link .copy .muted {
  margin-top: 3px;
}
.create-page .note {
  margin: 14px 0 0;
}
.creation-hint {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 10px;
  font-size: 13px;
  line-height: 18px;
  color: var(--ui-muted);
}
