@import "./workspace.wxss";
@import "./settings.wxss";
@import "./menus.wxss";
.create-page {
  padding: 10px 20px calc(90px + env(safe-area-inset-bottom));
}
.mode-tabs {
  display: flex;
  height: 42px;
  padding: 4px;
  gap: 4px;
  border-radius: 12px;
  background: var(--ui-surface);
  margin-bottom: 16px;
}
.mode-tab {
  position: relative;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  line-height: 18px;
  font-weight: 500;
  border-radius: 9px;
  color: #8b9aab;
}
.mode-tab.active {
  color: #ffffff;
  background: #1d3650;
  font-weight: 600;
}
.mode-tab-pressed {
  opacity: 0.7;
}
.create-page .queue-link {
  height: 58px;
  padding: 0 16px;
  gap: 12px;
  margin-top: 16px;
  border-radius: var(--ui-radius-card);
  font-size: 14px;
}
.creation-balance {
  margin-top: 24px;
}
.create-page .queue-link .copy .muted {
  font-size: 12px;
  margin-top: 3px;
}
.create-page .note {
  font-size: 12px;
  margin: 14px 0 0;
}
.creation-hint {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-top: 10px;
  font-size: 12px;
  line-height: 18px;
  color: var(--ui-muted);
}
.example-link {
  margin: -8px 0;
  padding: 12px 0;
  color: #ffffff;
  white-space: nowrap;
}
.creation-ideas {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  padding: 8px 0;
}
.creation-ideas view {
  background: var(--ui-surface);
  color: #a9b6c4;
  border-radius: 10px;
  padding: 8px 12px;
  font-size: 12px;
}
