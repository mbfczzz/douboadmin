@import "./workspace.wxss";
@import "./settings.wxss";
@import "./menus.wxss";
.create-page {
  padding: 10px 20px calc(90px + env(safe-area-inset-bottom));
}
.mode-tabs {
  display: flex;
  height: 42px;
  padding: 4px;
  gap: 4px;
  border-radius: 10px;
  background: var(--ui-surface);
  margin-bottom: 16px;
}
.mode-tab {
  position: relative;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  line-height: 18px;
  font-weight: 500;
  border-radius: 7px;
  color: #929fa4;
}
.mode-tab.active {
  color: #d7fce2;
  background: #25372c;
  font-weight: 700;
}
.mode-tab.active::after {
  content: "";
  position: absolute;
  left: 0;
  top: -1px;
  width: 100%;
  height: 2px;
  border-radius: 1px;
  background: var(--ui-brand);
}
.mode-tab-pressed {
  opacity: 0.7;
}
.create-page .queue-link {
  height: 58px;
  padding: 0 14px;
  gap: 12px;
  margin-top: 16px;
  border-radius: 10px;
  font-size: 14px;
}
.creation-balance {
  margin-top: 24px;
}
.create-page .queue-link .copy .muted {
  font-size: 12px;
  margin-top: 3px;
}
.create-page .note {
  font-size: 12px;
  margin: 14px 0 0;
}
.creation-hint {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-top: 10px;
  font-size: 12px;
  line-height: 18px;
  color: var(--ui-muted);
}
.example-link {
  margin: -8px 0;
  padding: 12px 0;
  color: #b1d8bd;
  white-space: nowrap;
}
.creation-ideas {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  padding: 8px 0;
}
.creation-ideas view {
  background: #202725;
  color: #b7c3bd;
  border-radius: 6px;
  padding: 8px;
  font-size: 12px;
}
