@import "./workspace.wxss";
@import "./settings.wxss";
@import "./menus.wxss";
.create-page {
  padding: 10px 20px calc(90px + env(safe-area-inset-bottom));
}
.mode-tabs {
  display: flex;
  height: 44px;
  border-bottom: 1px solid #2b3235;
  margin-bottom: 16px;
}
.mode-tab {
  position: relative;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 15px;
  line-height: 22px;
  font-weight: 400;
  color: #929fa4;
}
.mode-tab.active {
  color: #e9eceb;
  font-weight: 600;
}
.mode-tab.active::after {
  content: "";
  position: absolute;
  left: calc(50% - 14px);
  bottom: -1px;
  width: 28px;
  height: 2px;
  border-radius: 1px;
  background: #9bcbaa;
}
.mode-tab-pressed {
  opacity: 0.7;
}
.create-page .queue-link {
  height: 58px;
  padding: 0 14px;
  gap: 12px;
  margin-top: 28px;
  border-radius: 10px;
  font-size: 14px;
}
.create-page .queue-link .copy .muted {
  font-size: 12px;
  margin-top: 3px;
}
.create-page .note {
  font-size: 12px;
  margin: 14px 0 0;
}
.creation-hint {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-top: 10px;
  font-size: 12px;
  line-height: 18px;
  color: #a0a8ac;
}
.example-link {
  padding: 4px 0;
  color: #b1d8bd;
  white-space: nowrap;
}
.creation-ideas {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  padding: 8px 0;
}
.creation-ideas view {
  background: #202725;
  color: #b7c3bd;
  border-radius: 6px;
  padding: 8px;
  font-size: 12px;
}
