.model-mask {
  position: fixed;
  inset: 0;
  z-index: 1000;
}
.model-menu {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transform: translateY(-6px);
  transition:
    opacity 160ms ease,
    transform 160ms ease,
    visibility 0s linear 160ms;
  position: absolute;
  top: calc(100% - 12px);
  left: 14px;
  width: 248px;
  max-width: calc(100% - 28px);
  padding: 6px;
  border: 1px solid var(--ui-border);
  border-radius: 10px;
  background: var(--ui-surface);
  z-index: 1001;
  box-shadow: 0 8px 24px #00000066;
}
.model-menu.is-open {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
  transform: none;
  transition-delay: 0s;
}
@media (prefers-reduced-motion: reduce) {
  .model-menu {
    transition: none;
    transform: none;
  }
}
.model-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  min-height: 48px;
  padding: 6px 12px;
  border-radius: 8px;
  font-size: 15px;
}
.workspace.expanded.model-open {
  z-index: 1001;
}
.model-menu.menu-up {
  top: auto;
  bottom: 68px;
}
/* Name and badges share one line (design: gap 8), description below. */
.model-title {
  display: flex;
  align-items: center;
  gap: 8px;
  min-width: 0;
}
.model-title > text {
  overflow: hidden;
  min-width: 0;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.model-option.selected {
  background: var(--ui-selected);
  color: var(--ui-link);
}
.model-option t-icon {
  color: var(--ui-text);
}
.reference-sheet {
  padding: 0 20px 20px;
}
.reference-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20px;
  font-size: 16px;
  font-weight: 500;
}
.close-sheet {
  flex-shrink: 0;
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.model-logo {
  width: 22px;
  height: 22px;
  flex-shrink: 0;
  background: #fff;
  border-radius: 4px;
  padding: 2px;
}
.model-info {
  overflow: hidden;
  overflow-wrap: anywhere;
  flex: 1;
  min-width: 0;
}
/* One-line subtitle so each option stays close to the designed 48px row. */
.model-description {
  display: block;
  overflow: hidden;
  font-size: var(--ui-font-note);
  color: var(--ui-muted);
  margin-top: 2px;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.model-estimate {
  flex-shrink: 0;
  max-width: 30%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  text-align: right;
  font-size: var(--ui-font-caption);
  color: var(--ui-muted);
}
/* Price shares the description line; the name keeps the full width. */
.model-sub {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 2px;
}
.model-sub .model-description {
  flex: 1;
  margin-top: 0;
}
.model-sub .model-estimate {
  max-width: none;
}
.model-badges {
  display: flex;
  flex-shrink: 0;
  gap: 4px;
  white-space: nowrap;
}
.model-badges text {
  font-size: var(--ui-font-caption);
  padding: 2px 4px;
  background: var(--ui-field);
  color: var(--ui-muted);
  border-radius: 4px;
}
.model-badges .hot {
  background: var(--ui-points-bg);
  color: var(--ui-points);
}
.model-badges .new {
  background: var(--ui-selected);
  color: var(--ui-text);
}
.model-glyph {
  width: 22px;
  font-size: 20px;
  text-align: center;
  flex-shrink: 0;
}
