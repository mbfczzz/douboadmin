.model-mask {
  position: fixed;
  inset: 0;
  z-index: 1000;
}
.model-menu {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transform: translateY(-6px);
  transition:
    opacity 160ms ease,
    transform 160ms ease,
    visibility 0s linear 160ms;
  position: absolute;
  top: calc(100% - 8px);
  left: 14px;
  width: 248px;
  max-width: calc(100% - 28px);
  padding: 6px;
  border: 1px solid var(--ui-border);
  border-radius: 10px;
  background: var(--ui-surface);
  z-index: 1001;
  box-shadow: 0 8px 24px #00000040;
}
.model-menu.is-open {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
  transform: none;
  transition-delay: 0s;
}
@media (prefers-reduced-motion: reduce) {
  .model-menu {
    transition: none;
    transform: none;
  }
}
.model-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  min-height: 48px;
  padding: 6px 12px;
  border-radius: 7px;
  font-size: 15px;
}
.workspace.expanded.model-open {
  z-index: 1001;
}
.model-menu.menu-up {
  top: auto;
  bottom: 64px;
}
/* Name and badges share one line (design: gap 8), description below. */
.model-title {
  display: flex;
  align-items: center;
  gap: 8px;
  min-width: 0;
}
.model-title > text {
  overflow: hidden;
  min-width: 0;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.model-option.selected {
  background: #2e2e2e;
}
.model-option t-icon {
  color: #ffffff;
}
.reference-sheet {
  padding: 16px 20px calc(24px + env(safe-area-inset-bottom));
}
.reference-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20px;
  font-size: 19px;
  font-weight: 600;
}
.close-sheet {
  flex-shrink: 0;
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.source-option {
  display: flex;
  align-items: center;
  gap: 14px;
  min-height: 72px;
  padding: 12px;
  margin-top: 8px;
  border-radius: 10px;
  background: var(--ui-field);
  font-size: 16px;
}
.source-copy {
  flex: 1;
  min-width: 0;
  overflow-wrap: anywhere;
}
.source-hint {
  display: block;
  margin-top: 5px;
  font-size: 12px;
  color: var(--ui-muted);
}
.model-logo {
  width: 22px;
  height: 22px;
  flex-shrink: 0;
  background: #fff;
  border-radius: 4px;
  padding: 2px;
}
.model-info {
  overflow: hidden;
  overflow-wrap: anywhere;
  flex: 1;
  min-width: 0;
}
/* One-line subtitle so each option stays close to the designed 48px row. */
.model-description {
  display: block;
  overflow: hidden;
  font-size: var(--ui-font-note);
  color: #a6a6a6;
  margin-top: 2px;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.model-estimate {
  flex-shrink: 0;
  max-width: 30%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  text-align: right;
  font-size: var(--ui-font-caption);
  color: #a6a6a6;
}
.model-badges {
  display: flex;
  flex-shrink: 0;
  gap: 4px;
  white-space: nowrap;
}
.model-badges text {
  font-size: var(--ui-font-caption);
  padding: 2px 4px;
  background: #262626;
  color: #b3b3b3;
  border-radius: 3px;
}
.model-badges .hot {
  background: #33141b;
  color: #ff3355;
}
.model-badges .new {
  background: #ffffff14;
  color: #ffffffcc;
}
.model-glyph {
  width: 22px;
  font-size: 20px;
  text-align: center;
  flex-shrink: 0;
}
