<nav-bar title="创作" />
<view class="page create-page">
  <view class="mode-tabs {{busy||uploading||restoring?'controls-busy':''}}">
    <view
      class="mode-tab {{kind==='video'?'active':''}}"
      data-kind="video"
      aria-role="button"
      aria-label="{{'生成视频'+(kind==='video'?'，已选中':'')}}"
      bindtap="mode"
      hover-class="mode-tab-pressed"
    >
      生成视频
    </view>
    <view
      class="mode-tab {{kind==='image'?'active':''}}"
      data-kind="image"
      aria-role="button"
      aria-label="{{'生成图片'+(kind==='image'?'，已选中':'')}}"
      bindtap="mode"
      hover-class="mode-tab-pressed"
    >
      生成图片
    </view>
  </view>
  <view wx:if="{{modelError}}" class="error-box" bindtap="loadModels">{{modelError}}</view>
  <view wx:if="{{parameterError}}" class="error-box">{{parameterError}}</view>
  <view class="workspace {{expanded?'expanded':''}} {{showModels?'model-open':''}}" style="{{expanded&&expandedTop?'top:'+expandedTop+'px':''}}">
    <scroll-view scroll-x class="reference-strip">
      <view class="reference-items">
        <view
          wx:if="{{allowImage||allowVideo||allowAudio}}"
          class="add-reference"
          aria-role="button"
          bindtap="showAssets"
          aria-label="添加参考素材"
        >
          <t-icon name="{{uploading?'time':'add'}}" size="20" />
          <text class="add-label">{{uploading?'上传中':'添加参考'}}</text>
        </view>
        <view class="reference" wx:for="{{assets}}" wx:key="id">
          <image
            wx:if="{{item.isImage}}"
            src="{{item.data.url}}"
            data-id="{{item.id}}"
            bindtap="previewReference"
            mode="aspectFill"
          />
          <t-icon wx:else name="file" size="24" />
          <view class="reference-remove" data-id="{{item.id}}" catchtap="remove" aria-role="button" aria-label="删除参考素材"
            ><t-icon name="close" size="12"
          /></view>
        </view>
      </view>
    </scroll-view>
    <view
      class="expand-editor"
      bindtap="toggleExpanded"
      aria-label="{{expanded?'收起输入框':'展开输入框'}}"
    >
      <t-icon name="{{expanded?'fullscreen-exit':'fullscreen'}}" size="18" />
    </view>
    <view class="editor">
      <textarea
        class="prompt-input"
        value="{{prompt}}"
        cursor="{{promptCursor}}"
        maxlength="{{prompt.length>maxPromptChars?prompt.length:maxPromptChars}}"
        placeholder="{{kind==='video'?videoPlaceholder:imagePlaceholder}}"
        placeholder-class="prompt-placeholder"
        bindinput="input"
        cursor-spacing="100"
        fixed="{{expanded}}"
      />
      <view class="quote-note {{quoteUnits>0?'has-cost':''}} {{quoteError?'quote-retry':''}}" bindtap="retryEstimate" aria-role="{{quoteError?'button':'text'}}" aria-label="{{quoteText}}">{{quoteText}}</view>
      <view class="count">{{prompt.length}} / {{maxPromptChars}}</view>
    </view>
    <view class="workspace-foot">
      <view class="model-select" bindtap="showModels" aria-role="button" aria-label="{{'选择模型，当前'+modelName}}">
        <template is="model-icon" data="{{...availableModels[modelIndex],kind}}" />
        <text class="model-name">{{modelName}}</text>
        <t-icon name="chevron-down" size="14" />
      </view>
      <text class="spec"
        >{{resolution}} · {{kind==='video'?duration+'秒':ratio}}</text
      >
      <button
        class="generate-button {{busy||uploading||restoring||modelsLoading||modelError||parameterError||restoreError||!hasPrompt?'is-disabled':''}}"
        loading="{{busy}}"
        disabled="{{busy||uploading||restoring||modelsLoading||modelError||parameterError||restoreError||!hasPrompt}}"
        bindtap="generate"
      >
        生成
      </button>
    </view>
    <scroll-view scroll-y class="model-menu {{showModels?'is-open':''}} {{modelMenuUp?'menu-up':''}}" style="height:{{modelMenuHeight||240}}px" aria-hidden="{{!showModels}}">
      <view
        class="model-option {{model===item.id?'selected':''}}"
        wx:for="{{availableModels}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="selectModel"
        aria-role="button"
        aria-label="{{item.label+(item.description?'，'+item.description:'')+(model===item.id?'，已选中':'')}}"
      >
        <template is="model-icon" data="{{...item,kind}}" />
        <view class="model-info"><view class="model-title"><text>{{item.label}}</text><view wx:if="{{item.badges.length}}" class="model-badges"><text wx:for="{{item.badges}}" wx:for-item="badge" wx:key="id" class="{{badge.tone}}">{{badge.text}}</text></view></view><text wx:if="{{item.description}}" class="model-description">{{item.description}}</text></view>
        <text wx:if="{{item.estimate}}" class="model-estimate">{{item.estimate}}</text>
        <t-icon wx:if="{{model===item.id}}" name="check" size="18" />
      </view>
    </scroll-view>
  </view>
  <view class="creation-hint">
    <text>{{modelsLoading?'正在准备模型参数':modelError?'请选择可用模型':parameterError?'请调整创作参数':'参数已选好，可以直接生成'}}</text>
    <view wx:if="{{!hasPrompt}}" class="example-link" bindtap="useExample" hover-class="card-pressed">试试示例 ›</view>
  </view>
  <view wx:if="{{ideas.length&&!hasPrompt}}" class="creation-ideas"><view wx:for="{{ideas}}" wx:key="*this" data-value="{{item}}" bindtap="useExample">{{item}}</view></view>
  <view wx:if="{{restoring}}" class="note">正在恢复参考素材…</view>
  <view wx:if="{{restoreError}}" class="error-box">
    <text>{{restoreError}}</text>
    <view class="recovery-actions">
      <text bindtap="retryAssets">重新加载</text>
      <text bindtap="clearReferences">清空重选</text>
    </view>
  </view>
  <view class="settings {{modelsLoading||busy?'controls-busy':''}}">
    <text wx:if="{{resolutions.length}}" class="setting-title first-setting">分辨率</text>
    <view class="resolution-options">
      <view
        class="resolution-option {{resolution===item?'selected':''}}"
        wx:for="{{resolutions}}"
        wx:key="*this"
        data-value="{{item}}"
        bindtap="chooseResolution"
        aria-role="button"
        aria-label="{{item+(resolution===item?'，已选中':'')}}"
      >
        {{item}}
      </view>
    </view>
    <block wx:if="{{kind==='video'&&durations.length}}">
      <text class="setting-title">视频时长 · {{duration}} 秒</text>
      <slider
        wx:if="{{durations.length>1}}"
        class="duration-slider"
        min="0"
        max="{{durations.length-1}}"
        step="1"
        value="{{durationIndex}}"
        activeColor="#00c8dc"
        backgroundColor="#272b34"
        block-color="#00c8dc"
        block-size="20"
        bindchange="duration"
        bindchanging="duration"
      />
      <view wx:if="{{durations.length>1}}" class="duration-limits">
        <text>{{durations[0]}} 秒</text>
        <text>{{durations[durations.length-1]}} 秒</text>
      </view>
    </block>
    <block wx:if="{{qualities.length}}"><text class="setting-title">画面质量</text><view class="resolution-options"><view wx:for="{{qualities}}" wx:key="*this" class="resolution-option {{quality===item?'selected':''}}" data-value="{{item}}" bindtap="chooseQuality">{{item==='low'?'标准':item==='medium'?'精细':item==='high'?'高清':item}}</view></view></block>
    <text wx:if="{{ratios.length}}" class="setting-title">选择画幅</text>
    <view class="ratio-grid">
      <view
        wx:for="{{ratios}}"
        wx:key="*this"
        class="ratio {{ratio===item?'selected':''}}"
        data-value="{{item}}"
        bindtap="chooseRatio"
        aria-role="button"
        aria-label="{{item+(ratio===item?'，已选中':'')}}"
        hover-class="ratio-pressed"
      >
        <view class="ratio-visual">
          <t-icon wx:if="{{item==='auto'}}" name="scan" size="22" />
          <view
            wx:else
            class="ratio-shape shape-{{item==='16:9'?'wide':item==='9:16'?'portrait':item==='1:1'?'square':item==='4:3'?'landscape':item==='3:4'?'photo':'cinema'}}"
          />
        </view>
        <text class="ratio-label">{{item==='auto'?'自适应':item}}</text>
      </view>
    </view>
  </view>
  <view class="creation-balance"><points-balance /></view>
  <view class="queue-link" bindtap="queue">
    <t-icon name="task" size="22" />
    <view class="copy">
      <text>任务队列</text>
      <text class="muted">查看生成进度与结果</text>
    </view>
    <t-icon name="chevron-right" size="20" />
  </view>

</view>
<view class="model-mask" wx:if="{{showModels}}" bindtap="closeModels" />
<t-popup
  visible="{{assetsOpen}}"
  placement="bottom"
  bind:visible-change="closeAssets"
>
  <view class="reference-sheet">
    <view class="reference-heading"
      ><text>添加参考素材</text
      ><view class="close-sheet" bindtap="closeAssets"
        ><t-icon name="close" size="20" /></view
    ></view>
    <view wx:if="{{allowImage}}" class="source-option" data-kind="image" bindtap="addAsset"
      ><t-icon name="image" size="24" /><view class="source-copy"
        ><text>图片</text><text class="source-hint">从相册选择图片</text></view
      ><t-icon name="chevron-right" size="18"
    /></view>
    <view wx:if="{{allowVideo}}" class="source-option" data-kind="video" bindtap="addAsset"><t-icon name="video-camera" size="24" /><view class="source-copy"><text>视频</text><text class="source-hint">从相册选择参考视频</text></view><t-icon name="chevron-right" size="18" /></view>
    <view wx:if="{{allowAudio}}" class="source-option" data-kind="audio" bindtap="addAsset"><t-icon name="sound" size="24" /><view class="source-copy"><text>音频</text><text class="source-hint">选择参考音频文件</text></view><t-icon name="chevron-right" size="18" /></view>
  </view>
</t-popup>
<template name="model-icon">
  <image wx:if="{{iconURL}}" class="model-logo" src="{{iconURL}}" mode="aspectFit" data-id="{{id}}" data-url="{{iconURL}}" binderror="hideModelIcon" />
  <text wx:elif="{{icon}}" class="model-glyph">{{icon}}</text>
  <t-icon wx:else name="{{kind==='video'?'video-camera':'image'}}" size="22" />
</template>
