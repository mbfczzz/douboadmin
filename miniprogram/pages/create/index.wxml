<nav-bar title="创作" />
<view class="page create-page">
  <view class="mode-tabs {{busy||uploading||restoring?'controls-busy':''}}">
    <view
      class="mode-tab {{kind==='video'?'active':''}}"
      data-kind="video"
      aria-role="button"
      aria-label="{{'生成视频'+(kind==='video'?'，已选中':'')}}"
      bindtap="mode"
      hover-class="mode-tab-pressed"
    >
      <t-icon name="video-camera" size="20" />生成视频
    </view>
    <view
      class="mode-tab {{kind==='image'?'active':''}}"
      data-kind="image"
      aria-role="button"
      aria-label="{{'生成图片'+(kind==='image'?'，已选中':'')}}"
      bindtap="mode"
      hover-class="mode-tab-pressed"
    >
      <t-icon name="image" size="20" />生成图片
    </view>
  </view>
  <view wx:if="{{modelError}}" class="error-box" bindtap="loadModels">{{modelError}}</view>
  <view wx:elif="{{parameterError}}" class="error-box">{{parameterError}}</view>
  <view class="workspace {{expanded?'expanded':''}} {{showModels?'model-open':''}}" style="{{expanded&&expandedTop?'top:'+expandedTop+'px':''}}">
    <scroll-view scroll-x class="reference-strip">
      <view class="reference-items">
        <view
          wx:if="{{allowImage||allowVideo||allowAudio}}"
          class="add-reference"
          aria-role="button"
          bindtap="showAssets"
          aria-label="添加参考素材"
        >
          <t-icon name="{{uploading?'time':'add'}}" size="20" />
          <text class="add-label">{{uploading?'上传中':'添加参考'}}</text>
        </view>
        <view class="reference" wx:for="{{assets}}" wx:key="id">
          <image
            wx:if="{{item.isImage}}"
            src="{{item.data.url}}"
            data-id="{{item.id}}"
            bindtap="previewReference"
            mode="aspectFill"
          />
          <t-icon wx:else name="file" size="24" />
          <view class="reference-remove" data-id="{{item.id}}" catchtap="remove" aria-role="button" aria-label="删除参考素材"
            ><t-icon name="close" size="16"
          /></view>
        </view>
      </view>
    </scroll-view>
    <view
      class="expand-editor"
      bindtap="toggleExpanded"
      aria-label="{{expanded?'收起输入框':'展开输入框'}}"
    >
      <t-icon name="{{expanded?'fullscreen-exit':'fullscreen'}}" size="20" />
    </view>
    <view class="editor">
      <textarea
        class="prompt-input"
        value="{{prompt}}"
        cursor="{{promptCursor}}"
        maxlength="{{prompt.length>maxPromptChars?prompt.length:maxPromptChars}}"
        placeholder="{{kind==='video'?videoPlaceholder:imagePlaceholder}}"
        placeholder-class="prompt-placeholder"
        bindinput="input"
        cursor-spacing="120"
        fixed="{{expanded}}"
      />
      <text class="count">{{prompt.length}} / {{maxPromptChars}}</text>
      <view class="editor-meta">
        <view class="editor-balance"><points-balance compact /></view>
        <view class="quote-note {{quoteError?'quote-retry':hasPrompt?'':'quote-idle'}}" bindtap="retryEstimate" aria-role="{{quoteError?'button':'text'}}" aria-label="{{quoteText}}">{{quoteError?'估价失败 · 重试':quoteText}}</view>
      </view>
    </view>
    <view class="workspace-foot">
      <view class="model-select" bindtap="showModels" aria-role="button" aria-label="{{'选择模型，当前'+modelName}}">
        <template is="model-icon" data="{{...availableModels[modelIndex],kind}}" />
        <view class="model-copy"><text class="model-name">{{modelName}}</text></view>
        <t-icon name="chevron-down" size="16" />
      </view>
      <template is="generate-action" data="{{busy,uploading,restoring,modelsLoading,modelError,parameterError,restoreError,hasPrompt,kind}}" />
    </view>
    <scroll-view scroll-y class="model-menu {{showModels?'is-open':''}} {{modelMenuUp?'menu-up':''}}" style="height:{{modelMenuHeight||240}}px" aria-hidden="{{!showModels}}">
      <view
        class="model-option {{model===item.id?'selected':''}}"
        wx:for="{{availableModels}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="selectModel"
        aria-role="button"
        aria-label="{{item.label+(item.description?'，'+item.description:'')+(model===item.id?'，已选中':'')}}"
      >
        <template is="model-icon" data="{{...item,kind}}" />
        <view class="model-info"><view class="model-title"><text>{{item.label}}</text><view wx:if="{{item.badges.length}}" class="model-badges"><text wx:for="{{item.badges}}" wx:for-item="badge" wx:key="id" class="{{badge.tone}}">{{badge.text}}</text></view></view><view wx:if="{{item.description||item.estimate}}" class="model-sub"><text class="model-description">{{item.description}}</text><text wx:if="{{item.estimate}}" class="model-estimate">{{item.estimate}}</text></view></view>
        <t-icon wx:if="{{model===item.id}}" name="check" size="20" />
      </view>
    </scroll-view>
  </view>
  <view class="creation-hint">
    <block wx:if="{{assets.length}}"><t-icon name="mentioned" size="16" /><text>输入 @ 可引用已上传的图片</text></block>
    <text class="queue-text" bindtap="queue">任务队列 ›</text>
  </view>
  <view wx:if="{{restoring}}" class="note">正在恢复参考素材…</view>
  <view wx:if="{{restoreError}}" class="error-box">
    <text>{{restoreError}}</text>
    <view class="recovery-actions">
      <text bindtap="retryAssets">重新加载</text>
      <text bindtap="clearReferences">清空重选</text>
    </view>
  </view>
  <view class="params-row {{modelsLoading||busy?'controls-busy':''}}" bindtap="openParams" aria-role="button" aria-label="{{'调整参数，当前'+resolution}}">
    <view class="params-icon"><t-icon name="adjustment" size="20" /></view>
    <view class="params-copy">
      <text class="params-spec">{{resolution}}<block wx:if="{{kind==='video'&&durations.length}}"> · {{duration}} 秒</block><block wx:if="{{ratios.length}}"> · {{ratio==='auto'?'自适应':ratio}}</block><block wx:if="{{qualities.length}}"> · {{quality==='low'?'标准':quality==='medium'?'精细':quality==='high'?'高清':quality}}</block></text>
    </view>
    <text class="params-go">调整 ›</text>
  </view>
  <view class="inspire-head"><text>灵感 · 做同款</text><text class="inspire-more" bindtap="templates">全部模板 ›</text></view>
  <showcase mode="strip" />

</view>
<view class="model-mask" wx:if="{{showModels}}" bindtap="closeModels" />
<include src="./parts/sheets.wxml" />
<template name="generate-action">
  <button class="generate-button {{busy||uploading||restoring||modelsLoading||modelError||parameterError||restoreError||!hasPrompt?'is-disabled':''}}" loading="{{busy}}" disabled="{{busy||uploading||restoring||modelsLoading||modelError||parameterError||restoreError||!hasPrompt}}" bindtap="generate" aria-label="{{kind==='video'?'生成视频':'生成图片'}}">
    <text>生成</text>
  </button>
</template>
<template name="model-icon">
  <image wx:if="{{iconURL}}" class="model-logo" src="{{iconURL}}" mode="aspectFit" data-id="{{id}}" data-url="{{iconURL}}" binderror="hideModelIcon" />
  <text wx:elif="{{icon}}" class="model-glyph">{{icon}}</text>
  <t-icon wx:else name="{{kind==='video'?'video-camera':'image'}}" size="20" />
</template>
<ui-dialog id="ui-dialog" />
