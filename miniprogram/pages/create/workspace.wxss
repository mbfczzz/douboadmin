.workspace {
  position: relative;
  height: 300px;
  border: 1px solid #353b3e;
  border-radius: 16px;
  background: #1c1f21;
}
.reference-strip {
  position: absolute;
  top: 14px;
  left: 14px;
  width: calc(100% - 62px);
  height: 64px;
  white-space: nowrap;
}
.reference-items {
  display: flex;
  gap: 12px;
  padding: 0 4px 8px 0;
}
.add-reference,
.reference {
  width: 56px;
  height: 56px;
  flex-shrink: 0;
  border-radius: 9px;
  background: #272b2d;
  border: 1px solid #353b3e;
  display: flex;
  align-items: center;
  justify-content: center;
}
.add-reference {
  color: #e4e9e5;
}
.reference {
  position: relative;
}
.reference image {
  width: 100%;
  height: 100%;
  border-radius: 8px;
}
.reference-remove {
  position: absolute;
  right: -3px;
  top: 0;
  width: 19px;
  height: 19px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #404a46;
}
.reference-remove::after {
  content: "";
  position: absolute;
  inset: -12px;
}
.expand-editor {
  position: absolute;
  right: 8px;
  top: 8px;
  width: 34px;
  height: 34px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #a4ada7;
}
.prompt-input {
  position: absolute;
  top: 90px;
  left: 16px;
  width: calc(100% - 32px);
  height: 112px;
  padding: 0;
  font-size: 16px;
  line-height: 1.6;
  color: #e9eceb;
}
.prompt-placeholder {
  color: #a0a8ac;
  line-height: 1.6;
}
.count {
  position: absolute;
  right: 16px;
  bottom: 72px;
  font-size: 11px;
  color: #85948b;
}
.quote-note {
  position: absolute;
  left: 16px;
  right: 76px;
  bottom: 64px;
  min-height: 32px;
  display: flex;
  align-items: center;
  font-size: 11px;
  line-height: 18px;
  color: #a0a8ac;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.quote-note.has-cost {
  color: #9bcbaa;
}
.quote-note.quote-retry {
  color: #b6c4bb;
}
.workspace-foot {
  position: absolute;
  bottom: 14px;
  left: 14px;
  right: 14px;
  display: flex;
  align-items: center;
  gap: 8px;
  height: 44px;
}
.model-select {
  display: flex;
  align-items: center;
  gap: 5px;
  flex: 0 1 120px;
  min-width: 0;
  height: 44px;
  padding: 0 8px;
  border-radius: 8px;
  background: #272b2d;
  font-size: 13px;
  font-weight: 500;
}
.model-name {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.spec {
  flex: 1 1 68px;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  text-align: center;
  white-space: nowrap;
  font-size: 12px;
}
.model-select t-icon {
  flex-shrink: 0;
}
.workspace .generate-button {
  flex: 0 0 78px;
  width: 78px;
  height: 44px;
  line-height: 44px;
  padding: 0;
  margin: 0;
  border-radius: 7px;
  background-color: #9bcbaa;
  color: #17281d;
  font-size: 14px;
  font-weight: 700;
}
.workspace .generate-button.is-disabled {
  background-color: #282d2f;
  color: #818b90;
}
.workspace.expanded {
  position: fixed;
  top: calc(58px + env(safe-area-inset-top));
  bottom: calc(80px + env(safe-area-inset-bottom));
  left: 20px;
  right: 20px;
  height: auto;
  z-index: 900;
  box-shadow: 0 0 0 100vmax #131516dd;
}
.expanded .prompt-input {
  height: calc(100% - 188px);
}
@media (max-width: 350px) {
  .model-select { gap: 4px; padding: 0 6px; }
  .model-select t-icon:first-child { display: none; }
}
