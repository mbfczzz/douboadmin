.workspace {
  position: relative;
  height: 320px;
  border: 1px solid transparent;
  border-radius: var(--ui-radius-card);
  background: var(--ui-surface);
}
.reference-strip {
  position: absolute;
  top: 14px;
  left: 14px;
  width: calc(100% - 62px);
  height: 72px;
  white-space: nowrap;
}
.reference-items {
  display: flex;
  gap: 12px;
  padding: 0 4px 8px 0;
}
.add-reference,
.reference {
  width: 64px;
  height: 64px;
  flex-shrink: 0;
  border-radius: 12px;
  background: var(--ui-field);
  display: flex;
  align-items: center;
  justify-content: center;
}
.add-reference {
  color: var(--ui-muted);
  flex-direction: column;
  gap: 4px;
}
.reference {
  position: relative;
}
.add-label {
  font-size: 13px;
  line-height: 14px;
}
.reference image {
  width: 100%;
  height: 100%;
  border-radius: 12px;
}
.reference-remove {
  position: absolute;
  right: -3px;
  top: 0;
  width: 19px;
  height: 19px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--ui-field);
}
.reference-remove::after {
  content: "";
  position: absolute;
  top: -12px;
  right: -12px;
  bottom: -12px;
  left: -12px;
}
.expand-editor {
  position: absolute;
  right: 3px;
  top: 3px;
  width: var(--ui-touch-size);
  height: var(--ui-touch-size);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ui-muted);
}
.prompt-input {
  position: absolute;
  top: 90px;
  left: 16px;
  width: calc(100% - 32px);
  /* Four complete lines, including after the typography adjustment. */
  height: 88px;
  padding: 0;
  font-size: 15px;
  line-height: 22px;
  color: var(--ui-text);
}
.prompt-placeholder {
  color: var(--ui-placeholder);
  line-height: 22px;
}
.editor-meta {
  position: absolute;
  left: 16px;
  right: 16px;
  bottom: 72px;
  display: flex;
  align-items: center;
  gap: 12px;
  min-height: 44px;
  border-top: 1px solid var(--ui-border);
}
.editor-balance {
  flex: 1;
  min-width: 0;
}
.count {
  position: absolute;
  right: 16px;
  bottom: 124px;
  font-size: 12px;
  color: var(--ui-muted);
  line-height: 16px; /* a fixed box: its top must clear the prompt's last line */
}
.quote-note {
  max-width: 45%;
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  text-align: right;
  font-size: 13px;
  font-weight: 500;
  line-height: 18px;
  color: var(--ui-text);
  overflow-wrap: anywhere;
  word-break: keep-all;
}
.quote-note.quote-idle {
  font-weight: 400;
  color: var(--ui-muted);
}
.quote-note.quote-retry {
  color: var(--ui-warning);
}
.workspace-foot {
  position: absolute;
  bottom: 16px;
  left: 16px;
  right: 16px;
  display: flex;
  align-items: center;
  gap: 8px;
  min-height: 48px;
}
.model-select {
  display: flex;
  align-items: center;
  gap: 5px;
  /* Real model names are longer than the designed placeholder. */
  flex: 1 1 auto;
  min-width: 0;
  height: 48px;
  padding: 0 8px;
  border-radius: 10px;
  background: var(--ui-field);
  border: 1px solid transparent;
  font-size: 13px;
  font-weight: 500;
}
.model-copy {
  min-width: 0;
  flex: 1;
}
.model-name {
  display: block;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
/* The model yields width; estimated cost wraps instead of hiding digits. */
button.generate-button {
  width: 80px;
  flex-shrink: 0;
  min-height: 48px;
  line-height: 24px;
  padding: 12px 4px;
  margin: 0;
  border-radius: var(--ui-radius-control);
  background-color: var(--ui-primary);
  color: var(--ui-on-brand);
  font-size: 15px;
  font-weight: 600;
}
button.generate-button.is-disabled {
  background-color: var(--ui-disabled);
  color: var(--ui-disabled-text);
}
@media (max-width: 350px) {
  .workspace-foot {
    gap: 6px;
  }
  button.generate-button {
    width: 68px;
  }
  .model-select {
    gap: 4px;
  }
}
.workspace.expanded {
  position: fixed;
  top: calc(58px + env(safe-area-inset-top));
  bottom: calc(80px + env(safe-area-inset-bottom));
  left: 20px;
  right: 20px;
  height: auto;
  z-index: 900;
  box-shadow: 0 0 0 100vmax #000000b3;
}
.expanded .prompt-input {
  height: calc(100% - 242px);
}
