.workspace {
  position: relative;
  height: 289px;
  border: 1px solid var(--ui-border);
  border-radius: var(--ui-radius-card);
  background: var(--ui-surface);
}
.reference-strip {
  position: absolute;
  top: 14px;
  left: 14px;
  width: calc(100% - 62px);
  height: 72px;
  white-space: nowrap;
}
.reference-items {
  display: flex;
  gap: 12px;
  padding: 0 4px 8px 0;
}
.add-reference,
.reference {
  width: 64px;
  height: 64px;
  flex-shrink: 0;
  border-radius: 12px;
  background: var(--ui-field);
  display: flex;
  align-items: center;
  justify-content: center;
}
.add-reference {
  border: 1px dashed var(--ui-muted);
  color: var(--ui-muted);
  flex-direction: column;
  gap: 4px;
}
.reference {
  position: relative;
}
.add-label {
  font-size: 12px;
  line-height: 14px;
}
.reference image {
  width: 100%;
  height: 100%;
  border-radius: 12px;
}
.reference-remove {
  position: absolute;
  right: -3px;
  top: 0;
  width: 19px;
  height: 19px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--ui-field);
}
.reference-remove::after {
  content: "";
  position: absolute;
  inset: -12px;
}
.expand-editor {
  position: absolute;
  right: 3px;
  top: 3px;
  width: var(--ui-touch-size);
  height: var(--ui-touch-size);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ui-muted);
}
.prompt-input {
  position: absolute;
  top: 90px;
  left: 16px;
  width: calc(100% - 32px);
  /* Four 14px lines fit without clipping at the bottom. */
  height: 90px;
  padding: 0;
  font-size: 14px;
  line-height: 1.6;
  color: var(--ui-text);
}
.prompt-placeholder {
  color: var(--ui-muted);
  line-height: 1.6;
}
.count {
  position: absolute;
  right: 16px;
  bottom: 72px;
  font-size: 12px;
  color: var(--ui-muted);
}
.quote-note {
  position: absolute;
  left: 16px;
  right: 76px;
  bottom: 64px;
  min-height: 32px;
  display: flex;
  align-items: center;
  font-size: 13px;
  font-weight: 500;
  line-height: 20px;
  color: var(--ui-muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.quote-note.has-cost {
  color: var(--ui-link);
}
.quote-note.quote-retry {
  color: var(--ui-muted);
}
.workspace-foot {
  position: absolute;
  bottom: 14px;
  left: 14px;
  right: 14px;
  display: flex;
  align-items: center;
  gap: 8px;
  height: 44px;
}
.model-select {
  display: flex;
  align-items: center;
  gap: 5px;
  /* Real model names are longer than the designed placeholder. */
  flex: 1 1 auto;
  min-width: 0;
  height: 44px;
  padding: 0 12px;
  border-radius: 10px;
  background: var(--ui-field);
  border: 1px solid var(--ui-border);
  font-size: 13px;
  font-weight: 500;
}
.model-name {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
/* The summary ("1080p · 5秒") always shows in full; the model name gives
   way with an ellipsis (its full name is in the dropdown). */
.spec {
  flex: 0 0 auto;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  text-align: center;
  white-space: nowrap;
  font-size: 12px;
}
.generate-button {
  width: 100%;
  min-height: 48px;
  line-height: 24px;
  padding: 12px;
  margin: 0;
  border-radius: var(--ui-radius-control);
  background-color: var(--ui-primary);
  color: var(--ui-on-brand);
  font-size: 14px;
  font-weight: 600;
}
.generate-button.is-disabled {
  background-color: var(--ui-disabled);
  color: var(--ui-disabled-text);
}
.workspace .generate-button {
  width: 104px;
  flex-shrink: 0;
  padding: 10px 6px;
  min-height: 44px;
}
.expanded .spec {
  display: none;
}
.workspace.expanded {
  position: fixed;
  top: calc(58px + env(safe-area-inset-top));
  bottom: calc(80px + env(safe-area-inset-bottom));
  left: 20px;
  right: 20px;
  height: auto;
  z-index: 900;
  box-shadow: 0 0 0 100vmax #20263299;
}
.expanded .prompt-input {
  height: calc(100% - 188px);
}
@media (max-width: 350px) {
  .model-select {
    gap: 4px;
    padding: 0 6px;
  }
}
