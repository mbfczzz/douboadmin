<nav-bar
  title="编辑资料"
  back
  intercept-back
  bind:back="back"
  disabled="{{busy}}"
/>
<view class="subpage profile-page">
  <view wx:if="{{loading}}" class="loading"
    ><t-loading text="正在读取资料"
  /></view>
  <view wx:elif="{{needsLogin}}" class="empty"
    ><view class="empty-icon"><t-icon name="user" size="30" /></view
    ><text class="title">登录后编辑你的个人资料</text
    ><text class="empty-link" bindtap="signIn">{{busy?'正在登录…':'去登录 ›'}}</text></view
  >
  <view wx:elif="{{loadError&&!me}}" class="biz-error" bindtap="load"
    >{{loadError}} · 点击重试</view
  >
  <form wx:elif="{{me}}" bindsubmit="save">
    <button
      class="profile-avatar-row"
      open-type="chooseAvatar"
      bindchooseavatar="chooseAvatar"
      disabled="{{busy||uploadingAvatar}}"
      hover-class="profile-pressed"
      aria-label="更换头像"
    >
      <view class="profile-avatar"
        ><image
          wx:if="{{avatarUrl}}"
          src="{{avatarUrl}}"
          mode="aspectFill"
        /><t-icon wx:else name="user" size="32" />
        <view class="profile-camera"><t-icon name="camera" size="16" /></view>
      </view>
      <view class="profile-avatar-copy"
        ><text class="profile-avatar-label"
          >{{uploadingAvatar?'正在上传头像…':'更换头像'}}</text
        >
        <text class="profile-note {{avatarError?'profile-error':''}}"
          >{{avatarError||'点击更换，图片不超过 5MB'}}</text
        ></view
      >
      <t-icon name="chevron-right" size="20" class="profile-chevron" />
    </button>
    <text class="profile-section"
      >基础资料<text class="profile-optional">{{me.profile.data.verifiedPhone?'昵称、姓名必填':'昵称必填'}}</text></text
    >
    <view class="profile-input-fields">
      <view
        class="profile-field {{focusedField==='nickname'?'focused':''}} {{fieldErrors.nickname?'invalid':''}}"
        data-field="nickname"
        bindtap="focus"
      >
        <text class="profile-label">昵称</text
        ><view class="profile-field-content">
          <input
            type="nickname"
            name="nickname"
            value="{{nickname}}"
            data-field="nickname"
            data-next="name"
            aria-label="{{fieldErrors.nickname?'昵称，'+fieldErrors.nickname:'昵称'}}"
            maxlength="30"
            disabled="{{busy}}"
            focus="{{focusedField==='nickname'}}"
            bindfocus="focus"
            bindblur="blur"
            bindinput="input"
            confirm-type="next"
            bindconfirm="next"
            placeholder-class="profile-placeholder"
            placeholder="填写昵称"
            cursor-spacing="24"
          />
          <text wx:if="{{fieldErrors.nickname}}" class="profile-field-error"
            >{{fieldErrors.nickname}}</text
          >
        </view>
      </view>
      <view
        class="profile-field {{focusedField==='name'?'focused':''}} {{fieldErrors.name?'invalid':''}}"
        data-field="name"
        bindtap="focus"
      >
        <text class="profile-label">姓名</text
        ><view class="profile-field-content">
          <input
            name="name"
            value="{{name}}"
            data-field="name"
            data-next="bio"
            aria-label="{{fieldErrors.name?'姓名，'+fieldErrors.name:'姓名'}}"
            maxlength="50"
            disabled="{{busy}}"
            focus="{{focusedField==='name'}}"
            bindfocus="focus"
            bindblur="blur"
            bindinput="input"
            confirm-type="next"
            bindconfirm="next"
            placeholder-class="profile-placeholder"
            placeholder="请填写姓名"
            cursor-spacing="24"
          />
          <text wx:if="{{fieldErrors.name}}" class="profile-field-error"
            >{{fieldErrors.name}}</text
          >
        </view>
      </view>
    </view>
    <view class="profile-fields profile-readonly-fields">
      <view class="profile-field">
        <text class="profile-label">手机号</text
        ><view class="profile-field-content">
          <view class="profile-readonly">
            <text>{{phone||'未填写'}}</text
            ><text
              wx:if="{{phone&&me.profile.data.verifiedPhone===phone}}"
              class="profile-verified"
              >已验证</text
            >
          </view>
        </view>
      </view>
      <view wx:if="{{identity.label}}" class="profile-field">
        <text class="profile-label">角色</text
        ><view class="profile-field-content">
          <view class="profile-readonly">
            <text wx:if="{{identity.partner}}" class="profile-partner">{{identity.partner}}</text
            ><text class="profile-identity {{identity.kind}}">{{identity.label}}</text>
          </view>
        </view>
      </view>
    </view>
    <text class="profile-section"
      >个人简介<text class="profile-optional">选填</text></text
    >
    <view
      class="profile-bio {{focusedField==='bio'?'focused':''}} {{fieldErrors.bio?'invalid':''}}"
    >
      <textarea
        name="bio"
        value="{{bio}}"
        data-field="bio"
        aria-label="{{fieldErrors.bio?'个人简介，'+fieldErrors.bio:'个人简介（选填）'}}"
        maxlength="120"
        disabled="{{busy}}"
        focus="{{focusedField==='bio'}}"
        bindfocus="focus"
        bindblur="blur"
        bindinput="input"
        confirm-type="done"
        bindconfirm="done"
        placeholder-class="profile-placeholder"
        placeholder="简单介绍一下自己"
        cursor-spacing="24"
      />
      <view class="profile-bio-footer"
        ><text class="profile-field-error">{{fieldErrors.bio}}</text
        ><text class="profile-count">{{bio.length}} / 120</text></view
      >
    </view>
    <view
      wx:if="{{saveError}}"
      class="biz-error profile-save-error"
      role="alert"
      >{{saveError}}</view
    >
    <view class="profile-footer"
      ><button
        class="biz-action profile-submit"
        form-type="submit"
        loading="{{busy}}"
        disabled="{{busy||uploadingAvatar}}"
      >
        <view class="button-content"><t-icon name="check-circle" size="16" /><text>{{busy?'正在保存…':uploadingAvatar?'头像上传中…':'保存修改'}}</text></view>
      </button></view
    >
  </form>
</view>
<ui-dialog id="ui-dialog" />
