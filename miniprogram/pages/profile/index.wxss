@import "../../styles/business.wxss";
.profile-page {
  padding-top: 12px;
  padding-bottom: calc(28px + env(safe-area-inset-bottom));
}
button.profile-avatar-row {
  display: flex;
  align-items: center;
  gap: 16px;
  width: 100%;
  margin: 0;
  padding: 16px;
  text-align: left;
  line-height: 1.5;
  background: var(--ui-surface);
  border: 1px solid var(--ui-border);
  color: var(--ui-text);
  border-radius: var(--ui-radius-card);
}
.profile-avatar {
  position: relative;
  width: 48px;
  height: 48px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--ui-field);
  color: var(--ui-muted);
}
.profile-avatar image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}
.profile-camera {
  position: absolute;
  right: -1px;
  bottom: -1px;
  width: 22px;
  height: 22px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--ui-primary);
  color: var(--ui-on-brand);
  border: 2px solid var(--ui-bg);
  border-radius: 50%;
}
.profile-avatar-copy {
  flex: 1;
  min-width: 0;
}
.profile-avatar-label {
  display: block;
  margin-bottom: 5px;
  font-size: 16px;
  font-weight: 600;
}
.profile-note {
  display: block;
  color: var(--ui-muted);
  font-size: 12px;
  line-height: 1.7;
}
.profile-chevron {
  flex-shrink: 0;
  color: var(--ui-muted);
}
.profile-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 22px 2px 10px;
  color: var(--ui-muted);
  font-size: 16px;
  font-weight: 600;
}
.profile-optional {
  color: var(--ui-muted);
  font-size: 12px;
  font-weight: 400;
}
.profile-fields,
.profile-bio {
  border: 1px solid var(--ui-border);
  border-radius: var(--ui-radius-card);
  background: var(--ui-surface);
  overflow: hidden;
}
.profile-field {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  min-height: 60px;
  padding: 12px 16px;
  transition: background 120ms;
}
.profile-field + .profile-field {
  border-top: 1px solid var(--ui-border);
}
.profile-label {
  width: 64px;
  flex-shrink: 0;
  padding-top: 6px;
  color: var(--ui-text);
  font-size: 14px;
  line-height: 24px;
}
.profile-field-content {
  flex: 1;
  min-width: 0;
}
.profile-field input {
  width: 100%;
  height: 52px;
  padding: 0 14px;
  border: 1px solid var(--ui-border);
  border-radius: 12px;
  background: var(--ui-field);
  color: var(--ui-text);
  caret-color: var(--ui-brand);
  font-size: 14px;
  text-align: left;
}
.profile-placeholder {
  color: var(--ui-muted);
}
.profile-field-error {
  display: block;
  margin-top: 4px;
  color: var(--ui-danger);
  font-size: 12px;
  line-height: 1.6;
}
.profile-bio {
  background: var(--ui-field);
  padding: 14px 16px;
  transition: border-color 120ms;
}
.profile-bio.focused {
  border-color: var(--ui-brand);
}
.profile-bio textarea {
  display: block;
  width: 100%;
  height: 64px;
  padding: 0;
  color: var(--ui-text);
  caret-color: var(--ui-brand);
  font-size: 15px;
  line-height: 1.7;
}
.profile-bio-footer {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 12px;
  margin-top: 10px;
}
.profile-bio-footer .profile-field-error {
  flex: 1;
  min-width: 0;
}
.profile-count {
  flex-shrink: 0;
  color: var(--ui-muted);
  font-size: 12px;
  line-height: 1.6;
  font-variant-numeric: tabular-nums;
}
.profile-footer {
  margin-top: 24px;
}
button.profile-submit {
  min-height: 48px;
  margin: 0;
  padding: 12px;
  line-height: 24px;
}
.profile-save-error {
  margin-top: 18px;
  margin-bottom: 0;
}
.profile-error {
  color: var(--ui-danger);
}
.profile-login {
  padding-top: 48px;
  text-align: center;
}
.profile-login .biz-action {
  margin-top: 24px;
}
.profile-pressed,
.profile-avatar-row[disabled] {
  opacity: 0.65;
}

.profile-field.invalid .profile-label {
  color: var(--ui-danger);
}
.profile-bio.invalid {
  border-color: var(--ui-danger-border);
}
.profile-readonly {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 8px;
  min-height: 36px;
  color: var(--ui-muted);
  font-size: 16px;
  font-variant-numeric: tabular-nums;
}
.profile-verified {
  padding: 1px 6px;
  border-radius: 4px;
  background: var(--ui-success-bg);
  color: var(--ui-success);
  font-size: 12px;
  line-height: 18px;
}
.profile-identity {
  padding: 1px 8px;
  border-radius: 6px;
  background: var(--ui-selected);
  color: var(--ui-link);
  font-size: 12px;
  line-height: 18px;
}
/* Long provider names give way to the identity label. */
.profile-partner {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
}
.profile-input-fields .profile-field {
  display: block;
  padding: 0;
  margin: 0 0 16px;
  border: 0;
  background: transparent;
}
.profile-input-fields .profile-label {
  display: block;
  width: auto;
  padding: 0;
  margin-bottom: 8px;
  color: var(--ui-muted);
  font-size: 12px;
}
.profile-field.focused input {
  border-color: var(--ui-brand);
}
.profile-field.invalid input {
  border-color: var(--ui-danger);
}
