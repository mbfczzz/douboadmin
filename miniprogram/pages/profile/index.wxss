@import "../../styles/business.wxss";
.profile-page {
  padding-top: 12px;
  padding-bottom: calc(28px + env(safe-area-inset-bottom));
}
button.profile-avatar-row {
  display: flex;
  align-items: center;
  gap: 16px;
  width: 100%;
  margin: 0;
  padding: 10px 0;
  text-align: left;
  line-height: 1.5;
  background: transparent;
  color: #ffffff;
  border-radius: 12px;
}
.profile-avatar {
  position: relative;
  width: 64px;
  height: 64px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #2e2e2e;
  color: #a6a6a6;
}
.profile-avatar image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}
.profile-camera {
  position: absolute;
  right: -1px;
  bottom: -1px;
  width: 22px;
  height: 22px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--ui-primary);
  color: var(--ui-on-brand);
  border: 2px solid var(--ui-bg);
  border-radius: 50%;
}
.profile-avatar-copy {
  flex: 1;
  min-width: 0;
}
.profile-avatar-label {
  display: block;
  margin-bottom: 5px;
  font-size: 16px;
  font-weight: 600;
}
.profile-note {
  display: block;
  color: var(--ui-muted);
  font-size: 12px;
  line-height: 1.7;
}
.profile-chevron {
  flex-shrink: 0;
  color: var(--ui-muted);
}
.profile-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 22px 2px 10px;
  color: var(--ui-muted);
  font-size: 13px;
  font-weight: 500;
}
.profile-optional {
  color: var(--ui-muted);
  font-size: 12px;
  font-weight: 400;
}
.profile-fields,
.profile-bio {
  border: 1px solid transparent;
  border-radius: 16px;
  background: var(--ui-surface);
  overflow: hidden;
}
.profile-field {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  min-height: 60px;
  padding: 12px 16px;
  transition: background 120ms;
}
.profile-field + .profile-field {
  border-top: 1px solid #ffffff0f;
}
.profile-label {
  width: 64px;
  flex-shrink: 0;
  padding-top: 6px;
  color: #ffffff;
  font-size: 14px;
  line-height: 24px;
}
.profile-field-content {
  flex: 1;
  min-width: 0;
}
.profile-field input {
  width: 100%;
  height: 36px;
  padding: 0;
  color: #ffffff;
  caret-color: var(--ui-brand);
  font-size: 16px;
  text-align: right;
}
.profile-field.focused {
  background: var(--ui-field);
}
.focused .profile-label {
  color: #ffffff;
}
.profile-placeholder {
  color: var(--ui-muted);
}
.profile-field-error {
  display: block;
  margin-top: 4px;
  color: #ff3355;
  font-size: 12px;
  line-height: 1.6;
}
.profile-field .profile-field-error {
  text-align: right;
}
.profile-bio {
  padding: 14px 16px;
  transition: border-color 120ms;
}
.profile-bio.focused {
  border-color: #ffffff4d;
}
.profile-bio textarea {
  display: block;
  width: 100%;
  height: 88px;
  padding: 0;
  color: #ffffff;
  caret-color: var(--ui-brand);
  font-size: 15px;
  line-height: 1.7;
}
.profile-bio-footer {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 12px;
  margin-top: 10px;
}
.profile-bio-footer .profile-field-error {
  flex: 1;
  min-width: 0;
}
.profile-count {
  flex-shrink: 0;
  color: var(--ui-muted);
  font-size: 12px;
  line-height: 1.6;
  font-variant-numeric: tabular-nums;
}
.profile-footer {
  margin-top: 24px;
}
button.profile-submit {
  min-height: 48px;
  margin: 0;
  padding: 12px;
  border-radius: 22px;
  font-size: 16px;
  font-weight: 600;
  line-height: 24px;
}
.profile-save-error {
  margin-top: 18px;
  margin-bottom: 0;
}
.profile-error {
  color: #ff3355;
}
.profile-login {
  padding-top: 48px;
  text-align: center;
}
.profile-login .biz-action {
  margin-top: 24px;
}
.profile-pressed,
.profile-avatar-row[disabled] {
  opacity: 0.65;
}

.profile-field.invalid .profile-label {
  color: #ff3355;
}
.profile-bio.invalid {
  border-color: #66202f;
}
.profile-readonly {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 8px;
  min-height: 36px;
  color: var(--ui-muted);
  font-size: 16px;
  font-variant-numeric: tabular-nums;
}
.profile-verified {
  padding: 1px 6px;
  border-radius: 4px;
  background: #183024;
  color: #32d47a;
  font-size: 12px;
  line-height: 18px;
}
.profile-identity {
  padding: 1px 8px;
  border-radius: 6px;
  background: #ffffff14;
  color: #ffffffcc;
  font-size: 12px;
  line-height: 18px;
}
/* Long provider names give way to the identity label. */
.profile-partner {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
}
