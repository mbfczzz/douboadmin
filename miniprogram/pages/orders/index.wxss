@import "../../styles/business.wxss";
.biz-card-head .biz-heading {
  margin-bottom: 0;
}
.order-state {
  padding: 2px 8px;
  border-radius: 6px;
  background: var(--ui-field);
  color: var(--ui-muted);
  font-size: 12px;
  line-height: 18px;
}
.order-state.paid {
  background: var(--ui-success-bg);
  color: var(--ui-success);
}
.order-state.created,
.order-state.refunding {
  background: var(--ui-warning-bg);
  color: var(--ui-warning);
}
.order-meta {
  flex-wrap: wrap;
  gap: 4px 12px;
  margin-top: 10px;
}
.order-amount {
  flex: 1;
  min-width: 0;
  font-size: 17px;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  overflow-wrap: anywhere;
}
