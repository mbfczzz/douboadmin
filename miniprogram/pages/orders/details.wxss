/* Summary, three-step progress and the expandable detail lines. */
.orders-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 4px 2px 14px;
}
.orders-total {
  font-size: 26px;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}
.orders-label {
  font-size: 13px;
  color: var(--ui-muted);
}
.orders-buy {
  font-size: 13px;
  color: var(--ui-brand);
}
.order-steps {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-top: 14px;
  font-size: 11px;
  color: var(--ui-muted);
}
.step {
  display: flex;
  align-items: center;
  gap: 4px;
}
.step-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--ui-field);
  box-shadow: inset 0 0 0 1px #ffffff2e;
}
.step.on {
  color: var(--ui-text);
}
.step.on .step-dot {
  background: var(--ui-brand);
  box-shadow: 0 0 0 3px #00c8dc26;
}
.step-line {
  width: 22px;
  height: 1px;
  background: #ffffff24;
}
.step-line.on {
  background: var(--ui-brand);
}
.order-window {
  margin-left: auto;
  color: var(--ui-warning);
}
.order-lines {
  margin-top: 10px;
  padding: 10px 12px;
  border-radius: 12px;
  background: var(--ui-field);
}
.order-line {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  padding: 5px 0;
  font-size: 12px;
  color: var(--ui-muted);
}
.line-value {
  min-width: 0;
  overflow-wrap: anywhere;
  text-align: right;
  color: var(--ui-text);
  font-variant-numeric: tabular-nums;
}
.order-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
  margin: 8px -16px -6px;
  padding: 8px 0;
  font-size: 12px;
  color: var(--ui-muted);
}
.lines-hint {
  display: block;
  margin-top: 4px;
  font-size: 11px;
  text-align: center;
  color: #ffffff4d;
}
/* Each order leads with a real work cover and a small status badge. */
.order-art {
  position: relative;
  width: 44px;
  height: 56px;
  flex-shrink: 0;
  border-radius: 10px;
  background: var(--ui-field);
}
.order-art image {
  width: 100%;
  height: 100%;
  border-radius: 10px;
}
.order-badge {
  position: absolute;
  right: -5px;
  bottom: -5px;
  width: 20px;
  height: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: var(--ui-on-brand);
  background: var(--ui-warning);
  box-shadow: 0 0 0 2px var(--ui-surface);
}
.order-art.paid .order-badge {
  background: var(--ui-success);
}
.order-art.refunded .order-badge,
.order-art.refunding .order-badge {
  color: var(--ui-text);
  background: var(--ui-selected);
}
