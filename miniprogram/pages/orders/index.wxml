<nav-bar title="充值订单" back /><view
  class="subpage page-motion {{pageMotion}}"
>
  <view wx:if="{{needsLogin}}" class="biz-empty"
    >登录后查看充值订单<button class="biz-action" bindtap="signIn">
      去登录
    </button></view
  >
  <view wx:if="{{loadError}}" class="biz-error" bindtap="load"
    >{{loadError}} · 重试</view
  >
  <view wx:if="{{loading&&!needsLogin&&!rows.length}}" class="biz-empty">正在加载充值订单…</view>
  <view wx:elif="{{!needsLogin&&!loadError&&!rows.length}}" class="biz-empty"
    >暂无充值订单</view
  >
  <view wx:for="{{rows}}" wx:key="id" class="biz-card"
    ><view class="row biz-card-head"
      ><text class="biz-heading">{{item.points}} 积分</text
      ><text class="order-state {{item.data.status}}">{{item.state}}</text></view
    ><view class="row order-meta"
      ><text class="order-amount">¥{{item.amount}}</text
      ><text class="biz-small">{{item.time}}</text></view
    ><text class="biz-small biz-record-meta" selectable>订单号 {{item.id}}</text
    ><text wx:if="{{item.data.status==='created'&&item.data.virtual.issued}}" class="biz-note">此支付单不能再次拉起支付。若已取消，可返回积分页重新购买；已付款请先查支付结果。</text
    ><view wx:if="{{item.data.status==='created'}}" class="biz-pair"
      ><view
        ><button
          class="biz-action biz-secondary"
          disabled="{{busy}}"
          data-id="{{item.id}}"
          bindtap="refresh"
        >
          查支付结果
        </button></view
      ><view wx:if="{{item.canPay}}"
        ><button
          class="biz-action"
          loading="{{busy===item.id}}"
          disabled="{{busy}}"
          data-id="{{item.id}}"
          bindtap="pay"
        >
          继续支付
        </button></view
      ></view
    ></view
  >
</view>
