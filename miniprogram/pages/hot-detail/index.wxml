<nav-bar title="视频详情" back /><view
  class="subpage"
  ><view wx:if="{{loadError}}" class="biz-error" bindtap="load"
    >{{loadError}} · 点击重试</view
  ><view wx:if="{{loading&&!video}}" class="skel-list" aria-label="正在加载视频"><view class="skeleton skel-hero" /><view class="skeleton skel-card" /></view
  ><block wx:if="{{video}}"
    ><view class="biz-card"
      ><video
        wx:if="{{video.url}}"
        class="biz-preview"
        src="{{video.url}}"
        poster="{{video.cover}}"
        controls
      /><image
        wx:else
        class="biz-image"
        src="{{video.cover}}"
        mode="aspectFill"
      /><text class="biz-heading">{{video.title}}</text
      ><text class="biz-small">{{video.author}} · {{video.dateText}}</text
      ><view class="hot-stats"
        ><view><image class="gl gl-16" src="/assets/glyphs/favorites-muted.png" /><text>{{video.likesText}}</text></view
        ><view><image class="gl gl-16" src="/assets/glyphs/play-muted.png" /><text>{{video.viewsText}}</text></view></view
      ></view
    ><view class="biz-card"
      ><view class="row biz-title-row"
        ><text class="biz-heading">视频文案</text
        ><view class="copy-chip" bindtap="copy"><image class="gl gl-14" src="/assets/glyphs/copy.png" /><text>复制</text></view></view
      ><text selectable="true" class="video-copy">{{video.text}}</text></view
    ><text wx:if="{{busy}}" class="biz-note">{{progress}}</text
    ><text wx:elif="{{!video.url}}" class="biz-note">该视频暂不支持导入混剪。</text
    ><button
      wx:if="{{video.url}}"
      class="biz-action"
      loading="{{busy}}"
      disabled="{{busy}}"
      bindtap="use"
    >
      导入素材并混剪
    </button></block
  ></view
>
