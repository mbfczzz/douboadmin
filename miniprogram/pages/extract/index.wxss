@import "../../styles/business.wxss";
.extract-heading {
  display: block;
  margin-bottom: 12px;
  font-size: 15px;
  font-weight: 600;
}
.read-model {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 12px;
  font-size: 13px;
  color: var(--ui-muted);
}
.method {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 10px;
  padding: 16px;
  border-radius: 16px;
  background: var(--ui-surface);
}
.method.open {
  box-shadow: 0 0 0 1px var(--ui-brand);
}
.method-icon {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  border-radius: 12px;
  background: var(--ui-field);
}
.method-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.method-title {
  font-size: 15px;
  font-weight: 600;
}
.method-note {
  font-size: 12px;
  color: var(--ui-muted);
}
.method-go {
  font-size: 20px;
  color: var(--ui-muted);
  transition: transform 0.2s;
}
/* Open: the arrow points down; tapping the row again folds the box away. */
.method-go.open {
  transform: rotate(90deg);
}
.link-input {
  width: 100%;
  min-height: 72px;
  font-size: 14px;
  line-height: 20px;
}
.link-placeholder {
  color: var(--ui-placeholder);
}
.link-actions,
.result-actions {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 12px;
}
.link-paste {
  flex: none;
  padding: 0 8px;
  font-size: 14px;
  color: var(--ui-link);
}
button.link-go {
  flex: 1;
}
.result-text {
  display: block;
  margin-top: 12px;
  font-size: 14px;
  line-height: 22px;
  white-space: pre-wrap;
}
.result-actions button.biz-action,
.result-actions button.biz-secondary {
  flex: 1;
  width: auto;
  margin: 0;
  border-radius: var(--ui-radius-pill);
}
