/* Model chips and the per-turn price, just above the composer. */
.agent-bar {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-shrink: 0;
  margin: 16px 16px 0;
  min-height: 28px;
}
.model-strip {
  flex: 1;
  width: 0;
  white-space: nowrap;
}
.model-row {
  display: inline-flex;
  gap: 6px;
}
.model-chip {
  max-width: 96px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 4px 10px;
  border-radius: 14px;
  font-size: 12px;
  line-height: 18px;
  color: var(--ui-muted);
  background: var(--ui-surface);
}
.model-chip.on {
  color: var(--ui-text);
  box-shadow: inset 0 0 0 1px #ffffff47;
}
.bar-note {
  flex-shrink: 0;
  font-size: 11px;
  color: var(--ui-muted);
}
.bar-note.full {
  color: #ff8a94;
}
.composer.has-bar {
  margin-top: 10px;
}
.agent-bar {
  margin-top: 10px;
}
