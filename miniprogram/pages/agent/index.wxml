<nav-bar title="Agent" />
<view class="agent-page" style="--nav-bottom:{{navBottom}}px">
  <view class="project-bar" bindtap="openProjects" hover-class="starter-pressed" aria-role="button" aria-label="切换创作项目">
    <image wx:if="{{session&&art[session.data.skill]}}" class="project-thumb" src="{{art[session.data.skill]}}" mode="aspectFill" />
    <image wx:else class="gl gl-16" src="/assets/glyphs/history-muted.png" />
    <text class="project-title">{{session?session.data.title:'新的创作'}}</text>
    <text class="project-switch">项目 ›</text>
  </view>
  <view wx:if="{{!ready}}" class="chat-scroll agent-skeleton" aria-label="正在加载对话">
    <view class="skeleton skel-bubble mine" /><view class="skeleton skel-bubble" /><view class="skeleton skel-bubble short" />
  </view>
  <scroll-view wx:elif="{{!messages.length}}" scroll-y class="chat-scroll"><view class="agent-empty">
    <view class="agent-hello">
      <image wx:if="{{session&&art[session.data.skill]}}" class="skill-hero" src="{{art[session.data.skill]}}" mode="aspectFill" />
      <view wx:else class="agent-mark"><image class="gl gl-30" src="/assets/glyphs/ai-pen-dark.png" /></view>
      <text class="headline">{{session?'说说这次想做什么':'选一个开始创作'}}</text>
      <text class="intro-sub">{{!session?'素材、方案、修改和生成，都在这一段对话里完成。':session.data.skill==='product'?'先在下方添加商品图，再说说想突出的卖点':session.data.skill==='store'?'先在下方添加门头、环境、菜品照片，再说说店名和特色':session.data.skill==='image'?'说说想要的画面，也可以在下方添加参考图':'说说你的想法，素材可以随时在下方添加'}}</text>
    </view>
    <view wx:if="{{!session}}" class="starters">
      <view wx:for="{{skills}}" wx:key="id" class="starter" data-id="{{item.id}}" bindtap="newProject" hover-class="starter-pressed" aria-role="button">
        <image wx:if="{{art[item.id]}}" class="starter-photo" src="{{art[item.id]}}" mode="aspectFill" lazy-load /><view wx:else class="source-glyph starter-glyph glyph-video"><t-icon name="{{item.icon}}" size="20" /></view>
        <view class="starter-copy"><text class="starter-title">{{item.name}}</text><text class="starter-hint">{{item.hint}}</text></view>
        <image class="gl gl-16" src="/assets/glyphs/open-muted.png" />
      </view>
    </view>
  </view></scroll-view>
  <scroll-view wx:else scroll-y class="chat-scroll" scroll-into-view="{{bottom}}" scroll-with-animation>
    <view class="conversation">
      <view wx:if="{{hasOlder}}" class="older" bindtap="older">
        <t-loading wx:if="{{loadingOlder}}" size="14px" /><image wx:else class="gl gl-14" src="/assets/glyphs/history-muted.png" /><text>{{loadingOlder?'正在加载…':'查看更早对话'}}</text>
      </view>
      <include src="./parts/messages.wxml" />
    </view>
  </scroll-view>
  <scroll-view wx:if="{{session}}" scroll-x enhanced show-scrollbar="{{false}}" class="material-strip">
    <view class="material-row">
      <view wx:for="{{materials}}" wx:key="id" class="material" data-label="{{item.label}}" bindtap="mention" aria-role="button" aria-label="{{'引用'+item.label}}">
        <image class="material-photo" src="{{item.isImage?item.data.url:item.data.thumbnailUrl}}" mode="aspectFill" />
        <text class="material-label">{{item.label}}</text>
        <view class="material-remove" data-id="{{item.id}}" catchtap="removeMaterial" aria-role="button" aria-label="{{'移除'+item.label}}">×</view>
      </view>
      <view class="material add {{uploading?'busy':''}} {{!materials.length&&(session.data.skill==='product'||session.data.skill==='store')?'wanted':''}}" data-kind="image" bindtap="addMaterial" aria-role="button" aria-label="添加图片"><image class="gl gl-18" src="/assets/glyphs/{{uploading?'clock-muted':'image-muted-lg'}}.png" /><text>{{uploading?'上传中':'图片'}}</text></view>
      <view wx:if="{{!uploading}}" class="material add {{!materials.length&&session.data.skill==='store'?'wanted':''}}" data-kind="video" bindtap="addMaterial" aria-role="button" aria-label="添加视频"><image class="gl gl-18" src="/assets/glyphs/video-muted-lg.png" /><text>视频</text></view>
    </view>
  </scroll-view>
  <view wx:if="{{models.length>1||priceHint}}" class="agent-bar">
    <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="model-strip">
      <view class="model-row">
        <view wx:if="{{models.length>1}}" wx:for="{{models}}" wx:key="id" class="model-chip {{item.id===model?'on':''}}" data-id="{{item.id}}" bindtap="pickModel" aria-role="button" aria-label="{{'对话模型：'+item.name}}">{{item.name}}</view>
      </view>
    </scroll-view>
    <text wx:if="{{prompt.length>400}}" class="bar-note {{prompt.length>=500?'full':''}}">{{prompt.length}}/500</text>
    <text wx:elif="{{priceHint}}" class="bar-note">{{priceHint}}</text>
  </view>
  <view class="composer {{focus?'is-focus':''}} {{models.length>1||priceHint||session?'has-bar':''}}">
    <textarea auto-height maxlength="500" focus="{{focus}}" placeholder="{{messages.length?'继续说说要怎么改…':'说说你的创作想法…'}}" placeholder-class="composer-placeholder" value="{{prompt}}" bindinput="input" bindblur="blur" cursor-spacing="24" show-confirm-bar="{{false}}" />
    <text wx:if="{{prompt.length>400&&!(models.length>1||priceHint)}}" class="composer-count {{prompt.length>=500?'full':''}}">{{prompt.length}}/500</text>
    <view class="send {{prompt&&!busy?'ready':''}}" bindtap="send" hover-class="icon-pressed" aria-role="button" aria-label="发送">
      <t-loading wx:if="{{busy}}" size="18px" /><image wx:else class="gl gl-20" src="/assets/glyphs/send-{{prompt&&!busy?'dark':'muted'}}.png" />
    </view>
  </view>
</view>
<include src="./parts/projects.wxml" />
<ui-dialog id="ui-dialog" />
