/* Agent replies: script lines, failures and follow-up chips. */
.bubble text {
  white-space: pre-wrap;
  word-break: break-all;
}
.reply {
  font-size: 15px;
  line-height: 1.75;
  color: var(--ui-text);
  word-break: break-all;
}
.line.gap {
  height: 8px;
}
/* A shot: cyan label on its own line, the description under it. */
.line.shot {
  margin-top: 10px;
  padding-left: 12px;
  border-left: 2px solid #00c8dc66;
}
.line.shot:first-child {
  margin-top: 0;
}
.shot-label {
  display: block;
  font-size: 13px;
  font-weight: 600;
  line-height: 20px;
  color: var(--ui-brand);
}
.reply-failed {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 6px;
  padding: 10px 14px;
  border-radius: 14px;
  font-size: 14px;
  color: #ff8a94;
  background: #ff5c6c14;
}
.retry {
  margin-left: auto;
  color: var(--ui-text);
}
.follow-ups {
  margin: 12px -20px 0;
  white-space: nowrap;
}
.follow-row {
  display: inline-flex;
  gap: 8px;
  padding: 0 20px;
}
.follow {
  padding: 7px 14px;
  border-radius: var(--ui-radius-pill);
  font-size: 13px;
  color: var(--ui-text);
  box-shadow: inset 0 0 0 1px var(--ui-border);
}
.icon-pressed {
  opacity: 0.6;
}
/* First load with no cached conversation: bubble shapes, not a blank. */
.agent-skeleton {
  display: flex;
  flex-direction: column;
  gap: 14px;
  padding: 24px 20px;
}
.skel-bubble {
  width: 78%;
  height: 72px;
  border-radius: 18px;
}
.skel-bubble.mine {
  align-self: flex-end;
  width: 52%;
  height: 44px;
}
.skel-bubble.short {
  width: 46%;
  height: 36px;
}
/* A reply being written: a blinking caret after the last words. */
.reply.is-streaming .line:last-child::after {
  content: "";
  display: inline-block;
  width: 2px;
  height: 1em;
  margin-left: 2px;
  vertical-align: -2px;
  background: var(--ui-brand);
  animation: caret 1s steps(1) infinite;
}
@keyframes caret {
  50% { opacity: 0; }
}
/* …and once it starts on the plan: a card-shaped placeholder. */
.plan-writing {
  position: relative;
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 10px;
  padding: 18px 14px;
  overflow: hidden;
  border-radius: 16px;
  font-size: 13px;
  color: var(--ui-text);
  background: var(--ui-surface);
  box-shadow: inset 0 0 0 1px #00c8dc33;
}
.plan-writing-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0.18;
}
.plan-writing .typing, .plan-writing text {
  position: relative;
}
@media (prefers-reduced-motion: reduce) {
  .reply.is-streaming .line:last-child::after { animation: none; }
}
