/* The composer: 图片 / 视频 buttons inside it, this message's attachments
   above the text, and the attachments a sent message carried. */
.composer-row {
  display: flex;
  align-items: flex-end;
  gap: 2px;
}
.composer-row textarea {
  margin-left: 4px;
}
.attach-btn {
  width: 34px;
  height: 40px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12px;
}
.attach-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  padding: 4px 4px 8px;
}
.attach {
  position: relative;
  width: 56px;
  height: 56px;
  flex-shrink: 0;
  overflow: hidden;
  border-radius: 12px;
  background: var(--ui-field);
}
.attach-busy {
  display: flex;
  align-items: center;
  justify-content: center;
}
.attach-photo {
  width: 100%;
  height: 100%;
}
.attach-play {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 22px;
  height: 22px;
  margin: -14px 0 0 -11px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #000000a6;
}
.attach-label {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 2px 0;
  text-align: center;
  font-size: 10px;
  color: #fff;
  background: linear-gradient(transparent, #000000b3);
}
.attach-remove {
  position: absolute;
  top: 2px;
  right: 2px;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  text-align: center;
  font-size: 14px;
  line-height: 19px;
  color: #fff;
  background: #000000b3;
}
.sent-files {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 6px;
  max-width: 80%;
  margin-bottom: 6px;
}
.attach.sent {
  width: 72px;
  height: 72px;
}
/* 编辑: under a sent question, and the note while one is being edited. */
.ask-actions {
  display: flex;
  align-items: center;
  gap: 4px;
  margin-top: 4px;
}
.ask-act {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 4px 8px;
  border-radius: 12px;
  font-size: 12px;
  color: var(--ui-muted);
}
.edit-bar {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 4px 8px 8px;
  font-size: 12px;
  color: var(--ui-brand);
}
.edit-note {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.edit-cancel {
  flex-shrink: 0;
  padding: 2px 4px;
  color: var(--ui-muted);
}
/* 可复制: key lines of a reply, each copied with one tap. */
.snippets {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-top: 10px;
}
.snippet {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 10px 8px 12px;
  border-radius: 12px;
  background: var(--ui-surface);
  box-shadow: inset 3px 0 0 #00c8dc99;
}
.snippet-text {
  flex: 1;
  min-width: 0;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  font-size: 14px;
  line-height: 20px;
  color: var(--ui-text);
}
.snippet-copy {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 3px;
  font-size: 11px;
  color: var(--ui-muted);
}
