/* Project bar, materials, the 创作方案 card and generation cards. */
.project-bar {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
  margin: 8px 16px 0;
  padding: 8px 12px;
  border-radius: 12px;
  background: var(--ui-surface);
}
.project-title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 14px;
  font-weight: 600;
}
.project-switch {
  flex-shrink: 0;
  font-size: 12px;
  color: var(--ui-muted);
}
.material-strip {
  flex-shrink: 0;
  margin-top: 12px;
  white-space: nowrap;
}
.material-row {
  display: inline-flex;
  gap: 8px;
  padding: 0 16px;
}
.material {
  position: relative;
  width: 48px;
  height: 48px;
  flex-shrink: 0;
  overflow: hidden;
  border-radius: 10px;
  background: var(--ui-surface);
}
.material-photo {
  width: 100%;
  height: 100%;
}
.material-label {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 2px 0;
  text-align: center;
  font-size: 10px;
  color: #fff;
  background: linear-gradient(transparent, #000000b3);
}
.material-remove {
  position: absolute;
  top: 2px;
  right: 2px;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  text-align: center;
  font-size: 13px;
  line-height: 17px;
  color: #fff;
  background: #00000099;
}
.material.add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2px;
  font-size: 10px;
  color: var(--ui-muted);
  box-shadow: inset 0 0 0 1px #ffffff1f;
  background: transparent;
}
.material.add.busy {
  opacity: 0.6;
}
.plan-card {
  margin-top: 10px;
  padding: 14px;
  border-radius: 16px;
  background: var(--ui-surface);
  box-shadow: inset 0 0 0 1px #00c8dc33;
}
.plan-title {
  font-size: 15px;
  font-weight: 600;
}
.plan-shot {
  display: flex;
  gap: 10px;
  padding: 8px 0;
  border-top: 1px solid #ffffff12;
  font-size: 13px;
  line-height: 19px;
}
.shot-time {
  width: 52px;
  flex-shrink: 0;
  color: var(--ui-primary);
}
.shot-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.shot-line {
  color: var(--ui-muted);
}
.shot-asset {
  flex-shrink: 0;
  height: 20px;
  padding: 0 6px;
  border-radius: 6px;
  font-size: 11px;
  line-height: 20px;
  color: var(--ui-text);
  background: var(--ui-field);
}
.plan-prompt {
  display: block;
  font-size: 13px;
  line-height: 20px;
  color: var(--ui-muted);
}
.plan-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12px;
}
button.plan-go {
  width: auto;
  margin: 0;
  padding: 0 18px;
  height: 36px;
  border-radius: 18px;
  font-size: 14px;
  line-height: 36px;
  font-weight: 600;
  color: var(--ui-on-brand);
  background: var(--ui-primary);
}
button.plan-go[disabled] {
  opacity: 0.5;
  color: var(--ui-on-brand);
  background: var(--ui-primary);
}
.gen-card {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px;
  border-radius: 14px;
  background: var(--ui-surface);
}
.gen-thumb {
  width: 56px;
  height: 56px;
  flex-shrink: 0;
  border-radius: 10px;
}
.gen-wait {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ui-muted);
  background: var(--ui-field);
}
.gen-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.gen-title {
  font-size: 14px;
  font-weight: 600;
}
.gen-note {
  font-size: 12px;
  color: var(--ui-muted);
}
