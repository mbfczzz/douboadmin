@import "./reply.wxss";
.agent-page {
  height: calc(100vh - var(--nav-bottom, 68px) - var(--ui-tabbar-height) - 1px - env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}
.chat-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
}
.conversation {
  padding: 8px 20px 20px;
}
/* Empty conversation: the greeting centred, starters docked above input. */
.agent-empty {
  min-height: 100%;
  display: flex;
  flex-direction: column;
  padding: 0 20px;
}
.agent-hello {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}
.agent-mark {
  width: 64px;
  height: 64px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22px;
  color: var(--ui-on-brand);
  background: var(--ui-text);
  animation: mark-float 4s ease-in-out infinite;
}
@keyframes mark-float {
  50% { transform: translateY(-4px); }
}
.headline {
  display: block;
  margin-top: 22px;
  font-size: 22px;
  font-weight: 600;
  line-height: 30px;
}
.intro-sub {
  display: block;
  margin-top: 6px;
  font-size: 14px;
  color: var(--ui-muted);
}
.starters {
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding-bottom: 6px;
}
.starter {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 14px;
  border-radius: 16px;
  background: var(--ui-surface);
  color: var(--ui-muted);
}
.starter-pressed {
  opacity: 0.72;
}
.starter-glyph {
  width: 40px;
  height: 40px;
  flex-shrink: 0;
  border-radius: 12px;
}
.starter-photo {
  width: 52px;
  height: 52px;
  flex-shrink: 0;
  border-radius: 12px;
  background: var(--ui-field);
}
.starter-copy {
  flex: 1;
  min-width: 0;
}
.starter-title {
  display: block;
  font-size: 15px;
  font-weight: 500;
  color: var(--ui-text);
}
.starter-hint {
  display: block;
  margin-top: 3px;
  font-size: 12px;
  color: var(--ui-muted);
}
.older {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  min-height: 44px;
  font-size: 13px;
  color: var(--ui-muted);
}
/* Conversation: your words in a bubble on the right; replies flow as text. */
.message {
  margin-top: 20px;
}
.user {
  display: flex;
  justify-content: flex-end;
}
.user .bubble {
  max-width: 80%;
  padding: 10px 14px;
  border-radius: 18px 18px 4px 18px;
  background: var(--ui-selected);
  font-size: 15px;
  line-height: 1.6;
}
.agent-name {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 8px;
  font-size: 13px;
  color: var(--ui-muted);
}
.agent-avatar {
  width: 24px;
  height: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
  color: var(--ui-on-brand);
  background: var(--ui-text);
}
.typing {
  display: flex;
  gap: 5px;
  padding: 8px 0;
}
.typing view {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--ui-brand);
  animation: typing 1.2s infinite ease-in-out;
}
.typing view:nth-child(2) {
  animation-delay: 0.15s;
}
.typing view:nth-child(3) {
  animation-delay: 0.3s;
}
@keyframes typing {
  0%, 60%, 100% { opacity: 0.3; transform: none; }
  30% { opacity: 1; transform: translateY(-3px); }
}
@media (prefers-reduced-motion: reduce) {
  .typing view, .agent-mark { animation: none; }
}
.reply-actions {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 8px;
}
.reply-icon {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: var(--ui-muted);
}
.use-script {
  display: flex;
  align-items: center;
  gap: 6px;
  height: 32px;
  padding: 0 12px;
  border-radius: var(--ui-radius-pill);
  font-size: 13px;
  color: var(--ui-text);
  background: var(--ui-surface);
}
/* Composer: one rounded field that grows, with the send key inside. */
.composer {
  position: relative;
  display: flex;
  align-items: flex-end;
  gap: 8px;
  flex-shrink: 0;
  margin: 24px 16px 16px;
  padding: 6px 6px 6px 16px;
  border-radius: 24px;
  background: var(--ui-surface);
  box-shadow: inset 0 0 0 1px transparent;
  transition: box-shadow 160ms ease;
}
.composer.is-focus {
  box-shadow: inset 0 0 0 1px #ffffff2e;
}
.composer textarea {
  flex: 1;
  width: 0; /* native textarea defaults to 300px; let flex size it */
  min-height: 24px;
  max-height: 120px;
  padding: 8px 0;
  font-size: 15px;
  line-height: 24px;
}
.composer-placeholder {
  color: #868a93;
}
.composer-count.full {
  color: #ff8a94;
}
.composer-count {
  position: absolute;
  right: 60px;
  top: -20px;
  font-size: 11px;
  color: var(--ui-muted);
}
.send {
  width: 40px;
  height: 40px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: var(--ui-muted);
  background: var(--ui-field);
  transition: background 160ms ease;
}
.send.ready {
  color: var(--ui-on-brand);
  background: var(--ui-primary);
}
