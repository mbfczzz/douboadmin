.agent-page {
  height: calc(100vh - 110px - env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  padding-bottom: 45px;
}
.chat-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
}
.conversation {
  padding: 12px 20px 18px;
}
.agent-intro {
  padding: 9px 0 13px;
}
.agent-mark {
  width: 48px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16px;
  background: var(--ui-field);
  color: var(--ui-text);
  margin-bottom: 16px;
}
.headline {
  display: block;
  font-size: 20px;
  margin-bottom: 10px;
}
.agent-intro .muted {
  display: block;
  line-height: 1.8;
}
.suggestions {
  margin: 4px 0 22px;
}
.suggestions > view {
  border-bottom: 1px solid var(--ui-border);
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 0;
  font-size: 13px;
  color: var(--ui-muted);
}
.message {
  margin-top: 15px;
}
.message-label {
  font-size: var(--ui-font-note);
  color: var(--ui-muted);
  margin-bottom: 6px;
}
.bubble {
  padding: 12px 13px;
  border-radius: var(--ui-radius-card);
  background: var(--ui-surface);
  font-size: 15px;
  line-height: 1.9;
  white-space: pre-wrap;
  display: flex;
  gap: 6px;
}
.bubble text {
  min-width: 0;
  word-break: break-all;
}
.user .message-label {
  text-align: right;
}
.user .bubble {
  background: var(--ui-selected);
  margin-left: 25px;
  color: var(--ui-text);
}
.assistant .bubble {
  border: 1px solid transparent;
  margin-right: 10px;
}
.assistant .message-label {
  color: var(--ui-muted);
}
.use-script {
  display: flex;
  gap: 6px;
  align-items: center;
  /* Touch target: 44px tall without moving the text. */
  min-height: 44px;
  font-size: 13px;
  color: var(--ui-link);
  margin: 0;
}
.composer {
  border: 1px solid transparent;
  margin: 6px 20px 12px;
  background: var(--ui-surface);
  border-radius: var(--ui-radius-card);
  padding: 11px 12px;
}
.secondary {
  background: var(--ui-surface);
  color: var(--ui-link);
  border: 1px solid transparent;
  border-radius: 12px;
  font-size: 15px;
}
.composer textarea {
  width: 100%;
  font-size: 15px;
  line-height: 1.6;
  min-height: 32px;
  max-height: 80px;
  margin-bottom: 8px;
}
