<nav-bar title="混剪" size="{{23}}" /><view class="page page-motion {{pageMotion}}">
  <view class="row biz-title-row mix-heading"
    ><text class="biz-heading">素材与灵感</text
    ><text class="biz-link" bindtap="hot">热门视频 ›</text></view
  ><view wx:if="{{loadError}}" class="biz-error" bindtap="load"
    >{{loadError}} · 重试</view
  ><view wx:if="{{config&&!config.enabled}}" class="biz-error"
    >{{config.message}}</view
  >
  <include src="./parts/materials.wxml" />
  <include src="./parts/settings.wxml" />
  <include src="./parts/narration.wxml" />
  <include src="./parts/sound.wxml" />
  <button
    class="biz-action"
    loading="{{busy}}"
    disabled="{{busy||uploading||restoring||!config.enabled}}"
    bindtap="generate"
  >
    开始混剪
  </button>
</view>
