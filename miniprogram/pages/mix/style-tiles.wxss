/* 剪辑风格 as photo cards: the picture fills the tile, the name sits on a
   bottom shade, and the chosen one is lit with a ring above the photo. */
.mix-tile.mix-style {
  position: relative;
  overflow: hidden;
  height: 104px;
  align-items: flex-start;
  justify-content: flex-end;
  padding: 0 10px 9px;
  color: rgba(255, 255, 255, 0.82);
}
.mix-style-photo {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0.6;
  transition: opacity 160ms ease;
}
.mix-style::before {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 60%;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.72));
}
.mix-style text {
  position: relative;
}
.mix-tile.mix-style.on {
  color: #fff;
  box-shadow: none;
}
.mix-style.on .mix-style-photo {
  opacity: 1;
}
.mix-style.on::after {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 12px;
  box-shadow: inset 0 0 0 2px var(--ui-brand);
}
