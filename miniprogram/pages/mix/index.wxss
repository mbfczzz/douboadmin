@import "../../styles/business.wxss";
.mix-heading {
  margin: 12rpx 0 18rpx;
}
.mix-materials {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8px;
}
.mix-material,
.mix-add {
  height: calc((100vw - 86px) / 3);
  border-radius: 14rpx;
  background: #272b2d;
  position: relative;
  overflow: hidden;
}
.mix-upload-music {
  display: block;
  margin-bottom: 8px;
}
.mix-material image {
  width: 100%;
  height: 100%;
}
.mix-add,
.mix-video {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  color: #9bcbaa;
  font-size: 23rpx;
}
.mix-add {
  /* Same size as the material tiles beside it. */
  height: calc((100vw - 86px) / 3);
  border: 1px dashed #577b62;
}
.mix-video text {
  max-width: 150rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 21rpx;
}
.mix-remove {
  position: absolute;
  top: 5rpx;
  right: 5rpx;
  padding: 3rpx 12rpx;
  border-radius: 50%;
  background: #17201bd9;
  color: #fff;
  font-size: 32rpx;
}
.biz-row > view {
  flex: 1;
  min-width: 0;
  overflow-wrap: anywhere;
}
