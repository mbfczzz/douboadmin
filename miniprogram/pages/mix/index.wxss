@import "../../styles/business.wxss";
@import "./form.wxss";
@import "./style-tiles.wxss";
.mix-heading {
  margin: 6px 0 9px;
}
.mix-materials {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8px;
}
.mix-material,
.mix-add {
  height: calc((100vw - 86px) / 3);
  border-radius: 12px;
  background: var(--ui-field);
  position: relative;
  overflow: hidden;
}
.mix-upload-music {
  display: block;
  padding: 10px 0 4px;
  font-size: 13px;
  color: var(--ui-link);
}
.mix-material image {
  width: 100%;
  height: 100%;
}
.mix-add,
.mix-video {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6px;
  color: var(--ui-muted);
  font-size: 13px;
}
.mix-video {
  height: 100%;
}
.mix-video text {
  max-width: 75px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 13px;
}
.mix-remove {
  position: absolute;
  top: 4px;
  right: 4px;
  width: 22px;
  height: 22px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #0f0f11bb;
  color: #fff;
}
.biz-row > view {
  flex: 1;
  min-width: 0;
  overflow-wrap: anywhere;
}
