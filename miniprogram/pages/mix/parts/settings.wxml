<view class="biz-card">
  <text class="mix-label">剪辑风格</text>
  <view class="mix-tiles">
    <view wx:for="{{styles}}" wx:key="value" class="mix-tile {{item.image?'mix-style':''}} {{style===item.value?'on':''}}" data-field="style" data-value="{{item.value}}" bindtap="option" aria-role="button" aria-label="{{item.label+(style===item.value?'，已选中':'')}}">
      <image wx:if="{{item.image}}" class="mix-style-photo" src="{{item.image}}" mode="aspectFill" />
      <t-icon wx:else name="{{item.icon}}" size="24" />
      <text>{{item.label}}</text>
    </view>
  </view>
  <view class="biz-row mix-switch-row">
    <text>自动识别镜头</text>
    <switch checked="{{autoScenes}}" color="#00c8dc" data-field="autoScenes" bindchange="toggle" />
  </view>
  <text class="mix-label">画面比例</text>
  <view class="mix-tiles">
    <view wx:for="{{ratios}}" wx:key="value" class="mix-tile {{ratio===item.value?'on':''}}" data-field="ratio" data-value="{{item.value}}" bindtap="option" aria-role="button" aria-label="{{item.value+(ratio===item.value?'，已选中':'')}}">
      <view class="mix-shape shape-{{item.shape}}" />
      <text>{{item.value}}</text>
    </view>
  </view>
  <text class="mix-label">分辨率</text>
  <view class="biz-tabs">
    <view class="{{resolution==='720p'?'selected':''}}" data-field="resolution" data-value="720p" bindtap="option">720p</view>
    <view class="{{resolution==='1080p'?'selected':''}}" data-field="resolution" data-value="1080p" bindtap="option">1080p</view>
  </view>
  <view class="row mix-label"><text>目标时长</text><text class="mix-value">{{duration}} 秒</text></view>
  <slider class="mix-slider" min="5" max="120" step="5" value="{{duration}}" activeColor="#00c8dc" backgroundColor="#474b54" block-color="#ffffff" block-size="20" bindchanging="duration" bindchange="duration" />
</view>
