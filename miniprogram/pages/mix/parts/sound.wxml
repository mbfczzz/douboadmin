<view class="biz-card"
  ><text class="biz-heading">声音</text
  ><view class="biz-row"
    ><text>保留素材原声</text
    ><switch
      checked="{{keepOriginalAudio}}"
      disabled="{{!config.enabled}}"
      color="#00cae0"
      data-field="keepOriginalAudio"
      bindchange="toggle" /></view
  ><picker
    range="{{musicNames}}"
    value="{{musicIndex}}"
    bindchange="chooseMusic"
    ><view class="biz-row biz-picker-row"
      ><text>背景音乐</text><text class="accent">{{musicLabel}} ›</text></view
    ></picker
  ><view class="biz-link mix-upload-music" bindtap="uploadMusic">上传自己的音乐</view
  ><text class="biz-label">背景音乐音量 {{musicVolume}}%</text
  ><slider
    min="0"
    max="100"
    value="{{musicVolume}}"
    activeColor="#00cae0"
    backgroundColor="#1b3249"
    block-color="#00cae0"
    bindchange="volume"
/></view>
