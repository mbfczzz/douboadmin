.favorite-card {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 11px;
  background: var(--ui-surface);
  border-radius: var(--ui-radius-card);
  margin-bottom: 10px;
}
.favorite-card image {
  flex-shrink: 0;
  width: 75px;
  height: 85px;
  border-radius: 10px;
}
.favorite-card > t-icon {
  flex-shrink: 0;
}
/* Small text button: keep its own width next to the message. */
.unfavorite-action {
  flex-shrink: 0;
  width: auto;
}
.unavailable-favorite > view {
  flex: 1;
  min-width: 0;
  overflow-wrap: anywhere;
}
.favorite-copy {
  flex: 1;
  min-width: 0;
  word-break: break-all;
}
.favorite-copy text {
  display: block;
  margin: 8px 0;
  font-size: 15px;
}
.favorite-copy .small {
  font-size: 13px;
}
.help-card {
  padding: 14px;
}
.help-card text {
  display: block;
  font-size: 13px;
  color: var(--ui-muted);
  line-height: 1.9;
}
.help-card .help-title {
  font-size: 15px;
  color: var(--ui-text);
  margin: 14px 0 7px;
}
.help-card .help-title:first-child {
  margin-top: 0;
}
.feedback {
  height: 150px;
}
.send {
  margin-top: 15px;
}
.unavailable-favorite {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 14px;
  margin-bottom: 12px;
  background: var(--ui-surface);
  border-radius: 12px;
  font-size: 15px;
}
.unavailable-favorite .muted {
  display: block;
  margin-top: 6px;
  font-size: 13px;
}

@import "../../styles/job-pagination.wxss";
