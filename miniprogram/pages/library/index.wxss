.favorite-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 22rpx;
  background: var(--ui-surface);
  border: 1rpx solid var(--ui-border);
  border-radius: 20rpx;
  margin-bottom: 20rpx;
}
.favorite-card image {
  flex-shrink: 0;
  width: 150rpx;
  height: 170rpx;
  border-radius: 12rpx;
}
.favorite-card > t-icon {
  flex-shrink: 0;
}
/* Small text button: keep its own width next to the message. */
.unfavorite-action {
  flex-shrink: 0;
  width: auto;
}
.unavailable-favorite > view {
  flex: 1;
  min-width: 0;
  overflow-wrap: anywhere;
}
.favorite-copy {
  flex: 1;
  min-width: 0;
  word-break: break-all;
}
.favorite-copy text {
  display: block;
  margin: 15rpx 0;
  font-size: 27rpx;
}
.favorite-copy .small {
  font-size: 23rpx;
}
.help-card {
  padding: 28rpx;
}
.help-card text {
  display: block;
  font-size: 25rpx;
  color: var(--ui-muted);
  line-height: 1.9;
}
.help-card .help-title {
  font-size: 28rpx;
  color: #f5f6f7;
  margin: 28rpx 0 14rpx;
}
.help-card .help-title:first-child {
  margin-top: 0;
}
.feedback {
  height: 300rpx;
}
.send {
  margin-top: 30rpx;
}
.unavailable-favorite {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 14px;
  margin-bottom: 12px;
  background: var(--ui-surface);
  border: 1px solid var(--ui-border);
  border-radius: 10px;
  font-size: 14px;
}
.unavailable-favorite .muted {
  display: block;
  margin-top: 6px;
  font-size: 12px;
}

@import "../../styles/job-pagination.wxss";
