/* Recent works: a 3-column wall of covers; a running tile leads it. */
.cover-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 6px;
}
.mine-page .completed-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 6px;
}
.cover-cell {
  position: relative;
  /* 3 columns in 20px page margins with 6px gaps, 3:4 (no aspect-ratio: iOS < 15) */
  height: calc((100vw - 52px) * 4 / 9);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 10px;
  color: var(--ui-muted);
  background: var(--ui-surface);
}
.cover-cell image {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}
.cover-badge {
  position: absolute;
  left: 6px;
  bottom: 6px;
  display: flex;
  align-items: center;
  gap: 3px;
  padding: 2px 6px;
  border-radius: 999px;
  font-size: 11px;
  color: #fff;
  background: #00000080;
}
.running-cell {
  flex-direction: column;
  gap: 2px;
  background: linear-gradient(160deg, #00c8dc29, var(--ui-surface) 70%);
  box-shadow: inset 0 0 0 1px #00c8dc40;
}
.running-cell::after {
  content: "";
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(110deg, transparent 30%, #ffffff14 50%, transparent 70%);
  transform: translateX(-100%);
  animation: running-sheen 2.2s ease-in-out infinite;
}
@keyframes running-sheen {
  to { transform: translateX(100%); }
}
@media (prefers-reduced-motion: reduce) {
  .running-cell::after { animation: none; }
}
.running-ring {
  margin-bottom: 6px;
  color: var(--ui-brand);
}
.running-count {
  font-size: 22px;
  font-weight: 700;
  color: var(--ui-text);
}
.running-text {
  font-size: 12px;
}
.empty-work,
.role-link {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 14px;
  border-radius: 14px;
  background: var(--ui-surface);
  color: var(--ui-muted);
}
.empty-plus,
.role-glyph {
  width: 40px;
  height: 40px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12px;
  color: var(--ui-text);
  background: var(--ui-field);
}
.empty-copy {
  flex: 1;
  min-width: 0;
}
.empty-title {
  display: block;
  font-size: 15px;
  color: var(--ui-text);
}
.empty-hint {
  display: block;
  margin-top: 2px;
  font-size: 12px;
}
/* The role entry (服务商中心 / 推广码) sits right under the points. */
.role-link {
  margin-top: 10px;
  color: var(--ui-muted);
  background: var(--ui-surface);
  box-shadow: inset 0 0 0 1px #00c8dc2e;
}
.role-glyph {
  color: var(--ui-brand);
  background: #00c8dc1f;
}
.role-copy {
  flex: 1;
  min-width: 0;
}
.role-title {
  display: block;
  font-size: 15px;
  font-weight: 500;
  color: var(--ui-text);
}
.role-hint {
  display: block;
  margin-top: 2px;
  font-size: 12px;
}
