<nav-bar title="我的" />
<view class="page mine-page">
  <view wx:if="{{loading}}" class="skel-page" aria-label="正在加载个人信息">
    <view class="skel-profile"><view class="skeleton skel-avatar" /><view class="skel-lines"><view class="skeleton skel-a" /><view class="skeleton skel-b" /></view></view>
    <view class="skeleton skel-strip" />
    <view class="skel-grid three"><view class="skeleton" /><view class="skeleton" /><view class="skeleton" /></view>
  </view>
  <view wx:elif="{{loadError&&!me}}" class="error-box" bindtap="load">{{loadError}} · 点击重试</view>
  <view wx:elif="{{!me}}" class="guest-profile">
    <showcase />
    <text class="guest-title">欢迎来到你的创作空间</text>
    <text class="guest-copy">登录后，保存作品、收藏灵感，继续每一个未完成的好想法。</text>
    <button class="guest-login" bindtap="signIn">登录 / 注册</button>
    <text class="guest-note">手机号仅在你同意后获取</text>
  </view>
  <view wx:elif="{{me}}">
    <view class="mine-hero {{jobs[0].thumbnailUrl||jobs[0].result?'':backdrop?'photo':''}}" aria-hidden="true">
      <image wx:if="{{jobs[0].thumbnailUrl||jobs[0].result}}" src="{{jobs[0].thumbnailUrl||jobs[0].result}}" mode="aspectFill" />
      <image wx:elif="{{backdrop}}" class="backdrop-photo" src="{{backdrop}}" mode="widthFix" />
    </view>
    <view wx:if="{{loadError}}" class="error-box" bindtap="load">刷新失败，已保留上次信息 · 点击重试</view>
    <view class="profile" bindtap="edit" aria-role="button" aria-label="编辑个人资料" hover-class="card-pressed">
      <view class="avatar">
        <image wx:if="{{me.profile.data.avatarUrl}}" src="{{me.profile.data.avatarUrl}}" mode="aspectFill" />
        <text wx:elif="{{avatarLetter}}" class="avatar-letter">{{avatarLetter}}</text>
        <t-icon wx:else name="user" size="30" />
      </view>
      <view class="profile-copy">
        <view class="name-row"><text class="nickname">{{me.profile.data.nickname}}</text><text wx:if="{{roleLabel}}" class="role-label">{{roleLabel}}</text></view>
        <text class="profile-bio">{{me.profile.data.bio||'编辑资料，介绍一下自己'}}</text>
      </view>
      <t-icon name="chevron-right" size="18" />
    </view>
    <view class="statistics">
      <view data-mode="works" bindtap="menu" aria-role="button" aria-label="查看我的作品"><text>{{me.works}}</text><text>作品</text></view>
      <view data-mode="tasks" bindtap="menu" aria-role="button" aria-label="查看生成中任务"><text class="{{me.running?'accent':''}}">{{me.running}}</text><text>生成中</text></view>
      <view data-mode="favorites" bindtap="menu" aria-role="button" aria-label="查看收藏"><text>{{me.favorites}}</text><text>收藏</text></view>
    </view>
    <view class="mine-balance"><points-balance row /></view>
    <view wx:if="{{roleMenu}}" class="role-link" data-mode="{{roleMenu.mode}}" bindtap="menu" aria-role="button" aria-label="{{roleMenu.label}}" hover-class="card-pressed"><view class="role-glyph"><t-icon name="{{roleMenu.icon}}" size="22" /></view><view class="role-copy"><text class="role-title">{{roleMenu.label}}</text><text class="role-hint">{{roleMenu.hint}}</text></view><t-icon name="chevron-right" size="18" /></view>
    <view class="row works-heading"><text class="section-title">最近作品</text><view class="row small muted profile-edit" data-mode="works" bindtap="menu">全部<t-icon name="chevron-right" size="16" /></view></view>
    <view wx:if="{{worksLoading&&!jobs.length}}" class="cover-grid"><view wx:for="{{[1,2,3]}}" wx:key="*this" class="cover-cell skeleton" /></view>
    <view wx:if="{{worksError}}" class="error-box" bindtap="load">{{worksError}}</view>
    <view wx:if="{{jobs.length||me.running}}" class="completed-grid cover-grid">
      <view wx:if="{{me.running}}" class="cover-cell running-cell" data-mode="tasks" bindtap="menu" hover-class="card-pressed" aria-role="button" aria-label="{{me.running+' 个任务生成中'}}">
        <view class="running-ring"><t-loading size="22px" /></view><text class="running-count">{{me.running}}</text><text class="running-text">生成中</text>
      </view>
      <block wx:for="{{jobs}}" wx:key="id"><view wx:if="{{!(me.running&&index===2)}}" class="cover-cell" data-id="{{item.id}}" bindtap="detail" hover-class="card-pressed" aria-label="{{item.shortTitle||'未命名作品'}}">
        <image wx:if="{{item.thumbnailUrl||(item.input.kind==='image'&&item.result)}}" src="{{item.thumbnailUrl||item.result}}" mode="aspectFill" lazy-load data-id="{{item.id}}" binderror="coverError" />
        <t-icon wx:else name="{{item.input.kind==='image'?'image':'play-circle'}}" size="28" />
        <view class="cover-badge"><t-icon name="{{item.input.kind==='image'?'image':'play-circle-filled'}}" size="12" /><text wx:if="{{item.input.kind!=='image'&&item.input.duration}}">{{item.input.duration}}s</text></view>
      </view></block>
    </view>
    <view wx:elif="{{!worksLoading&&!worksError}}" class="empty-work" bindtap="create" hover-class="card-pressed">
      <view class="empty-plus"><t-icon name="add" size="22" /></view><view class="empty-copy"><text class="empty-title">还没有作品</text><text class="empty-hint">写一句描述，生成第一个视频</text></view><t-icon name="chevron-right" size="16" />
    </view>
    <text class="section-title common-heading">常用功能</text>
    <view class="menu-grid">
      <view wx:for="{{menus}}" wx:key="mode" class="menu {{item.mode}}" data-mode="{{item.mode}}" bindtap="menu" aria-role="button" aria-label="{{item.label}}" hover-class="card-pressed"><view class="menu-glyph"><t-icon name="{{item.icon}}" size="22" /><text wx:if="{{item.mode==='notifications'&&unread}}" class="menu-badge">{{unread>99?'99+':unread}}</text></view><text class="menu-label">{{item.label}}</text></view>
    </view>
  </view>
</view>
