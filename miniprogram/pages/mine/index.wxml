<nav-bar title="我的" />
<view class="page mine-page">
  <view wx:if="{{loading}}" class="loading"><t-loading /></view>
  <view wx:elif="{{loadError&&!me}}" class="error-box" bindtap="load">{{loadError}} · 点击重试</view>
  <view wx:elif="{{!me}}" class="guest-profile">
    <view class="avatar"><t-icon name="user" size="28" /></view>
    <text class="guest-title">欢迎来到你的创作空间</text>
    <text class="guest-copy">登录后，保存作品、收藏灵感，继续每一个未完成的好想法。</text>
    <t-button theme="primary" block bind:tap="signIn">微信登录</t-button>
    <text class="note">登录不会自动获取你的头像、昵称或手机号</text>
  </view>
  <view wx:elif="{{me}}">
    <view wx:if="{{loadError}}" class="error-box" bindtap="load">刷新失败，已保留上次信息 · 点击重试</view>
    <view class="profile" bindtap="edit" aria-role="button" aria-label="编辑个人资料" hover-class="card-pressed">
      <view class="avatar">
        <image wx:if="{{me.profile.data.avatarUrl}}" src="{{me.profile.data.avatarUrl}}" mode="aspectFill" />
        <t-icon wx:else name="user" size="24" />
      </view>
      <view class="profile-copy">
        <text class="nickname">{{me.profile.data.nickname}}</text>
        <text class="muted small">{{me.profile.data.bio}}</text>
      </view>
      <view class="profile-edit"><text>编辑资料</text><t-icon name="chevron-right" size="16" /></view>
    </view>
    <view class="mine-balance"><points-balance /></view>
    <view wx:for="{{groups}}" wx:for-item="group" wx:key="*this" class="menu-group">
      <text class="section-title common-heading">{{group}}</text>
      <view class="menu-list">
        <block wx:for="{{menus}}" wx:key="mode">
          <view wx:if="{{item.group===group}}" class="menu" data-mode="{{item.mode}}" bindtap="menu" aria-role="button" aria-label="{{item.label}}" hover-class="card-pressed">
            <view class="icon-tile"><t-icon name="{{item.icon}}" size="20" /></view>
            <text class="menu-label">{{item.label}}</text>
            <text wx:if="{{item.mode==='tasks'&&me.running}}" class="menu-count">{{me.running}}</text>
            <t-icon name="chevron-right" size="16" />
          </view>
        </block>
      </view>
    </view>
  </view>
</view>
