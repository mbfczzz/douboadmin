.mine-page {
  padding: 8px 20px calc(90px + env(safe-area-inset-bottom));
}
.profile {
  display: flex;
  align-items: center;
  gap: 15px;
  height: 64px;
  margin-bottom: 19px;
}
.avatar {
  width: 64px;
  height: 64px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #25372c;
  border: 1rpx solid #577b62;
  color: #bcdcc5;
  font-size: 43rpx;
  flex-shrink: 0;
}
.profile-copy {
  flex: 1;
  min-width: 0;
}
.nickname {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 17px;
  font-weight: 700;
  display: block;
  margin-bottom: 10px;
}
.profile-copy .muted {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 12px;
  line-height: 1.8;
  display: block;
}
.numbers {
  display: flex;
  background: #1c1f21;
  height: 71px;
  padding: 10px 0;
}
.numbers > view {
  width: 33.333%;
  text-align: center;
}
.numbers > view > text:first-child {
  display: block;
  font-size: 18px;
  font-weight: 700;
}
.numbers > view > text:last-child {
  font-size: 11px;
  color: #a0a8ac;
  display: block;
  margin-top: 10px;
}
.works {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8px;
}
.work {
  min-width: 0;
  background: #1c1f21;
  border-radius: 10px;
  overflow: hidden;
}
.work-cover {
  height: 116px;
  position: relative;
}
.work-cover image {
  width: 100%;
  height: 100%;
}
.work-state {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  font-size: 11px;
  background: #13151699;
  padding: 5rpx 9rpx;
  border-radius: 10px;
}
.work-title {
  display: block;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 12px;
  margin: 10px 8px 4px;
}
.work-kind {
  display: block;
  font-size: 11px;
  color: #a0a8ac;
  margin: 0 8px 8px;
}
.empty-work {
  padding: 45rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 22rpx;
  border: 1rpx solid #353b3e;
  border-radius: 18rpx;
  color: #a0a8ac;
  font-size: 24rpx;
}
.menu {
  position: relative;
  display: flex;
  align-items: center;
  gap: 12px;
  height: 43px;
  padding: 0;
  font-size: 14px;
}
.menu > t-icon:first-child {
  color: #a0a8ac;
}
.menu text {
  flex: 1;
}
.menu > t-icon:last-child {
  color: #818b90;
}
.menu::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 33px;
  right: 0;
  height: 1px;
  background: #2d2f34;
}
.works-heading {
  font-size: 16px;
  margin: 17px 0 12px;
}
.works-heading .small {
  font-size: 12px;
  font-weight: 400;
}
.common-heading {
  font-size: 16px;
  margin: 13px 0 8px;
}
.avatar image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}
.guest-profile {
  padding: 65rpx 15rpx;
  text-align: center;
}
.guest-profile .avatar {
  margin: 0 auto 40rpx;
}
.guest-title {
  display: block;
  font-size: 37rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}
.guest-copy {
  display: block;
  font-size: 27rpx;
  color: #a0a8ac;
  line-height: 1.9;
  margin-bottom: 60rpx;
}
.mine-balance {
  margin: 24px 0;
}
.work-placeholder {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
