@import "../../styles/works.wxss";
@import "./content.wxss";
.mine-page {
  padding: 12px 20px calc(94px + env(safe-area-inset-bottom));
}
.profile {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  padding-top: 8px;
  text-align: center;
}
.avatar {
  position: relative;
  width: 72px;
  height: 72px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--ui-field);
  color: var(--ui-text);
  flex-shrink: 0;
}
.avatar image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}
.profile-copy {
  max-width: 100%;
}
.avatar-edit {
  position: absolute;
  right: -2px;
  bottom: -2px;
  width: 24px;
  height: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  border: 2px solid var(--ui-bg);
  background: var(--ui-selected);
}
.nickname,
.profile-bio {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
}
.nickname {
  font-size: 20px;
  line-height: 28px;
  font-weight: 600;
  margin-bottom: 4px;
}
.profile-bio {
  font-size: 13px;
  color: var(--ui-muted);
  text-align: center;
  margin-top: 8px;
  line-height: 20px;
}
.mine-balance {
  margin: 28px 0;
}
.profile-edit {
  min-height: 44px;
  flex-shrink: 0;
}
.common-heading {
  font-size: 16px;
  line-height: 24px;
  margin: 28px 0 14px;
}
.menu-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  border: 1px solid transparent;
  padding: 8px 16px;
  border-radius: var(--ui-radius-card);
  background: var(--ui-surface);
}
.menu {
  display: flex;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  gap: 10px;
  min-height: 80px;
  color: var(--ui-text);
}
.menu-label {
  min-width: 0;
  color: var(--ui-text);
  font-size: 13px;
  text-align: center;
  line-height: 22px;
}
.guest-profile {
  padding: 32px 8px;
  text-align: center;
}
.guest-profile .avatar {
  margin: 0 auto 20px;
}
.guest-note {
  display: block;
  margin-top: 16px;
  color: var(--ui-muted);
  font-size: var(--ui-font-note);
  line-height: 1.6;
}
.guest-title {
  display: block;
  font-size: 20px;
  font-weight: 600;
  margin-bottom: 12px;
}
.guest-copy {
  display: block;
  font-size: 15px;
  color: var(--ui-muted);
  line-height: 1.8;
  margin-bottom: 28px;
}
