.mine-page {
  padding: 12px 20px calc(94px + env(safe-area-inset-bottom));
}
.profile {
  display: flex;
  align-items: center;
  gap: 14px;
  min-height: 56px;
}
.avatar {
  width: 48px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--ui-selected);
  color: var(--ui-brand);
  flex-shrink: 0;
}
.avatar image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}
.profile-copy {
  flex: 1;
  min-width: 0;
}
.nickname,
.profile-copy .muted {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
}
.nickname {
  font-size: 18px;
  line-height: 26px;
  font-weight: 600;
  margin-bottom: 4px;
}
.profile-copy .muted {
  line-height: 20px;
}
.profile-edit {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  min-height: 44px;
  color: var(--ui-muted);
  font-size: 12px;
}
.mine-balance {
  margin: 28px 0;
}
.menu-group + .menu-group {
  margin-top: 28px;
}
.common-heading {
  font-size: 16px;
  line-height: 24px;
  margin: 0 0 12px;
}
.menu-list {
  border: 1px solid var(--ui-border);
  padding: 8px 16px;
  border-radius: var(--ui-radius-card);
  background: var(--ui-surface);
}
.menu {
  display: flex;
  align-items: center;
  gap: 12px;
  min-height: 48px;
  color: var(--ui-muted);
}
.menu + .menu {
  border-top: 1px solid var(--ui-border);
}
.menu-label {
  flex: 1;
  min-width: 0;
  color: var(--ui-text);
  font-size: 14px;
  line-height: 22px;
}
.menu-count {
  color: var(--ui-link);
  font-variant-numeric: tabular-nums;
}
.guest-profile {
  padding: 32px 8px;
  text-align: center;
}
.guest-profile .avatar {
  margin: 0 auto 20px;
}
.guest-title {
  display: block;
  font-size: 20px;
  font-weight: 600;
  margin-bottom: 12px;
}
.guest-copy {
  display: block;
  font-size: 14px;
  color: var(--ui-muted);
  line-height: 1.8;
  margin-bottom: 28px;
}
