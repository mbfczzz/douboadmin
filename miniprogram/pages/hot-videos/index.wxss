@import "../../styles/business.wxss";
.hot-search {
  display: flex;
  align-items: center;
  margin-bottom: 12px;
  border-radius: var(--ui-radius-pill);
  background: var(--ui-field);
}
.hot-search input {
  flex: 1;
  min-width: 0;
}
.hot-search button.biz-action {
  width: auto;
  flex: 0 0 auto;
  min-height: 44px;
  padding: 0 18px;
  margin: 0;
  background: transparent;
  color: var(--ui-link);
  font-size: 15px;
}
.hot-search input.biz-input {
  background: transparent;
  padding: 11px 8px;
}
.hot-search > t-icon {
  margin-left: 16px;
  color: var(--ui-muted);
}
/* Sort: text tabs with a short cyan underline, as on the templates page. */
.sort-tabs {
  gap: 22px;
  margin: 4px 0 14px;
}
.sort-tabs view {
  position: relative;
  padding: 8px 0;
  border-radius: 0;
  background: transparent;
  font-size: 15px;
}
.sort-tabs .selected {
  background: transparent;
  font-weight: 600;
}
.sort-tabs .selected::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 14px;
  height: 3px;
  margin-left: -7px;
  border-radius: 2px;
  background: var(--ui-brand);
}
.hot-words {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}
.hot-words text {
  max-width: 100%;
  overflow-wrap: anywhere;
  padding: 6px 12px;
  border-radius: 999px;
  font-size: 13px;
  color: var(--ui-text);
  background: var(--ui-field);
}
.hot-words text:nth-child(-n+3) {
  color: var(--ui-brand);
  background: #00c8dc1a;
}
.hot-title {
  margin-top: 11px;
}

.hot-stats {
  display: flex;
  gap: 16px;
  margin-top: 8px;
  font-size: 12px;
  color: var(--ui-muted);
}
.hot-stats view {
  display: flex;
  align-items: center;
  gap: 4px;
}
.hot-more {
  padding: 16px 0;
  text-align: center;
  font-size: 13px;
  color: var(--ui-muted);
}
