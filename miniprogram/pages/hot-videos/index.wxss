@import "../../styles/business.wxss";
.hot-search {
  display: flex;
  gap: 24rpx;
  align-items: center;
  margin-bottom: 24rpx;
}
.hot-search input {
  flex: 1;
  min-width: 0;
}
.hot-search button.biz-action {
  width: auto;
  flex: 0 0 auto;
  min-height: 86rpx;
  white-space: nowrap;
  padding: 20rpx 32rpx;
  margin: 0;
}
.hot-words {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}
.hot-words text {
  max-width: 100%;
  overflow-wrap: anywhere;
  background: #272b2d;
  padding: 12rpx 18rpx;
  border-radius: 10rpx;
  color: #9bcbaa;
  font-size: 25rpx;
}
.hot-title {
  margin-top: 22rpx;
}
