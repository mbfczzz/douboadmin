@import "../../styles/business.wxss";
.hot-search {
  display: flex;
  align-items: center;
  margin-bottom: 12px;
  border-radius: var(--ui-radius-pill);
  background: var(--ui-field);
}
.hot-search input {
  flex: 1;
  min-width: 0;
}
.hot-search button.biz-action {
  width: auto;
  flex: 0 0 auto;
  min-height: 44px;
  padding: 0 18px;
  margin: 0;
  background: transparent;
  color: var(--ui-link);
  font-size: 15px;
}
.hot-search input.biz-input {
  background: transparent;
  padding: 11px 18px;
}
.hot-words {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}
.hot-words text {
  max-width: 100%;
  overflow-wrap: anywhere;
  background: var(--ui-field);
  padding: 6px 9px;
  border-radius: 6px;
  color: var(--ui-link);
  font-size: 13px;
}
.hot-title {
  margin-top: 11px;
}
