<nav-bar title="热门视频灵感" back /><view
  class="subpage"
  ><view wx:if="{{ready&&!enabled}}" class="biz-empty"
    ><view class="empty-icon"><t-icon name="video" size="30" /></view
    ><text>热门视频暂不可用，先去创作吧。</text
    ><text class="empty-link" bindtap="upload">去创作 ›</text></view
  ><block wx:else
  ><view class="hot-search"
    ><t-icon name="search" size="18" /><input
      class="biz-input"
      value="{{query}}"
      bindinput="input"
      bindconfirm="search"
      confirm-type="search"
      maxlength="60"
      placeholder="搜索抖音视频关键词"
    /><button class="biz-action" bindtap="search" loading="{{loading}}">
      搜索
    </button></view
  ><view wx:if="{{loadError}}" class="biz-error">{{loadError}}</view
  ><view wx:if="{{searched}}" class="biz-tabs sort-tabs"
    ><view
      class="{{sort==='relevance'?'selected':''}}"
      data-value="relevance"
      bindtap="sort"
      >综合</view
    ><view
      class="{{sort==='likes'?'selected':''}}"
      data-value="likes"
      bindtap="sort"
      >点赞</view
    ><view
      class="{{sort==='recent'?'selected':''}}"
      data-value="recent"
      bindtap="sort"
      >最新</view
    ><view
      class="{{sort==='views'?'selected':''}}"
      data-value="views"
      bindtap="sort"
      >播放（本页）</view
    ></view
  ><text wx:if="{{sortScope==='page'}}" class="biz-note"
    >仅对当前返回的视频按已提供的播放量排序。</text
  ><view wx:if="{{!searched}}"
    ><view wx:if="{{words.length}}" class="biz-card"
      ><text class="biz-heading">{{wordSource}}</text
      ><view class="hot-words"
        ><text
          wx:for="{{words}}"
          wx:key="*this"
          data-word="{{item}}"
          bindtap="choose"
          >{{item}}</text
        ></view
      ></view
    ><view wx:if="{{history.length}}" class="biz-card"
      ><view class="row biz-title-row"
        ><text class="biz-heading">最近搜索</text
        ><text class="biz-link" bindtap="clearHistory">清空</text></view
      ><view class="hot-words"
        ><text
          wx:for="{{history}}"
          wx:key="keyword"
          data-word="{{item.keyword}}"
          bindtap="choose"
          >{{item.keyword}}</text
        ></view
      ></view
    ></view
  ><view
    wx:for="{{items}}"
    wx:key="id"
    class="biz-card"
    data-id="{{item.id}}"
    bindtap="detail"
    ><image
      class="biz-image"
      src="{{item.cover}}"
      mode="aspectFill"
      lazy-load
    /><text class="biz-list-title hot-title">{{item.title}}</text
    ><text class="biz-small">{{item.author}} · {{item.dateText}}</text
    ><view class="hot-stats"
      ><view><t-icon name="heart" size="14" /><text>{{item.likesText}}</text></view
      ><view><t-icon name="play-circle" size="14" /><text>{{item.viewsText}}</text></view></view
    ></view
  ><view
    wx:if="{{searched&&!loading&&!items.length&&!loadError}}"
    class="biz-empty"
    ><view class="empty-icon"><t-icon name="search" size="26" /></view><text>没有找到相关视频，换个关键词试试</text></view
  ><view wx:if="{{hasMore}}" class="hot-more" bindtap="more">{{loading?'正在加载…':'加载更多'}}</view></block
></view
>
