@import "../../styles/business.wxss";
.activation-page {
  padding-top: 40px;
}
.activation-intro {
  max-width: 300px;
  margin: 12px auto 0;
  text-align: center;
}
.activation-status {
  margin-top: 24px;
}
.activation-options {
  margin-top: 24px;
}
.activation-path + .activation-path {
  margin-top: 24px;
  padding-top: 24px;
  border-top: 1px solid #353b3e;
}
.activation-logo {
  width: 52px;
  height: 52px;
  margin: 0 auto 24px;
  border-radius: 14px;
  background: #9bcbaa;
  color: #17281d;
  font-size: 28px;
  line-height: 52px;
  text-align: center;
  font-weight: 600;
}
.activation-title {
  display: block;
  font-size: 23px;
  font-weight: 600;
  line-height: 1.4;
  text-align: center;
}
.activation-links {
  display: flex;
  justify-content: space-between;
  color: #9bcbaa;
  font-size: 26rpx;
  margin-top: 30rpx;
}
.activation-links text,
.activation-privacy {
  padding: 12px 0;
}
.activation-privacy {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #a0a8ac;
  margin-top: 36rpx;
}
