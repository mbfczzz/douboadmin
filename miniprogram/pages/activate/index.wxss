@import "../../styles/business.wxss";
@import "./entry.wxss";
.activation-page {
  padding-top: 40px;
}
.activation-intro {
  max-width: 300px;
  margin: 12px auto 0;
  text-align: center;
}
.activation-status {
  margin-top: 24px;
}
.activation-options {
  margin-top: 24px;
}
.activation-path + .activation-path {
  margin-top: 24px;
  padding-top: 24px;
  border-top: 1px solid var(--ui-border);
}
.activation-logo {
  display: block;
  width: 160px;
  height: 78px;
  margin: 0 auto 24px;
}
.activation-title {
  display: block;
  font-size: 20px;
  font-weight: 600;
  line-height: 1.4;
  text-align: center;
}
.activation-links {
  display: flex;
  justify-content: space-between;
  color: var(--ui-link);
  font-size: 13px;
  margin-top: 15px;
}
.activation-links .sign-out {
  color: var(--ui-muted);
}
.activation-links text,
.activation-privacy {
  padding: 12px 0;
}
.activation-privacy {
  display: block;
  text-align: center;
  font-size: 13px;
  color: var(--ui-muted);
  margin-top: 18px;
}
.activation-path .biz-action + .biz-input,
.activation-path .biz-input + .biz-input {
  margin-top: 12px;
}
.activation-sms {
  display: flex;
  gap: 10px;
  margin-top: 12px;
}
.activation-sms .biz-input {
  flex: 1;
  min-width: 0;
}
.activation-sms button.biz-action {
  flex-shrink: 0;
  width: 108px;
  margin: 0;
  padding: 11px 8px;
  font-size: 15px;
  white-space: nowrap;
}
.browse-link {
  display: block;
  margin: 16px auto 0;
}
.activation-status {
  text-align: center;
}
.status-icon {
  margin-bottom: 10px;
  background: var(--ui-field);
}
