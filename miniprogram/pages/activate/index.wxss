@import "../../styles/business.wxss";
.activation-page {
  padding-top: 40px;
}
.activation-intro {
  max-width: 300px;
  margin: 12px auto 0;
  text-align: center;
}
.activation-status {
  margin-top: 24px;
}
.activation-options {
  margin-top: 24px;
}
.activation-path + .activation-path {
  margin-top: 24px;
  padding-top: 24px;
  border-top: 1px solid #353b3e;
}
.activation-logo {
  display: block;
  width: 160px;
  height: 78px;
  margin: 0 auto 24px;
  border-radius: 8px;
}
.activation-title {
  display: block;
  font-size: 23px;
  font-weight: 600;
  line-height: 1.4;
  text-align: center;
}
.activation-links {
  display: flex;
  justify-content: space-between;
  color: #9bcbaa;
  font-size: 26rpx;
  margin-top: 30rpx;
}
.activation-links text,
.activation-privacy {
  padding: 12px 0;
}
.activation-privacy {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #a0a8ac;
  margin-top: 36rpx;
}
.activation-path .biz-input + .biz-input {
  margin-top: 12px;
}
.activation-sms {
  display: flex;
  gap: 10px;
  margin-top: 12px;
}
.activation-sms .biz-input {
  flex: 1;
  min-width: 0;
}
.activation-sms button.biz-action {
  flex-shrink: 0;
  width: 120px;
  margin: 0;
  padding: 11px 8px;
  font-size: 14px;
  white-space: nowrap;
}
