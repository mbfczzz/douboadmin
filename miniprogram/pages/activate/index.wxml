<nav-bar title="授权开通" />
<view class="subpage activation-page">
  <image class="activation-logo brand-tile" src="{{brandIcon}}" mode="aspectFit" aria-label="豆播 AI" />
  <text class="activation-title">开通你的创作空间</text>
  <text wx:if="{{!logged}}" class="biz-note activation-intro">登录后填写资料。</text>
  <text wx:elif="{{status.profileRequired}}" class="biz-note activation-intro">第 1 步：填写资料。</text>
  <text wx:elif="{{status.status==='review'}}" class="biz-note activation-intro">已登记，超级管理员开通后即可使用。</text>
  <text wx:elif="{{!status||status.status==='pending'||status.status==='unbound'||status.status==='rejected'}}" class="biz-note activation-intro">第 2 步：扫描服务商或会员给你的二维码登记。</text>
  <view wx:if="{{loading}}" class="biz-note">正在确认授权状态…</view>
  <view wx:if="{{loadError}}" class="biz-error" bindtap="load">{{loadError}} · 点击重试</view>
  <block wx:if="{{!logged}}">
    <button wx:if="{{phoneReady}}" class="biz-action" open-type="getPhoneNumber" bindgetphonenumber="phoneLogin" loading="{{busy}}" disabled="{{busy||loading||!wechatReady}}">手机号授权登录</button>
    <button wx:else class="biz-action" loading="{{busy}}" disabled="{{busy||loading||!wechatReady}}" bindtap="login">微信登录</button>
    <button wx:if="{{phoneReady}}" class="text-button phone-alternative" bindtap="login" disabled="{{busy||loading}}">使用其他手机号</button>
  </block>
  <block wx:else>
    <view wx:if="{{status.profileRequired}}" class="biz-card activation-options">
      <view class="activation-path">
        <text class="biz-heading">填写资料</text>
        <input class="biz-input" placeholder="姓名" value="{{name}}" maxlength="30" data-field="name" bindinput="field" disabled="{{busy}}" />
        <input class="biz-input" type="number" placeholder="手机号" value="{{phone}}" maxlength="11" data-field="phone" bindinput="field" disabled="{{busy||status.phoneVerified}}" />
        <text wx:if="{{status.phoneVerified}}" class="biz-note">手机号已验证，填写姓名即可继续。</text>
        <block wx:if="{{status.smsRequired!==false}}">
          <view class="activation-sms">
            <input class="biz-input" type="number" placeholder="短信验证码" value="{{smsCode}}" maxlength="6" data-field="smsCode" bindinput="field" disabled="{{busy}}" />
            <button class="biz-action biz-secondary" loading="{{sending}}" disabled="{{busy||sending||countdown>0||phone.length!==11}}" bindtap="sendCode">{{countdown>0?countdown+' 秒后重发':'获取验证码'}}</button>
          </view>
        </block>
        <button class="biz-action" loading="{{busy}}" disabled="{{busy||loading||!name||phone.length!==11||(status.smsRequired!==false&&smsCode.length!==6)}}" bindtap="register">下一步</button>
      </view>
    </view>
    <block wx:else>
      <view wx:if="{{status.message&&status.status!=='pending'}}" class="biz-card activation-status">
        <text class="biz-list-title">{{status.status==='review'?'等待超级管理员开通':'授权状态'}}</text>
        <text class="biz-note">{{status.status==='review'&&status.partnerName?'已登记到「'+status.partnerName+'」，开通后会通知你，也可稍后刷新查看。':status.message}}</text>
      </view>
      <view wx:if="{{!loadError&&(!status||status.status==='pending'||status.status==='unbound'||status.status==='rejected')}}" class="biz-card activation-options">
        <view class="activation-path">
          <text class="biz-heading">加入服务商</text>
          <text class="biz-note">扫码登记对应角色，超级管理员开通后生效</text>
          <button class="biz-action" loading="{{busy}}" disabled="{{busy||loading}}" bindtap="scan">扫码登记</button>
          <view class="activation-sms">
            <input class="biz-input" placeholder="或输入 8 位码" value="{{code}}" maxlength="24" bindinput="input" disabled="{{busy}}" />
            <button class="biz-action biz-secondary" disabled="{{busy||loading||!code}}" bindtap="confirm">确认登记</button>
          </view>
        </view>
      </view>
    </block>
    <button wx:if="{{status.canBrowse&&!status.active}}" class="text-button browse-link" disabled="{{busy||loading}}" bindtap="enter">先浏览小程序</button>
    <view class="activation-links"><text bindtap="load">刷新授权状态</text><text class="sign-out" bindtap="signOut">退出登录</text></view>
  </block>
  <text class="activation-privacy" bindtap="privacy">隐私保护指引</text>
</view>
