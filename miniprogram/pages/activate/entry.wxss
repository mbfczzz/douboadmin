/* Scanning is something you aim at: a tappable viewfinder, not a button. */
.scan-tile {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 22px 12px 18px;
  border-radius: 16px;
  background:
    radial-gradient(circle at 50% 38%, #00c8dc1f, transparent 62%),
    var(--ui-field);
  transition:
    opacity 120ms ease,
    transform 120ms ease;
}
.scan-pressed {
  opacity: 0.8;
  transform: scale(0.98);
}
.scan-tile.is-busy {
  opacity: 0.6;
}
.scan-frame {
  position: relative;
  width: 84px;
  height: 84px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  color: var(--ui-brand);
}
.scan-frame::before,
.scan-frame::after,
.scan-corners::before,
.scan-corners::after {
  content: "";
  position: absolute;
  width: 20px;
  height: 20px;
  border: 0 solid var(--ui-brand);
}
.scan-frame::before {
  top: 0;
  left: 0;
  border-width: 3px 0 0 3px;
  border-top-left-radius: 8px;
}
.scan-frame::after {
  top: 0;
  right: 0;
  border-width: 3px 3px 0 0;
  border-top-right-radius: 8px;
}
.scan-corners::before {
  bottom: 0;
  left: 0;
  border-width: 0 0 3px 3px;
  border-bottom-left-radius: 8px;
}
.scan-corners::after {
  bottom: 0;
  right: 0;
  border-width: 0 3px 3px 0;
  border-bottom-right-radius: 8px;
}
.scan-corners {
  position: absolute;
  inset: 0;
}
.scan-line {
  position: absolute;
  left: 10px;
  right: 10px;
  top: 12px;
  height: 2px;
  border-radius: 1px;
  background: linear-gradient(90deg, transparent, var(--ui-brand), transparent);
  box-shadow: 0 0 8px var(--ui-brand);
  animation: scan-sweep 2.4s ease-in-out infinite;
}
.scan-title {
  margin-top: 14px;
  font-size: 16px;
  font-weight: 600;
  line-height: 22px;
}
.scan-hint {
  margin-top: 4px;
  font-size: 12px;
  line-height: 18px;
  color: var(--ui-muted);
  text-align: center;
}
@keyframes scan-sweep {
  0%,
  100% {
    transform: translateY(0);
    opacity: 0.2;
  }
  50% {
    transform: translateY(58px);
    opacity: 1;
  }
}
/* Switching between scanning and typing a code: a quiet text link. */
.mode-link {
  display: block;
  margin: 14px auto 0;
  padding: 8px 12px;
  width: fit-content;
  font-size: 13px;
  color: var(--ui-muted);
}
.code-title {
  display: block;
  font-size: 17px;
  font-weight: 600;
  line-height: 24px;
  text-align: center;
}
.code-sub {
  display: block;
  margin: 4px 0 18px;
  font-size: 12px;
  color: var(--ui-muted);
  text-align: center;
}
.code-cells.is-busy {
  opacity: 0.6;
}
.code-hint.is-busy {
  color: var(--ui-muted);
}
/* Invite code: eight cells, four + four around a fixed dash. */
.code-cells {
  position: relative;
  display: flex;
  align-items: center;
  gap: 6px;
}
.code-cell {
  position: relative;
  flex: 1;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10px;
  background: var(--ui-field);
  color: var(--ui-text);
  font-size: 20px;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  transition:
    box-shadow 160ms ease,
    background 160ms ease;
}
.code-cell.current {
  box-shadow: inset 0 0 0 1.5px var(--ui-brand);
}
.code-cell.current::after {
  content: "";
  width: 2px;
  height: 20px;
  border-radius: 1px;
  background: var(--ui-brand);
  animation: code-caret 1s steps(1) infinite;
}
.code-cells.ready .code-cell {
  background: #00c8dc14;
  box-shadow: inset 0 0 0 1px #00c8dc59;
}
.code-dash {
  flex: 0 0 10px;
  height: 2px;
  border-radius: 1px;
  background: var(--ui-muted);
}
/* The real input sits off-screen; the cells above show what it holds. */
.code-native {
  position: absolute;
  left: -200vw;
  top: 0;
  width: 1px;
  height: 1px;
  opacity: 0;
}
.code-meta {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12px;
  min-height: 20px;
  margin: 10px 0 4px;
}
.code-hint {
  flex: 1;
  font-size: 12px;
  line-height: 18px;
  color: var(--ui-warning);
}
.code-paste {
  margin: -12px -4px -12px 0;
  padding: 12px 4px;
  font-size: 13px;
  color: var(--ui-link);
}
@keyframes code-caret {
  50% {
    opacity: 0;
  }
}
@media (prefers-reduced-motion: reduce) {
  .code-cell.current::after,
  .scan-line {
    animation: none;
  }
}
