<nav-bar title="消息通知" back /><view
  class="subpage page-motion {{pageMotion}}"
  ><view wx:if="{{needsLogin}}" class="biz-empty"
    >登录后查看消息<button class="biz-action" bindtap="signIn">
      去登录
    </button></view
  ><block wx:else
    ><view class="row"
      ><text class="biz-small">未读 {{unread}}</text
      ><text class="biz-link" bindtap="readAll">全部已读</text></view
    ><view wx:if="{{loadError}}" class="biz-error" bindtap="load"
      >{{loadError}} · 重试</view
    ><view wx:if="{{!loading&&!items.length}}" class="biz-empty"
      >暂时没有新消息</view
    ><view
      wx:for="{{items}}"
      wx:key="id"
      class="biz-card"
      data-id="{{item.id}}"
      bindtap="open"
      ><view class="row biz-card-head"
        ><text class="biz-list-title"
          >{{item.data.read?'':'● '}}{{item.data.title}}</text
        ><text class="biz-small">{{item.time}}</text></view
      ><text class="biz-note">{{item.data.content}}</text></view
    ></block
  ></view
>
