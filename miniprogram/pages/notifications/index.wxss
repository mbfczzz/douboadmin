@import "../../styles/business.wxss";
.notice-head {
  margin-bottom: 8px;
}
.unread::before {
  content: "";
  display: inline-block;
  width: 6px;
  height: 6px;
  margin: 0 8px 2px 0;
  border-radius: 50%;
  background: var(--ui-brand);
  vertical-align: middle;
}
.biz-list-title {
  font-weight: 400;
  color: var(--ui-muted);
}
.biz-list-title.unread {
  font-weight: 500;
  color: var(--ui-text);
}
