@import "../../styles/business.wxss";
.notice-head {
  margin-bottom: 4px;
}
/* Notices: a quiet list with a tone icon; unread ones carry a cyan dot. */
.notice {
  display: flex;
  gap: 12px;
  padding: 14px 0;
  border-bottom: 1px solid var(--ui-border);
}
.notice-pressed {
  opacity: 0.7;
}
.notice-icon {
  position: relative;
  width: 40px;
  height: 40px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}
.tone-ok { color: var(--ui-success); background: var(--ui-success-bg); }
.tone-danger { color: #ff8a94; background: #ff5c6c1a; }
.tone-info { color: var(--ui-brand); background: #00c8dc1a; }
.unread .notice-icon::after {
  content: "";
  position: absolute;
  top: 0;
  right: 0;
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: var(--ui-brand);
  box-shadow: 0 0 0 2px var(--ui-bg);
}
.notice-body {
  flex: 1;
  min-width: 0;
}
.notice-line {
  display: flex;
  align-items: baseline;
  gap: 8px;
}
.notice-title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  font-size: 15px;
  color: var(--ui-muted);
  text-overflow: ellipsis;
  white-space: nowrap;
}
.unread .notice-title {
  font-weight: 600;
  color: var(--ui-text);
}
.notice-time {
  flex-shrink: 0;
  font-size: 12px;
  color: var(--ui-muted);
}
.notice-text {
  display: -webkit-box;
  margin-top: 4px;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  font-size: 13px;
  line-height: 1.6;
  color: var(--ui-muted);
}
.notice-more {
  padding: 18px 0;
  text-align: center;
  font-size: 13px;
  color: var(--ui-muted);
}
.notice-day {
  display: block;
  margin: 18px 0 2px;
  font-size: 12px;
  color: var(--ui-muted);
}
.notice-head {
  align-items: center;
}
.read-all {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 5px 12px;
  border-radius: 999px;
  font-size: 12px;
  color: var(--ui-brand);
  background: #00c8dc1a;
}
.row-pressed {
  opacity: 0.7;
}
.notice-thumb {
  width: 48px;
  height: 60px;
  flex-shrink: 0;
  border-radius: 8px;
  background: var(--ui-field);
}
