.preview-page {
  padding: 24px 20px calc(130px + env(safe-area-inset-bottom));
  --td-button-primary-bg-color: #ffffff;
  --td-button-primary-color: #02070d;
  --td-button-primary-border-color: #ffffff;
  --td-button-border-radius: 22px;
}
.preview {
  width: 100%;
  height: 438px;
  max-height: 55vh;
  background: var(--ui-surface);
  border-radius: 8px;
}
.preview-frame {
  position: relative;
}
.preview-zoom {
  position: absolute;
  top: 12px;
  right: 12px;
  width: 38px;
  height: 38px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 6px;
  background: #02070dbb;
}
.preview-zoom::after {
  content: "";
  position: absolute;
  inset: -3px;
}
.preview-name {
  word-break: break-all;
  font-size: 16px;
  font-weight: 500;
  margin: 24px 0 10px;
}
.preview-hint {
  font-size: 14px;
  line-height: 1.5;
  color: var(--ui-muted);
}
.preview-page .foot-actions {
  position: fixed;
  left: 20px;
  right: 20px;
  bottom: calc(26px + env(safe-area-inset-bottom));
  gap: 10px;
  margin: 0;
  background: transparent;
}
