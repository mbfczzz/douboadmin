.preview-page {
  padding: 24px 20px calc(130px + env(safe-area-inset-bottom));
}
.preview {
  width: 100%;
  height: 438px;
  max-height: 55vh;
  background: var(--ui-surface);
  border-radius: 8px;
}
.preview-frame {
  position: relative;
}
.preview-zoom {
  position: absolute;
  top: 12px;
  right: 12px;
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10px;
  background: #0f0f11bb;
  color: #ffffff;
}
.preview-zoom::after {
  content: "";
  position: absolute;
  inset: -3px;
}
.preview-name {
  word-break: break-all;
  font-size: 16px;
  font-weight: 500;
  margin: 24px 0 10px;
}
.preview-hint {
  font-size: 13px;
  line-height: 1.5;
  color: var(--ui-muted);
}
.preview-page .foot-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 12px 20px calc(26px + env(safe-area-inset-bottom));
  gap: 10px;
  margin: 0;
  background: var(--ui-bg);
}
