.preview-page {
  padding: 24px 20px calc(130px + env(safe-area-inset-bottom));
  --td-button-primary-bg-color: #e2e7e3;
  --td-button-primary-color: #1a211d;
  --td-button-primary-border-color: #e2e7e3;
  --td-button-border-radius: 7px;
}
.preview {
  width: 100%;
  height: 438px;
  max-height: 55vh;
  background: #1c1f21;
  border-radius: 8px;
}
.preview-name {
  word-break: break-all;
  font-size: 16px;
  font-weight: 500;
  margin: 24px 0 10px;
}
.preview-hint {
  font-size: 14px;
  line-height: 1.5;
  color: #a0a8ac;
}
.preview-page .foot-actions {
  position: fixed;
  left: 20px;
  right: 20px;
  bottom: calc(26px + env(safe-area-inset-bottom));
  gap: 10px;
  margin: 0;
  background: #131516;
}
