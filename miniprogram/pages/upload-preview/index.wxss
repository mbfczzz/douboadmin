.preview-page {
  padding: 12px 20px calc(110px + env(safe-area-inset-bottom));
}
/* The photo sits on a black stage, edge to edge, like a darkroom proof. */
.preview-frame {
  position: relative;
  height: 62vh;
  border-radius: 16px;
  overflow: hidden;
  background: #000;
}
.preview {
  width: 100%;
  height: 100%;
}
.preview-zoom {
  position: absolute;
  right: 12px;
  bottom: 12px;
  width: 34px;
  height: 34px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #00000080;
  color: #fff;
}
.preview-name {
  display: block;
  margin: 16px 0 10px;
  overflow: hidden;
  font-size: 13px;
  color: var(--ui-muted);
  text-overflow: ellipsis;
  white-space: nowrap;
}
.preview-checks,
.preview-done {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.preview-check,
.preview-done {
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: 13px;
  color: var(--ui-text);
}
.preview-check {
  padding: 6px 10px;
  border-radius: var(--ui-radius-pill);
  background: var(--ui-surface);
}
.preview-check t-icon,
.preview-done t-icon {
  color: var(--ui-brand);
}
.preview-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 12px 20px calc(16px + env(safe-area-inset-bottom));
  background: linear-gradient(transparent, var(--ui-bg) 30%);
}
.preview-again {
  display: flex;
  align-items: center;
  gap: 6px;
  min-height: 44px;
  padding: 0 4px;
  font-size: 15px;
  color: var(--ui-text);
}
button.preview-use {
  flex: 1;
  width: auto;
  height: 48px;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--ui-radius-pill);
  font-size: 16px;
  font-weight: 600;
  color: var(--ui-on-brand);
  background: var(--ui-primary);
}
button.preview-use::after {
  border: 0;
}
button.preview-use.is-busy {
  opacity: 0.7;
}
